	.file	"admseq1.asm"
	.title	"Adam Bomb animation sequences"
	.width	132
	.option	b,d,l,t
	.mnolist


	.include	"macros.h"
	.include	"mproc.equ"		;Mproc equates
	.include	"sys.equ"
	.include	"game.equ"
	.include	"plyr.equ"
	.include	"anim.equ"
	.include	"sound.h"

	.include	"adamimg.h"


******************************************************************************
* EXTERNAL REFERENCES

	;from ROPES.ASM
	.ref	rope_command

******************************************************************************
* SYMBOLS DEFINED IN THIS FILE

******************************************************************************
* EQUATES FOR THIS FILE

TSEC 	equ	53

*****************************************************************************
*
* STANDS

 SUBR	adm_zip_anim
	WL	TSEC*60,A2ST2D+FR1
	.word	0

uxwrSTNA2_SPD	equ	6

 SUBR	adm_stand2_anim
 SUBR	adm_stand8_anim
	.word	ANI_SETMODE,MODE_NORMAL
	WL	uxwrSTNA2_SPD,A2ST2D+FR1
	WL	uxwrSTNA2_SPD,A2ST2D+FR2
	WL	uxwrSTNA2_SPD,A2ST2D+FR3
	WL	uxwrSTNA2_SPD,A2ST2D+FR4
	WL	uxwrSTNA2_SPD,A2ST2D+FR5
