	.word	ANI_SETSPEED,100h
	WL	3,A1TR5Z+FR4
	.word	ANI_SETFACING		;ANI_XFLIP <- not primary anim
	WL	3,A1TR5Z+FR4
	.word	ANI_SETMODE,MODE_NORMAL
	.word	ANI_END

 SUBR	adm_2_to_8_turn2_anim
 SUBR	adm_8_to_2_turn2_anim
	.word	ANI_SETMODE,MODE_UNINT+MODE_NOAUTOFLIP	;uninterruptable
	.word	ANI_SETSPEED,100h
	WL	3,A1TR5Z+FR1
	.word	ANI_SETFACING		;ANI_XFLIP <- not primary anim
	WL	3,A1TR5Z+FR1
	.word	ANI_SETMODE,MODE_NORMAL
	.word	ANI_END

 SUBR	adm_4_to_8_turn2_anim
 SUBR	adm_6_to_2_turn2_anim
	.word	ANI_SETMODE,MODE_UNINT+MODE_NOAUTOFLIP	;uninterruptable
	.word	ANI_SETSPEED,100h
	.word	ANI_SETMODE,MODE_NORMAL
	.word	ANI_END

 SUBR	adm_2_to_6_turn2_anim
 SUBR	adm_8_to_4_turn2_anim
	.word	ANI_SETMODE,MODE_UNINT+MODE_NOAUTOFLIP	;uninterruptable
	.word	ANI_SETSPEED,100h
	.word	ANI_SETMODE,MODE_NORMAL
	.word	ANI_END

*****************************************************************************
*
* RUNNING IN dymw3

 SUBR	adm_run2_anim
	.word	ANI_SETMODE,MODE_NORMAL
	WL	ANI_GOTO,dymwlp0

dymwRUN_SPD	equ	2
 SUBR	adm_run_anim
	.word	ANI_SETMODE,MODE_UNINT			;uninterruptable
dymwlp0
dymwlp1
	WL	dymwRUN_SPD+1,A3RN3A+FR10
	WL	dymwRUN_SPD,A3RN3A+FR11
	WL	dymwRUN_SPD,A3RN3A+FR12
	WL	dymwRUN_SPD,A3RN3A+FR13
	WL	dymwRUN_SPD,A3RN3A+FR1
	WL	dymwRUN_SPD+1,A3RN3A+FR2
	WL	dymwRUN_SPD,A3RN3A+FR3
	.word	ANI_SOUND,run_snd
	.word	ANI_SETMODE,MODE_NORMAL		;clear UNINT bit
	WL	dymwRUN_SPD+1,A3RN3A+FR4
	WL	dymwRUN_SPD,A3RN3A+FR5
	WL	dymwRUN_SPD+1,A3RN3A+FR6
	WL	dymwRUN_SPD,A3RN3A+FR7
	WL	dymwRUN_SPD+1,A3RN3A+FR8
	.word	ANI_SOUND,run_snd
	WL	dymwRUN_SPD,A3RN3A+FR9

	WL	ANI_GOTO,dymwlp1


*
* OUT OF CONTROL RUN IN dymw3

 SUBR	adm_ocrun_anim
	.word	ANI_SETMODE,MODE_NOAUTOFLIP			;don't change facing
	WL	15,A3RN3A+FR1
dymwlp
	WL	dymwRUN_SPD+1,A3RN3A+FR10
	WL	dymwRUN_SPD,A3RN3A+FR11
	WL	dymwRUN_SPD,A3RN3A+FR12
	WL	dymwRUN_SPD,A3RN3A+FR13
	WL	dymwRUN_SPD,A3RN3A+FR1
	WL	dymwRUN_SPD+1,A3RN3A+FR2
	WL	dymwRUN_SPD,A3RN3A+FR3
	.word	ANI_SOUND,run_snd
	WL	dymwRUN_SPD+1,A3RN3A+FR4
	WL	dymwRUN_SPD,A3RN3A+FR5
	WL	dymwRUN_SPD+1,A3RN3A+FR6
	WL	dymwRUN_SPD,A3RN3A+FR7
	WL	dymwRUN_SPD+1,A3RN3A+FR8
	.word	ANI_SOUND,run_snd
	WL	dymwRUN_SPD,A3RN3A+FR9
	WL	ANI_GOTO,dymwlp

*****************************************************************************
*
* BOUNCE OFF ROPES

 SUBR	adm_bounce_anim

	.word	ANI_SETMODE,MODE_UNINT+MODE_NOAUTOFLIP| MODE_NOCONFINE	;uninterruptable
	.word	ANI_ZEROVELS
	WL	4,A3BO3A+FR1

	WL	3,A3BO3A+FR2
	.word	ANI_BOUNCEROPE,0
	WL	1,A3BO3A+FR2

	WL	3,A3BO3A+FR3
	.word	ANI_BOUNCEROPE,1
	WL	1,A3BO3A+FR3

	WL	3,A3BO3A+FR4
	.word	ANI_BOUNCEROPE,2
	WL	1,A3BO3A+FR4

	WL	5,A3BO3A+FR5
	.word	ANI_BOUNCEROPE,4
	WL	1,A3BO3A+FR5

	WL	3,A3BO3A+FR6
	.word	ANI_BOUNCEROPE,-1			;release
	WL	1,A3BO3A+FR6

	WL	4,A3BO3A+FR7
	.word	ANI_SOUND,run_snd

	.word	ANI_SETMODE,MODE_NORMAL
	.word	ANI_END


*****************************************************************************

 SUBR	adm_slave_image_table

	.long	uzbds2_grapple	;0	S2_GRAPPLE
	.long	uzbds4_grapple	;1	S4_GRAPPLE
	.long	uzbds3_grap_to_hh	;2	S3_GRAP_TO_HH
	.long	uzbds3_pile_driven	;3	S3_PILE_DRIVEN


uzbds2_grapple		;ABOMB uzbd2 grapple
	.long	A2GR3Z+FR5	;0 (most forward)
	.long	A2GR3Z+FR6	;1
	.long	A2GR3Z+FR7	;2
	.long	A2GR3Z+FR8	;3 (most back)

uzbds4_grapple		;ABOMB uzbd4 grapple
	.long	A4GR3B+FR7	;0 (most forward)
	.long	A4GR3B+FR6	;1
	.long	A4GR3B+FR5	;2
	.long	A4GR3B+FR4	;3 (most back)

uzbds3_grap_to_hh		;ABOMB uzbd3 from grapple to head being held

uzbds3_pile_driven		;ABOMB uzbd3 pile driven


******************************************************************************
	.end
