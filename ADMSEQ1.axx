	WL	uxwrSTNA2_SPD,A2ST2D+FR11
	WL	uxwrSTNA2_SPD,A2ST2D+FR12
	.word	ANI_REPEAT

uxwrSTNA4_SPD	equ	6
 SUBR	adm_stand4_anim
 SUBR	adm_stand6_anim
	.word	ANI_SETMODE,MODE_NORMAL
	WL	uxwrSTNA4_SPD,A4ST4J+FR1
	WL	uxwrSTNA4_SPD,A4ST4J+FR2
	WL	uxwrSTNA4_SPD,A4ST4J+FR3
