*****************************************************************************
*
* HEAD HIT2 (HANDS ON FACE)

yjckHEAD_HIT2_SPD	equ	4
 SUBR	ref_head_hit2_anim
	.word	ANI_SETMODE,MODE_UNINT+MODE_NOAUTOFLIP	;uninterruptable
	.word	ANI_ZEROVELS
	.word	ANI_SETSPEED,100h
	.word	ANI_FRICTION,3000h
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR1
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR2
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR3
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR4
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR5
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR6
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR7
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR8
	WL	yjckHEAD_HIT2_SPD,J4AH3A+FR9
	WL	ANI_CODE,yjcksetface
	.word	ANI_SETMODE,MODE_NORMAL
	.word	ANI_END

yjcksetface
;Need to set facing dir because of this odd getup sequence
	movk	10,A1
	move	*A13(OBJ_CONTROL),a0
	btst	B_FLIPH,A0
	jrz	yjckrgt
	movk	6,A1
yjckrgt	move	A1,*A13(FACING_DIR)
	rets


