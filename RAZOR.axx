;fplzVEL	equ	30000h		;38000h	;30000h
;fplzDVEL	equ	21f0eh		;27978h	;21f0eh
;fplzVEL	equ	38000h		;38000h	;30000h
;fplzDVEL	equ	30000h		;27978h	;21f0eh
fplzVEL	equ	3a000h		;38000h	;30000h
fplzDVEL	equ	31000h		;27978h	;21f0eh


 SUBR rzr_velocity_table

;		X,	Z

	.long	0,	-fplzVEL	;0 UP

	.long	fplzDVEL,	-fplzDVEL	;1 UP-RIGHT

	.long	fplzVEL,	0	;2 RIGHT

	.long	fplzDVEL,	fplzDVEL	;3 DOWN-RIGHT

	.long	0,	fplzVEL	;4 DOWN

	.long	-fplzDVEL,	fplzDVEL	;5 DOWN-LEFT

	.long	-fplzVEL,	0	;6 LEFT

	.long	-fplzDVEL,	-fplzDVEL	;7 UP-LEFT


