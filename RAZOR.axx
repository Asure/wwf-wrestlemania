	JJXM	OPPOVERHEAD,		nvtapunch_clothesline
	JJXM	WAITANIM,		nvtapunch_clothesline
	JJXM	GRAPPLE,		nvtapunch_clothesline
	JJXM	MASTER,			nvtapunch_clothesline
	JJXM	SLAVE,			nvtapunch_clothesline
	JJXM	HEADHOLD,		nvtapunch_clothesline
	JJXM	HEADHELD,		nvtapunch_clothesline
	JJXM	CHOKEHOLD,		nvtapunch_clothesline
	JJXM	PUPPET,			nvtapunch_clothesline
	JJXM	PUPPET2,		nvtapunch_clothesline
	JJXM	INAIR2,			nvtapunch_clothesline
	JJXM_END

