*****************************************************************************
* blocking

mode_block	;7

	move	*a13(BLOCK_TIME),a0
	inc	a0
	move	a0,*a13(BLOCK_TIME)
	cmpi	160,a0
	jrlt	lkajno

	calla	get_opp_plyrmode
	cmpi	MODE_BLOCK,a0
	jrnz	lkajno
	move	*a13(CLOSEST_XDIST),a0
	cmpi	61h,a0
	jrge	lkajno
	cmpi	45,a0
	jrlt	lkajno
	move	*a13(CLOSEST_ZDIST),a0
	cmpi	30,a0
	jrlt	lkajpunchblock

lkajno
	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	jrz	lkajno_interrupt

	;press.  if block isn't down, let mode_normal handle it
	move	a0,a2			;save a0 from ...val_down
	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0
	jrz	lkajset_mode_normal
	move	a2,a0			;restore a0 from ...val_down

	X32	a0
	addi	lkajaction_table,a0
	move	*a0,a0,L
	call	a0

lkajno_interrupt
	rets

lkajset_mode_normal
	SETMODE	NORMAL
