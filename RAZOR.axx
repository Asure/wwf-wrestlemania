*****************************************************************************
*
* bouncing off ropes while running

mode_bouncing	;5

	clr	a0
	move	a0,*a13(OBJ_XVEL),L
	move	a0,*a13(OBJ_ZVEL),L

	move	*a13(ANIMODE),a0
	btst	MODE_END_BIT,a0
	jrz	eanvnot_ended

	move	*a13(MOVE_DIR),a0
	xori	MOVE_LEFT+MOVE_RIGHT,a0	;flip LEFT/RIGHT
	move	a0,*a13(MOVE_DIR)

	move	*a13(NEW_FACING_DIR),a1
	andi	MOVE_UP+MOVE_DOWN,a1
	or	a0,a1			;LEFT or RIGHT
	move	a1,*a13(FACING_DIR)	;face same dir as run

	movi	rzr_run2_anim,a0
	calla	change_anim1a

	SETMODE	RUNNING

;	clr	a0
;	move	a0,*a13(GETUP_TIME)	;in control

eanvnot_ended
	rets

*****************************************************************************
*
* STANDING ON TOP OF TURNBUCKLE

mode_onturnbkl	;6

;	;check unint
;	move	*a13(ANIMODE),a14
;	btst	MODE_UNINT_BIT,a14
;	jrnz	ijmdno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	btst	PLAYER_DOWN_BIT,a0
	jrz	ijmdno_climbdown

	movi	rzr_climb_down_anim,a0
	calla	change_anim1a

	SETMODE	CLIMBTURNBKL

ijmdno_interrupt
	rets

ijmdno_climbdown
	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	jrz	ijmdz

	X32	a0
	addi	ijmdaction_table,a0
	move	*a0,a0,L
	call	a0

	move	*a13(PLYRNUM),a5
	movi	JUMP_ROPES,a2
	movi	1000,a0
	calla	ADD_IF_SILENT

	rets


;For standing on top of turnbuckles

ijmdaction_table
	.long	ijmdz,ijmdpunch,ijmdblock,ijmdblock			;0-3
	.long	ijmdsuper_punch,ijmdsuper_punch,ijmdblock,ijmdblock	;4-7
	.long	ijmdkick,ijmdpunchkick,ijmdblock,ijmdblock		;8-11
	.long	ijmdsuper_punch,ijmdpunchkick,ijmdblock,ijmdblock	;12-15
	.long	ijmdsuper_kick,ijmdsuper_kick,ijmdblock,ijmdblock	;16-19
	.long	ijmdgraboh,ijmdgraboh,ijmdblock,ijmdblock		;20-23
	.long	ijmdsuper_kick,ijmdpunchkick,ijmdblock,ijmdblock	;24-27
	.long	ijmdgraboh,ijmdgraboh,ijmdblock,ijmdblock		;28-31

