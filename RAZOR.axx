*****************************************************************************
*
* RUNNING (if GETUP_TIME > 0 then player is out of control)
*

nvtaXRUN_VAL	equ	RZR_XRUN
nvtaZDRIFT_VAL	equ	RZR_ZDRIFT

mode_running

	move	*a13(RUN_TIME),a0		;Used for flying kick
	addk	1,a0
	move	a0,*a13(RUN_TIME)

	move	*a13(USR_VAR1),a0
	jrnz	nvtano_vel

	calla	bounce_off_ropes

	movi	nvtaXRUN_VAL,a0
	move	*a13(MOVE_DIR),a14
	btst	PLAYER_RIGHT_BIT,a14
	jrnz	nvtapos
	neg	a0
nvtapos
	move	@hyper_speed_on,a14
	sll	a14,a0
	move	a0,*a13(OBJ_XVEL),L

nvtano_vel

	move	*a13(GETUP_TIME),a0		;delay b4 gaining control
	jrnz	nvtaout_of_control

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	nvtano_interrupt

	move	*a13(STICK_VAL_CUR),a0
	move	*a13(MOVE_DIR),a1
	or	a0,a1
	andi	MOVE_LEFT|MOVE_RIGHT,a1
	cmpi	MOVE_LEFT|MOVE_RIGHT,a1
	jrne	nvtacontinue_run

	;braking with stick.  abort run.

	SETMODE	NORMAL

nvtacontinue_run
nvtano_interrupt

	move	*a13(STICK_VAL_CUR),a0
	clr	a1

	movi	-nvtaZDRIFT_VAL,a1
	btst	PLAYER_UP_BIT,a0
	jrnz	nvtasetvel

	movi	nvtaZDRIFT_VAL,a1
	btst	PLAYER_DOWN_BIT,a0
	jrnz	nvtasetvel

	clr	a1
nvtasetvel
	move	a1,*a13(OBJ_ZVEL),L


;Delay reading buttons after just getting out of an out of control run
;so a mistaken move isn't fired off
	move	*a13(DELAY_BUTNS),a0
	jrnz	nvtaout_of_control


	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	nvtaaction_table,a0
	move	*a0,a0,L
	call	a0
nvtaout_of_control
	rets

nvtaaction_table
	.long	nvtaz,nvtapunch,nvtablock,nvtablock			;0-3
	.long	nvtasuper_punch,nvtasuper_punch,nvtablock,nvtablock	;4-7
	.long	nvtakick,nvtapunchkick,nvtablock,nvtablock		;8-11
	.long	nvtasuper_punch,nvtapunchkick,nvtablock,nvtablock	;12-15
	.long	nvtasuper_kick,nvtasuper_kick,nvtablock,nvtablock	;16-19
	.long	nvtagraboh,nvtagraboh,nvtablock,nvtablock		;20-23
	.long	nvtasuper_kick,nvtapunchkick,nvtablock,nvtablock	;24-27
	.long	nvtagraboh,nvtagraboh,nvtablock,nvtablock		;28-31

;	.long	nvtaz					;0
;	.long	nvtapunch					;1
;	.long	nvtablock					;2
;	.long	nvtaz					;3
;	.long	nvtasuper_punch				;4
;	.long	nvtasuper_punch,nvtaz,nvtaz			;5-7
;	.long	nvtakick					;8
;	.long	punchkick,nvtaz,nvtaz,nvtakick,nvtaz,nvtaz,nvtaz		;9-15
;	.long	nvtasuper_kick				;16
;	.long	nvtaz,nvtaz,nvtaz,nvtagraboh,nvtaz,nvtaz,nvtaz		;17-23
;	.long	nvtakick,nvtaz,nvtaz,nvtaz,nvtaz,nvtaz,nvtaz,nvtaz		;24-31



