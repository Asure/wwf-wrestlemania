;	.long	ijmdz,ijmdz,ijmdz,ijmdgraboh,ijmdz,ijmdz,ijmdz		;17-23
;	.long	ijmdkick,ijmdz,ijmdz,ijmdz,ijmdz,ijmdz,ijmdz,ijmdz		;24-31

