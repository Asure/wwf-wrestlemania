*****************************************************************************

 SUBR	razor_ani_init

	move	*a13(FACING_DIR),a0
	btst	PLAYER_RIGHT_BIT,a0
	jrnz	wlyip1
;Plyr 2
	movi	rzr_stand4_anim,a0
	calla	change_anim1a

	movi	rzr_torso4_anim,a0
	calla	change_anim2a

	PUSH	a10
	move	a13,a10
	CREATE	TAUNT_PID,do_taunt
	PULL	a10

	rets

wlyip1
	movi	rzr_stand2_anim,a0
	calla	change_anim1a

	movi	rzr_torso2_anim,a0
	calla	change_anim2a

	rets


*****************************************************************************
*
* RAZORS CONTROL CODE
*
* a13 = * razor process

 SUBR	move_razor


	movi	razor_secret_moves,a11
	calla	check_secret_moves

	move	*a13(PLYRMODE),a0
	sll	5,a0			;x 32
	addi	fbndmode_table,a0
	move	*a0,a0,L
	call	a0
	rets

fbndmode_table
	.long	mode_normal		;0
	.long	mode_running		;1
	.long	mode_inair		;2
	.long	mode_attached		;3
	.long	mode_onground		;4
	.long	mode_bouncing		;5
	.long	mode_onturnbkl		;6
	.long	mode_block		;7
	.long	mode_dizzy		;8
	REFLONG	mode_dead		;9
	.long	mode_oppoverhead	;10
	.long	mode_climbturnbkl	;11
	.long	mode_waitanim		;12
	.long	mode_grapple		;13
	.long	mode_master		;14
	.long	mode_slave		;15
	.long	mode_headhold		;16
	.long	mode_puppet2		;17
	.long	mode_normal	;18
	.long	mode_headheld		;19
	REFLONG	mode_puppet		;20
	.long	mode_inair2		;21
	.long	mode_normal	;22
	.long	mode_normal	;23
	.long	mode_chokehold		;24
	REFLONG	mode_choking		;25

*****************************************************************************

mode_normal	;0

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	pbryno_interrupt

	move	*a13(I_WILL_DIE),a0
	jrz	pbrynope
	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	pbrynope
;Player has died amidst a combo...
;Knock me down.
	movi	rzr_fall_back_anim,a0
	calla	change_anim1a

;Zero health bar
	movi	-10,a0
	move	*a13(PLYRNUM),a1
	calla	adjust_health

	SETMODE	DEAD

	clr	a0
	move	a0,*a13(I_WILL_DIE)

	rets

pbrynope
;Perhaps we need to interrupt any sequence when a wrestler has won?

	calla	get_opp_plyrmode
	cmpi	MODE_DEAD,a0
	jrne	pbryopp_not_dead

	;if closest is a zombie, skip pin section.
	calla	get_opp_process
	move	*a0(STATUS_FLAGS),a14
	btst	B_ZOMBIE,a14
	jrnz	pbryopp_not_dead
	
	;all opponents are dead.  Check for pins/raisearms

	;if we're attached to someone, don't interrupt it.
	move	*a13(ATTACH_PROC),a1,L
	jrz	pbryno_attch
	move	*a1(ATTACH_PROC),a2,L
	cmp	a2,a13
	jreq	pbryno_pin_yet
pbryno_attch

	;if a teammate has pinned, raise yer arm.
	calla	ck_teammate_pin	
	jrc	pbryraisearm

	;nobody has pinned.  if we're outside or all our opponents are
	; outside, do a raisearm.
	calla	raisearm_check
	jrc	pbryraisearm

	;we're inside with a pinnable opponent.  any button pins.
	move	*a13(BUT_VAL_CUR),a0
	jrz	pbryno_pin_yet

	;we have a press -- make sure opponent is on the ground
	calla	can_pin
	jrnc	pbryopp_notgnd

	;opponent is on the ground.  pin him.
	FACE24	rzr,pin_anim
	calla	change_anim1a

	;set the 'I did a pin' flag.
	move	*a13(STATUS_FLAGS),a14
	ori	M_DID_PIN,a14
	move	a14,*a13(STATUS_FLAGS)

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

pbryraisearm
	FACE24	rzr,raise_arm_anim
	calla	change_anim1a
	calla	set_raisearm_bit

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

pbrytoo_far_to_pin
pbryopp_notgnd
pbryopp_not_dead
pbryno_pin_yet

	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	pbryimmobilized

	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0	;maybe have to action tables?
	jrz	pbrynblk			;1 for down transitions
	callr	pbryblock			;& 1 for current buttons
	jrc	pbrynblk
	clr	a0
	move	a0,*a13(ATTACK_TYPE)
	rets
pbrynblk
	move	*a13(BUT_VAL_CUR),a0
	andi	011111b,a0
	cmpi	PLAYER_PUNCH_VAL|PLAYER_KICK_VAL,a0
	jrz	pbrypunchkick

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	pbryaction_table,a0
	move	*a0,a0,L
	call	a0

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	pbryno_interrupt


	move	*a13(STICK_VAL_CUR),a0
	move	a0,*a13(MOVE_DIR)
	calla	climb_turnbuckle
	jrnc	pbryno_climb
	move	*a13(WRESTLERNUM),A5
	MOVI	CLIMB_ROPES,A2
	MOVI	1000,A0
	CALLA	ADD_IF_SILENT
	rets

pbryimmobilized
	clr	a14
	move	a14,*a13(MOVE_DIR)
pbryno_climb
	calla	execute_walk

pbryno_interrupt
	rets

pbryaction_table
	.long	pbryz,pbrypunch,pbryblock,pbryblock			;0-3
	.long	pbrysuper_punch,pbrysuper_punch,pbryblock,pbryblock	;4-7
	.long	pbrykick,pbrypunchkick,pbryblock,pbryblock		;8-11
	.long	pbrysuper_punch,pbrypunchkick,pbryblock,pbryblock	;12-15
	.long	pbrysuper_kick,pbrysuper_kick,pbryblock,pbryblock	;16-19
	.long	pbrygraboh,pbrygraboh,pbryblock,pbryblock		;20-23
	.long	pbrysuper_kick,pbrypunchkick,pbryblock,pbryblock	;24-27
	.long	pbrygraboh,pbrygraboh,pbryblock,pbryblock		;28-31


************
pbryz
	rets


************
pbrypunch		;1
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  44  45	headbutt
* normal	>		normal punch
*
* onground	< 120  120	elbow drop
* onground	>		normal punch
*
* running |
* bouncing			hip toss
*
* onturnbkl |
* climbturnbkl			normal punch
*

	JJXM_INIT
	JJXM	NORMAL,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	DIZZY,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	BLOCK,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	ONGROUND,	160,140,pbrypunch_lbdrop,pbrypunch_punch
	JJXM	RUNNING, 	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	BOUNCING,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	ONTURNBKL,		pbrypunch_punch
	JJXM	CLIMBTURNBKL,		pbrypunch_punch
	JJXM	INAIR,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	ATTACHED,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	DEAD,		160,140,pbrypunch_lbdrop,pbrypunch_punch
	JJXM	OPPOVERHEAD,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	WAITANIM,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	GRAPPLE,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	MASTER,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	SLAVE,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	HEADHOLD,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	HEADHELD,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	CHOKEHOLD,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	PUPPET,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	PUPPET2,	 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM	INAIR2,		 44, 45,pbrypunch_hdbutt,pbrypunch_punch
	JJXM_END

*****
pbrypunch_punch
std_punch

	FACE24	rzr,punch_anim
	calla	change_anim1a

	WRSND	W_RAZOR,PUNCH_T1,PUNCH_T2

	rets

*****
pbrypunch_hdbutt

	FACE24	rzr,butt_anim
	calla	change_anim1a

	WRSND	W_RAZOR,HDBUTT_T1,HDBUTT_T2
	rets

*****
pbrypunch_lbdrop

	FACE24	rzr,ground_punch_anim
	calla	change_anim1a

	WRSND	W_RAZOR,LBOWDROP_T1,LBOWDROP_T2
	rets


************
pbryblock		;2

std_block
	move	@blocking_off,a0
	jrnz	pbryno_blocking

	RND_AWARD	a13,BLOCKS_AWD

	FACE24	rzr,block_anim
	calla	change_anim1a

	calla	BLOCK_WOOSH

	clr	a0
	move	a0,*a13(BLOCK_TIME)
	clrc
	rets

pbryno_blocking
	setc
	rets


************
pbrysuper_punch	;4
pbrygraboh
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  85   45	headbutt or uppercut
*		>		blade slash	
*
* onground	< 120  120	elbow drop (or rug shake or hair pickup)
* onground	>		normal punch
*
* running |
* bouncing			hip toss
*
* onturnbkl |
* climbturnbkl			normal punch
*

	JJXM_INIT
	JJXM	NORMAL,		 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	DIZZY,		 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	BLOCK,		 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	ONGROUND,	160,140,pbryspunch_lbowdrop,std_punch
	JJXM	DEAD,		160,140,pbryspunch_lbowdrop,std_punch
	JJXM	RUNNING,	 	pbryspunch_downslash
	JJXM	BOUNCING,	 	pbryspunch_downslash
	JJXM	ONTURNBKL,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	CLIMBTURNBKL,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	INAIR,		 	pbryspunch_downslash
	JJXM	ATTACHED,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	OPPOVERHEAD,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	WAITANIM,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	GRAPPLE,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	MASTER,		 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	SLAVE,		 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	HEADHOLD,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	HEADHELD,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	CHOKEHOLD,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	PUPPET,		 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	PUPPET2,	 85, 45,pbryspunch_close,pbryspunch_far
	JJXM	INAIR2,		 	pbryspunch_downslash
	JJXM_END


pbryspunch_lbowdrop

;If near opponents head, and facing down, do the hair grab!
;If near feet, go for the rugshake

	move	*a13(CLOSEST_NUM),a3
	X32	a3

	addi	process_ptrs,a3
	move	*a3,a3,L
	move	*a3(PLYRMODE),a2
	cmpi	MODE_DEAD,a2
	jrz	pbryno
	move	*a13(OBJ_XPOS),a1,L 
	move	*a3(OBJ_XPOS),a2,L
	sub	a2,a1
	abs	a1
	srl	16,a1
	cmpi	30h,a1	;28
 	jrlt	pbryno

;At head or feet!

	move	*a3(OBJ_CONTROL),a14
	andi	M_FLIPH,a14
	move	*a13(OBJ_CONTROL),a0
	andi	M_FLIPH,a0
	cmp	a0,a14
	jrz	pbryfeet

;At head!  Do hair pickup.

	FACE24	rzr,hair_pickup_anim
	calla	change_anim1
	WRSND	W_RAZOR,LBOWDROP_T1,LBOWDROP_T2
	rets

pbryfeet
	cmpi	40h,a1	;28
 	jrlt	pbryno

	;smart-target the intended victim
	move	*a13(STATUS_FLAGS),a14
	ori	M_SMART_ATTACK,a14
	move	a14,*a13(STATUS_FLAGS)
	move	a3,*a13(SMART_TARGET),L

	movi	rzr_rugshake_anim,a0
	calla	change_anim1a
	rets

pbryno
	FACE24	rzr,ground_punch_anim
	calla	change_anim1a

	WRSND	W_RAZOR,LBOWDROP_T1,LBOWDROP_T2
	rets

