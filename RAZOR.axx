*******************************************************************************

bjzkcharge_flying_kick
	move	*a13(BUT_VAL_UP),a0
	btst	PLAYER_SKICK_BIT,a0
	jrz	bjzkno_kick

	move	*a13(PLYRNUM),a0
	.ref	get_powerk_dtime
	calla	get_powerk_dtime
	cmpi	85,a0			;> min?
	jrlt	bjzkno_kick

	callr	bjzkscrt_kick
	setc
	rets

bjzkno_kick
	clrc
	rets

bjzkscrt_kick

	move	*a13(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	bjzkout
	cmpi	MODE_HEADHOLD,a0
	jrz	bjzkout
	move	*a13(GETUP_TIME),a0
	jrnz	bjzkout
	cmpi	MODE_ONGROUND,a0
	jrz	bjzkout
	cmpi	MODE_DEAD,a0
	jrz	bjzkout

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bjzkout

	.ref	ck_ignore
	calla	ck_ignore
	jrc	bjzkout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	bjzkout
	cmpi	MODE_DEAD,a0
	jrz	bjzkout

	SETMODE	INAIR

	movk	1,a0			;Ensure leap at
	move	a0,*a8(OBJ_XVEL),L

	movi	rzr_flying_kick_anim,a0
	calla	change_anim1a

	WRSND	W_RAZOR,FLYKICK_T1,FLYKICK_T2

	rets


******************************************************************************
bjzkneck_grab
	.word	B_SPUNCH,		J_REAL_LR | J_TOWARD | J_AWAY | J_UP
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 30		;max
	.long	bjzkscrt_neck

bjzkscrt_neck
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bjzkout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	bjzkout
	cmpi	MODE_DEAD,a0
	jrz	bjzkout
	cmpi	MODE_HEADHELD,a0
	jrz	bjzkout

	move	*a13(LAST_HEADHOLD),a14,L
	move	@PCNT,a0,L
	sub	a14,a0
	cmpi	2*60,a0
	jrge	bjzkok2

;This head grab is too close (in terms of time) to most recent grab
	.ref	rzr_3_fake_hold_anim
	movi	rzr_3_fake_hold_anim,a0
	calla	change_anim1a
	rets

bjzkok2
	move	*a13(CLOSEST_XDIST),a1
	cmpi	85,a1
	jrgt	bjzkstd_grab

	movi	rzr_3_head_hold2_anim,a0
	calla	change_anim1a
	rets

bjzkstd_grab
	movi	rzr_3_head_hold_anim,a0
	calla	change_anim1a
	rets

******************************************************************************
bjzkdown_slash
	.word	B_PUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_DOWN|J_TOWARD,	J_REAL_LR
	.word	J_DOWN,			J_REAL_LR
	.word	8000h | 50		;max
	.long	bjzkdslash

bjzkdslash
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bjzkout

	;check opp mode
	calla	get_opp_plyrmode
	cmpi	MODE_DEAD,a0
	jreq	bjzkout

	;don't do it unless you're in mode_normal, running, or headhold
	move	*a13(PLYRMODE),a0
	cmpi	MODE_NORMAL,a0
	jreq	bjzkslash
	cmpi	MODE_RUNNING,a0
	jreq	bjzkrunslash
	cmpi	MODE_HEADHOLD,a0
	jreq	bjzkslash
	jruc	bjzkz

bjzkrunslash
	;don't interrupt an OCRUN
	move	*a13(GETUP_TIME),a14
	jrnz	bjzkz
bjzkslash
	WRSND	W_RAZOR,KICK_T2
	movi	rzr_3_dslash_anim,a0
	calla	change_anim1a
bjzkz	rets

*******************************************************************************

bjzkgrab_fling2
	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	bjzkscrt_grabfling2

bjzkhip_toss2
	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	bjzkscrt_grabfling2

bjzkscrt_grabfling2
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bjzkout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	bjzkyes
	cmpi	MODE_RUNNING,a0
	jrz	bjzkyes
	rets

******************************************************************************
bjzkgrab_fling
;	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	bjzkscrt_grabfling

	.word	B_SPUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	bjzkscrt_grabfling

bjzkscrt_grabfling

;Make this miss, rotate to missed opponent,
;and stay rotated to flung opponent, also make
;this work from both angles!

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bjzkout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	bjzkyes
	cmpi	MODE_RUNNING,a0
	jrnz	bjzknope
bjzkyes
	FACE24	rzr,hiptoss_anim
	calla	change_anim1a

	WRSND	W_RAZOR,GRABFLING_T1,PUNCH_T2
	rets

bjzknope
;Don't fling when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_HEADHELD,a0
	jrz	bjzkout
	cmpi	MODE_ONGROUND,a0
	jrz	bjzkout
	cmpi	MODE_DEAD,a0
	jrz	bjzkout

;	move	*a13(LAST_FLING_ATTEMPT),a14,L
;	move	@PCNT,a0,L
;	sub	a14,a0
;	cmpi	3*60,a0
;	jrge	bjzkok2a
;
;;This head grab is too close (in terms of time) to most recent grab
;	movi	rzr_3_uslash_anim,a0
;	calla	change_anim1a
;
;	WRSND	W_RAZOR,SPUNCH_T1,SPUNCH_T2
;	rets
;
;bjzkok2a
;	move	@PCNT,a14,L			;use 32-bit PCNT!
;	move	a14,*a13(LAST_FLING_ATTEMPT),L

	FACE24	rzr,grabfling_anim
	calla	change_anim1a

	WRSND	W_RAZOR,GRABFLING_T1,PUNCH_T2
bjzkout	rets

******************************************************************************

bjzkhip_toss
;	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	bjzkscrt_hiptoss

	.word	B_PUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	bjzkscrt_hiptoss


bjzkscrt_hiptoss
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bjzkout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	bjzkout
;	cmpi	MODE_BLOCK,a0
;	jrz	bjzkout
	cmpi	MODE_DEAD,a0
	jrz	bjzkout
	cmpi	MODE_HEADHELD,a0
	jrz	bjzkout
	cmpi	MODE_INAIR,a0
	jrz	bjzkdoit
	cmpi	MODE_INAIR2,a0
	jrz	bjzkdoit

	move	*a13(CLOSEST_DIST),a0
	cmpi	70h,a0
	jrgt	bjzkout

bjzkdoit
	FACE24	rzr,hiptoss_anim
	calla	change_anim1a

	WRSND	W_RAZOR,GRABFLING_T1,PUNCH_T2
	rets

	.if NUM_RAZOR_FINISHES
******************************************************************************
 SUBRP	rzr_finish_move1

fzekTIMEOUT	.equ	TSEC

fzekend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		fzekend_wait			; br = no

fzekreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,fzekreset
	movi		fzekTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_DOWN,0,fzekreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,fzekreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,fzekreset
	WAITSWITCH_DWN	B_PUNCH,J_ALL,fzekreset

	movi		rzr_finish1_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif
	

	.if NUM_RAZOR_FINISHES > 1
******************************************************************************
 SUBRP	rzr_finish_move2

ekedTIMEOUT	.equ	TSEC

ekedend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		ekedend_wait			; br = no

ekedreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,ekedreset
	movi		ekedTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_UP,0,ekedreset
	WAITSWITCH_DWN	J_RIGHT,J_UP,ekedreset
	WAITSWITCH_DWN	J_RIGHT,J_UP,ekedreset
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,ekedreset

	movi		rzr_finish2_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif


*****************************************************************************

;	STRUCTPD
;	WORD		fmdqCHARGE_TIME	;UDW
fmdqCHARGE_TIME	.equ	SM_USRW1

rzr_charge_slashes

fmdqstart_over
	clr	a14
	move	a14,*a13(fmdqCHARGE_TIME),W
fmdqloop1
	SLEEPK	1

	move	*a13(fmdqCHARGE_TIME),a14,W
	inc	a14
	move	a14,*a13(fmdqCHARGE_TIME),W

	move	*a8(BUT_VAL_CUR),a0
	btst	PLAYER_PUNCH_BIT,a0
	jrz	fmdqp1

	jruc	fmdqloop1

fmdqp1

;no longer holding button
	move	*a13(fmdqCHARGE_TIME),a14
	cmpi	100,a14
	jrlt	fmdqstart_over

;Success!  Check for the UNINT bit, then queue it up.
	move	*a8(ANIMODE),a14
	btst	MODE_UNINT_BIT,a14
	jrnz	fmdqstart_over

	move	*a8(GETUP_TIME),a0
	jrnz	fmdqstart_over

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	fmdqstart_over
	cmpi	MODE_HEADHOLD,a0
	jrz	fmdqstart_over
	cmpi	MODE_ONGROUND,a0
	jrz	fmdqstart_over
	cmpi	MODE_DEAD,a0
	jrz	fmdqstart_over

	movi	rzr_repeat_slash_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_RAZOR,KICK_T2

	jruc	fmdqstart_over

*******************************************************************************

rzr_sliding_rug

ohymTIMEOUT	.equ	60

ohymlp0
	SLEEPK	1
ohymlp
	clr	a11

;	WAITSWITCH_DWN	J_AWAY,0,ohymlp
	WAITSWITCH_DWN	J_TOWARD,0,ohymlp

	movi	ohymTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,ohymlp
	WAITSWITCH_DWN	B_KICK,J_ALL,ohymlp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	ohymlp0
	cmpi	MODE_HEADHOLD,a0
	jrz	ohymlp0
	cmpi	MODE_ONGROUND,a0
	jrz	ohymlp0
	cmpi	MODE_DEAD,a0
	jrz	ohymlp0

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	ohymlp0

	move	*a8(GETUP_TIME),a0
	jrnz	ohymlp0


;Don't do it when he is on ground
	SWAP	a8,a13
	calla	get_opp_plyrmode
	SWAP	a8,a13
;	cmpi	MODE_ONGROUND,a0
;	jrz	ohymlp
	cmpi	MODE_DEAD,a0
	jrz	ohymlp

;Don't do it if opponent is behind you
	SWAP	a8,a13
	calla	ck_ignore
	jrnc	ohymnorm
	SWAP	a8,a13
	jruc 	ohymlp
ohymnorm	
	SWAP	a8,a13

	WRSND	W_RAZOR,GRABHOLD_T1,GRABHOLD_T2
	.ref	rzr_sliding_rug_anim
	movi	rzr_sliding_rug_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L

	SLEEPK	20

	jruc	ohymlp

*****************************************************************************
rzr_hdhold_edge

dnuzTIMEOUT	.equ	60

dnuzlp0
	SLEEPK	1
dnuzlp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	dnuzcont
	cmpi	MODE_HEADHELD,a0
	jrnz	dnuzlp0

dnuzcont
	clr	a11

;	WAITSWITCH_DWN	J_AWAY,0,dnuzlp
	WAITSWITCH_DWN	J_TOWARD,0,dnuzlp

	movi	dnuzTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,dnuzlp
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,dnuzlp
	
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	dnuzslam
	cmpi	MODE_HEADHELD,a0
	jrnz	dnuzlp0
	move	*a8(I_WILL_DIE),A14
	jrnz	dnuzlp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	dnuzlp0				;ignore

	calla	DO_REVERSAL
	calla	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	dnuzis_reversal

dnuzslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	dnuzlp0				;ignore

	movi	33,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

dnuzis_reversal
	movk	15,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS

	movi	rzr_razors_edge_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_RAZOR,GRABHOLD_T1,GRABHOLD_T2

	SLEEPK	20

	jruc	dnuzlp

*****************************************************************************
rzr_hdhold_pile

buzdTIMEOUT	.equ	60

buzdlp0
	SLEEPK	1
buzdlp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	buzdcont
	cmpi	MODE_HEADHELD,a0
	jrnz	buzdlp0

buzdcont
	clr	a11

;	WAITSWITCH_DWN	J_UP,0,buzdlp
	WAITSWITCH_DWN	J_DOWN,0,buzdlp

	movi	buzdTIMEOUT,a11

	WAITSWITCH_DWN	J_DOWN,0,buzdlp
	WAITSWITCH_DWN	B_SKICK,J_ALL,buzdlp
	
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	buzdslam
	cmpi	MODE_HEADHELD,a0
	jrnz	buzdlp0
	move	*a8(I_WILL_DIE),A14
	jrnz	buzdlp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	buzdlp0				;ignore

	calla	DO_REVERSAL
	calla	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	buzdis_reversal

buzdslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	buzdlp0				;ignore

	movk	7,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

buzdis_reversal
	movk	15,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS
	movi	rzr_3_pile_driver_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_RAZOR,GRABHOLD_T1,GRABHOLD_T2

	SLEEPK	20

	jruc	buzdlp

