*
rzr_grab_toss_air

oslnTIMEOUT	.equ	40

oslnlp0
	SLEEPK	1
oslnlp
	clr	a11

	WAITSWITCH_DWN	J_AWAY,0,oslnlp

	movi	oslnTIMEOUT,a11

	WAITSWITCH_DWN	J_AWAY,0,oslnlp
	WAITSWITCH_DWN	B_PUNCH,J_ALL,oslnlp

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	oslnlp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jreq	oslnlp0

;Don't do it when he is on ground
	SWAP	a8,a13
	calla	get_opp_plyrmode
	SWAP	a8,a13
;Don't do it when he is on ground
	cmpi	MODE_ONGROUND,a0
	jrz	oslnlp
	cmpi	MODE_DEAD,a0
	jrz	oslnlp
	cmpi	MODE_INAIR,a0
	jrz	oslndoit2
	cmpi	MODE_INAIR2,a0
	jrz	oslndoit2

	CALLA	FIND_AND_KILL_ENDLESS
	move	*a8(CLOSEST_NUM),a0
	X32	a0
	addi	process_ptrs,a0
	move	*a0,a0,L
	move	*a0(ATTACK_TYPE),a0
	cmpi	AT_LEAPING,a0
	jrz	oslndoit2

	move	*a8(CLOSEST_DIST),a0
	cmpi	68h,a0
	jrgt	oslnlp

	FACE24	rzr,hiptoss_anim
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_RAZOR,GRABFLING_T1,PUNCH_T2

	SLEEPK	20
	jruc	oslnlp

oslndoit2
	FACE24	rzr,hiptoss2_anim
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_RAZOR,GRABFLING_T1,PUNCH_T2

	SLEEPK	20

	jruc	oslnlp


