mode_headhold	;16

;Bozo power move
	.ref	bozo_check
	calla	bozo_check
	jrnc	ugkbfail

	WRSND	W_RAZOR,GRABHOLD_T1,GRABHOLD_T2

	movi	rzr_razors_edge_anim,a0
	move	@PCNT,a14
	btst	0,a14
	jrz	ugkbtag
	movi	rzr_3_pile_driver_anim,a0
ugkbtag	calla	change_anim1a

	rets

ugkbfail
	move	*a13(WHOIHIT),a0,L
	move	*a0(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrnz	ugkbexit

;	move	*a13(ATTACH_PROC),a10,L
;	jrz	ugkbexit

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	ugkbno_interrupt

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	ugkbaction_table,a0
	move	*a0,a0,L
	call	a0

ugkbno_interrupt
	rets

ugkbexit
	move	*a13(OBJ_ZPOS),a14,L
	subi	[6,0],a14
	move	a14,*a13(OBJ_ZPOS),L

	movk	MOVE_DOWN_RIGHT,a1
	move	*a13(OBJ_CONTROL),a0
	btst	B_FLIPH,a0
	jrz	ugkbright
	movk	MOVE_DOWN_LEFT,a1
ugkbright	move	a1,*a13(FACING_DIR)
	move	a1,*a13(NEW_FACING_DIR)

	SETMODE	NORMAL

	rets

ugkbaction_table
	.long	ugkbz,ugkbpunch,ugkbblock,ugkbblock			;0-3
	.long	ugkbsuper_punch,ugkbsuper_punch,ugkbblock,ugkbblock	;4-7
	.long	ugkbkick,ugkbpunchkick,ugkbblock,ugkbblock		;8-11
	.long	ugkbsuper_punch,ugkbpunchkick,ugkbblock,ugkbblock	;12-15
	.long	ugkbsuper_kick,ugkbsuper_kick,ugkbblock,ugkbblock	;16-19
	.long	ugkbgraboh,ugkbgraboh,ugkbblock,ugkbblock		;20-23
	.long	ugkbsuper_kick,ugkbpunchkick,ugkbblock,ugkbblock	;24-27
	.long	ugkbgraboh,ugkbgraboh,ugkbblock,ugkbblock		;28-31

