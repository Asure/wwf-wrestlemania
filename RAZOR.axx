	JJXM	RUNNING,		nvtapunch_clothesline
	JJXM	BOUNCING,		nvtapunch_clothesline
	JJXM	ONTURNBKL,		nvtapunch_clothesline
	JJXM	CLIMBTURNBKL,		nvtapunch_clothesline
