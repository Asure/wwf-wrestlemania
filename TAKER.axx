	move	*a13(OBJ_CONTROL),a0
	btst	B_FLIPH,a0
	jrz	jhbwright
	movk	MOVE_DOWN_LEFT,a1
jhbwright	move	a1,*a13(FACING_DIR)
	move	a1,*a13(NEW_FACING_DIR)

	SETMODE	NORMAL

	rets

