*****************************************************************************
*
* RUNNING (if GETUP_TIME > 0 then player is out of control)
*

otlrXRUN_VAL	equ	UND_XRUN
otlrZDRIFT_VAL	equ	UND_ZDRIFT

mode_running

	move	*a13(RUN_TIME),a0		;Used for flying kick
	addk	1,a0
	move	a0,*a13(RUN_TIME)

	move	*a13(USR_VAR1),a0
	jrnz	otlrno_vel

	calla	bounce_off_ropes

	movi	otlrXRUN_VAL,a0
	move	*a13(MOVE_DIR),a14
	btst	PLAYER_RIGHT_BIT,a14
	jrnz	otlrpos
	neg	a0
otlrpos
	move	@hyper_speed_on,a14
	sll	a14,a0
	move	a0,*a13(OBJ_XVEL),L

otlrno_vel

	move	*a13(GETUP_TIME),a0		;delay b4 gaining control
	jrnz	otlrout_of_control

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	otlrno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	move	*a13(MOVE_DIR),a1
	or	a0,a1
	andi	MOVE_LEFT|MOVE_RIGHT,a1
	cmpi	MOVE_LEFT|MOVE_RIGHT,a1
	jrne	otlrcontinue_run

	;braking with stick.  abort run.

	SETMODE	NORMAL

otlrcontinue_run
otlrno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	clr	a1

	movi	-otlrZDRIFT_VAL,a1
	btst	PLAYER_UP_BIT,a0
	jrnz	otlrsetvel

	movi	otlrZDRIFT_VAL,a1
	btst	PLAYER_DOWN_BIT,a0
	jrnz	otlrsetvel

	clr	a1
otlrsetvel
	move	a1,*a13(OBJ_ZVEL),L

;Delay reading buttons after just getting out of an out of control run
;so a mistaken move isn't fired off
	move	*a13(DELAY_BUTNS),a0
	jrnz	otlrout_of_control


	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	otlraction_table,a0
	move	*a0,a0,L
	call	a0
otlrout_of_control
	rets

otlraction_table
	.long	otlrz,otlrpunch,otlrblock,otlrblock			;0-3
	.long	otlrsuper_punch,otlrsuper_punch,otlrblock,otlrblock	;4-7
	.long	otlrkick,otlrpunchkick,otlrblock,otlrblock		;8-11
	.long	otlrsuper_punch,otlrpunchkick,otlrblock,otlrblock	;12-15
	.long	otlrsuper_kick,otlrsuper_kick,otlrblock,otlrblock	;16-19
	.long	otlrgraboh,otlrgraboh,otlrblock,otlrblock		;20-23
	.long	otlrsuper_kick,otlrpunchkick,otlrblock,otlrblock	;24-27
	.long	otlrgraboh,otlrgraboh,otlrblock,otlrblock		;28-31


