*****************************************************************************
* blocking

mode_block	;7

	move	*a13(BLOCK_TIME),a0
	inc	a0
	move	a0,*a13(BLOCK_TIME)
	cmpi	160,a0
	jrlt	hkueno

	calla	get_opp_plyrmode
	cmpi	MODE_BLOCK,a0
	jrnz	hkueno
	move	*a13(CLOSEST_XDIST),a0
	cmpi	61h,a0
	jrge	hkueno
	cmpi	45,a0
	jrlt	hkueno
	move	*a13(CLOSEST_ZDIST),a0
	cmpi	30,a0
	jrlt	hkuepunchblock

hkueno
	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	jrz	hkueno_interrupt

	;press.  if block isn't down, let mode_normal handle it
	move	a0,a2			;save a0 from ...val_down
	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0
	jrz	hkueset_mode_normal
	move	a2,a0			;restore a0 from ...val_down

	X32	a0
	addi	hkueaction_table,a0
	move	*a0,a0,L
	call	a0

hkueno_interrupt
	rets

hkueset_mode_normal
	SETMODE	NORMAL
	jruc	mode_normal

hkueaction_table
	.long	hkuez,hkuepunchblock,hkuez	;0-2
	.long	hkuepunchblock		;3
	.long	hkuez,hkuez,hkuez,hkuez,hkuez,hkuez,hkuez	;4-10
	.long	hkuez,hkuez,hkuez,hkuez,hkuez,hkuez,hkuez	;11-17
	.long	hkuez,hkuez,hkuez,hkuez,hkuez,hkuez,hkuez	;18-24
	.long	hkuez,hkuez,hkuez,hkuez,hkuez,hkuez,hkuez	;25-31

