*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal			flying kick
* dizzy					"
*
* onground	< 176 176	butt-drop
* onground	>		nothing
*
* running			flying kick
* bouncing			flying kick
*
* onturnbkl			flying kick
* climbturnbkl			flying kick
*
	JJXM_INIT
	JJXM	NORMAL,			otlrkick_flyingkick
	JJXM	BLOCK,			otlrkick_flyingkick
	JJXM	DIZZY,			otlrkick_flyingkick
	JJXM	ONGROUND,		attack_bellyflop
	JJXM	RUNNING,		otlrkick_flyingkick
	JJXM	BOUNCING,		otlrkick_flyingkick
	JJXM	ONTURNBKL,		otlrkick_flyingkick
	JJXM	CLIMBTURNBKL,		otlrkick_flyingkick
	JJXM	INAIR,			otlrkick_flyingkick
	JJXM	ATTACHED,		otlrkick_flyingkick
	JJXM	DEAD,			attack_bellyflop
	JJXM	OPPOVERHEAD,		otlrkick_flyingkick
	JJXM	WAITANIM,		otlrkick_flyingkick
	JJXM	GRAPPLE,		otlrkick_flyingkick
	JJXM	MASTER,			otlrkick_flyingkick
	JJXM	SLAVE,			otlrkick_flyingkick
	JJXM	HEADHOLD,		otlrkick_flyingkick
	JJXM	HEADHELD,		otlrkick_flyingkick
	JJXM	CHOKEHOLD,		otlrkick_flyingkick
	JJXM	PUPPET,			otlrkick_flyingkick
	JJXM	PUPPET2,		otlrkick_flyingkick
	JJXM	INAIR2,			otlrkick_flyingkick
	JJXM_END

