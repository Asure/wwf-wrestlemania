*******************************
* Check if running would be OK
* A9+32 if bad

 SUBRP	drone_chkrun

	move	*a13(OBJ_XPOSINT),a0
	move	*a13(OBJ_ZPOSINT),a1

	move	*a13(FACING_DIR),a2

	move	*a13(INRING),a14
	jrnz	ahupout			;Out of ring?

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ

	cmpi	MODE_ONGROUND,b7
	jreq	ahupx
;	subk	MODE_INAIR2,a14
;	jreq	ahupx			;Jumping on me?

	move	*a13(CLOSEST_ZDIST),a1
	cmpi	70,a1
	jrge	ahupx			;Z far enough?

	subk	30,a1
	jrle	ahupx			;Z close enough?

	move	*a13(CLOSEST_XDIST),a0
	cmpi	150,a0
	jrge	ahupx			;X far enough?

;	btst	PLAYER_RIGHT_BIT,a2
;	jrz	ahupl			;Facing left?

	jruc	ahupbad

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ

ahupout
	btst	PLAYER_RIGHT_BIT,a2
	jrz	ahupol			;Facing left?

	cmpi	RING_X_CENTER+500,a0
	jrge	ahupbad			;Hit rgt crowd?

	cmpi	RING_TOP-10,a1
	jrlt	ahuprrok
	cmpi	RING_BOT+10,a1
	jrgt	ahuprrok
	cmpi	RING_X_CENTER,a0
	jrge	ahuprrok
	cmpi	RING_X_CENTER-300,a0
	jrge	ahupbad			;Hit rgt ring?
ahuprrok
	jruc	ahupx
ahupol
	cmpi	RING_X_CENTER-500,a0
	jrle	ahupbad			;Hit lft crowd?

	cmpi	RING_TOP-10,a1
	jrlt	ahuplrok
	cmpi	RING_BOT+10,a1
	jrgt	ahuplrok
	cmpi	RING_X_CENTER,a0
	jrle	ahuplrok
	cmpi	RING_X_CENTER+300,a0
	jrle	ahupbad			;Hit lft ring?
ahuplrok
;FIX!
	jruc	ahupx

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ

ahupbad
	addk	32,a9			;Skip script run buttons

ahupx
	rets


*******************************
* Control runner

mrngrsk
	movk	10,a2
	callr	drone_seek2
	andni	MOVE_LEFT+MOVE_RIGHT,a0		;0 lft & rgt
	move	a0,*a13(DRN_JOY)
	DS_CODEEND
	DS_SLP1

 SUBRP	drn_run

	DS_CODE
	move	b6,a0
	subk	MODE_RUNNING,a0
	jreq	mrngmdok
	subk	MODE_BOUNCING-MODE_RUNNING,a0
	jrne	mrngabrt
mrngmdok
	movi	01ffh,a0		;9.6 sec
	callr	rnd
	jrz	mrngbrkrun			;Breakout?

	move	*a13(OBJ_XVEL+16),a4
	sll	3,a4			;*8
	move	*a8(OBJ_XVEL+16),a1
	sll	5,a1			;*32

	move	*a8(OBJ_XPOSINT),a0
	add	a1,a0
	move	*a13(OBJ_XPOSINT),a1
	add	a4,a1
	move	a1,a3
	sub	a1,a0
	move	a4,a1
	xor	a0,a1
	abs	a0

	move	*a13(CLOSEST_ZDIST),a2

	move	*a13(INRING),a14
	jrz	mrnginr			;In ring?

	cmpi	300,a0
	jrgt	mrngering			;Too far?

	move	a1,a1
	jrn	mrngbrkrun			;Running away?

	subk	30,a2
	jrgt	mrngbrkseek		;Too far?

	jruc	mrngcont

mrnginr
	move	a4,a4
	jrn	mrnglrp			;Towards L rope?

	cmpi	RING_X_CENTER+210,a3
	jrlt	mrngrpok			;Won't hit R rope?
	jruc	mrngchkopp
mrnglrp
	cmpi	RING_X_CENTER-210,a3
	jrgt	mrngrpok			;Won't hit L rope?
mrngchkopp
	move	*a8(GETUP_TIME),a14
	jrgt	mrngrpok			;Out of control?

	cmpi	MODE_ONGROUND,b7
	jreq	mrngrpok

	cmpi	300,a0
	jrgt	mrngrpok			;Opp X far?

	cmpi	MODE_RUNNING,b7
	jreq	mrngoprun

	cmpi	180,a0
	jrgt	mrngrpok			;Opp X far?
mrngoprun
	cmpi	90,a2
	jrlt	mrngbrkrun			;Opp Z close?

mrngrpok

	move	a1,a1
	jrn	mrngrsk			;Running away?
mrngcont
	cmpi	MODE_INAIR2,b7
	jreq	mrngbrkrun


	subk	30,a2
	jrgt	mrngrsk			;Z too far?

	cmpi	250,a0
	jrgt	mrngrsk			;X too far?

	move	a0,a2

	movi	120,a0
	callr	rndrng0
	addi	130,a0

	cmp	a0,a2
	jrgt	mrngrsk			;X too far?


;	movk	3,a0
;	callr	rnd
;	jrz	mrngigpup			;25% ignore?

	move	b7,a0
	subk	MODE_PUPPET2,a0
	jreq	mrngbrkrun
	subk	MODE_PUPPET-MODE_PUPPET2,a0
	jreq	mrngbrkrun
	cmpi	MODE_HEADHELD,b7
	jreq	mrngbrkrun
	cmpi	MODE_HEADHOLD,b7
	jreq	mrngbrkrun
	cmpi	MODE_ATTACHED,b7
	jreq	mrngbrkrun
;mrngigpup

	move	*a13(DRN_BUTCHRG),a0
	jrz	mrngnchrg
	move	*a13(DRN_BUTCHRGDLY),a0
	jrgt	mrngnchrg
	clr	a0
	move	a0,*a13(DRN_BUTCHRG)	;Fire it
	jruc	mrngabrt
mrngnchrg
	DS_CODEEND
	DS_RJMP	33,mrngk
	DS_RJMP	33,mrngsk
	.word	SP_M,0
mrngk	.word	K_M,0
mrngsk	.word	SK_M,0

mrngabrt
	DS_CODEEND
	DS_END

mrngbrkrun
	DS_CODEEND
	.word	L_M,0

mrngering
	DS_CODEEND
	.word	L_M,2
	DS_JMP	drn_enterring

mrngbrkseek
	DS_CODEEND
	.word	L_M,2
	DS_JMP	drn_seek



*******************************
* Opponent running

 SUBRP	drn_oprun

	DS_CODE

	movk	7,a0
	callr	rnd
	jrnz	ugakabrt			;Skip?

	move	*a8(OBJ_XPOSINT),a0
	move	*a13(OBJ_XPOSINT),a1
;	move	a1,a3
	sub	a1,a0
	move	*a8(OBJ_XVEL+16),a1
;	move	a1,a4
	xor	a0,a1
	abs	a0

	move	*a13(CLOSEST_ZDIST),a2
	cmp	a0,a2
	jrgt	ugakabrt			;Z dist > X dist?

	move	a1,a1
	jrn	ugakrun			;Running away?

	move	*a8(GETUP_TIME),a14
	jrgt	ugakrun			;Out of control?

ugakabrt
	DS_CODEEND
	DS_END

ugakrun
	DS_CODEEND
	.word	P_M+K_M,0	;Run



*******************************

 SUBRP	drn_roll

	DS_CODE
	callr	drone_chrg

	jruc	kagqstrt

kagqlp
	DS_CODEEND
	DS_SLP1
	DS_CODE
kagqstrt
	cmpi	MODE_ONGROUND,b6
	jrne	kagqx

	move	*a13(CLOSEST_XDIST),a0
	cmpi	150,a0
	jrgt	kagqx			;Safe dist?

	move	*a13(CLOSEST_ZDIST),a0
	cmpi	70,a0
	jrgt	kagqx			;Safe dist?

	clr	a2
	callr	drone_seek2
	jrz	kagqx

	movk	3,a1			;Flip up & down
	xor	a1,a0
	move	a0,*a13(DRN_JOY)

	movi	7fh,a0
	callr	rnd
	jrnz	kagqlp

kagqx
	DS_CODEEND
	.word	B_M,TSEC-10		;Block while standing
	DS_END


*******************************
* Climb closest turnbuckle

 SUBRP	drn_climbtb

	DS_CODE
	move	b3,a0
	subk	1,a0
	jrle	gafolp			;Only 1 on team?

	movk	1,a0
	callr	rnd
	jrnz	gafox			;Skip 50%?

gafolp
	DS_CODEEND
	DS_SLP1

 SUBRP	drn_ontb

	DS_CODE

	move	b7,a2

	cmpi	MODE_ONTURNBKL,b6
	jrne	gafonot

	subk	MODE_ONTURNBKL,a2
	jreq	gafodn			;He's up, so get dn?

	jruc	gafojmp

gafonot
	move	*a13(INRING),a0
	jrnz	gafoering			;!In ring?

	move	*a13(WRESTLERNUM),a0
	subk	3,a0
	jrne	gafony			;!Yoko?
	move	*a8(INRING),a0
	jrnz	gafox			;!In ring?
gafony
	subk	MODE_ONTURNBKL,a2
	jreq	gafox
	subk	MODE_INAIR2-MODE_ONTURNBKL,a2
	jreq	gafox

	movi	RING_X_CENTER-225,a0
	move	*a13(OBJ_XPOSINT),a1
	cmpi	RING_X_CENTER,a1
	jrle	gafolrp
	movi	RING_X_CENTER+225,a0
gafolrp
	move	a0,a3
	movi	RING_TOP,a1
	movk	32,a2
	callr	drone_seekxz		;Seek to visinity
	jrnz	gafonclose

	move	a3,a0
	movi	RING_TOP-10,a1
	clr	a2
	callr	drone_seekxz		;Push into turnbuckle

gafonclose
	move	*a13(CLOSEST_XDIST),a0
	cmpi	120,a0
	jrgt	gafolp			;Safe dist?

	move	*a13(CLOSEST_ZDIST),a0
	cmpi	70,a0
	jrgt	gafolp			;Safe dist?

gafox
	DS_CODEEND
	DS_END

gafojmp
	clr	a6			;So we get dn transition
	DS_CODEEND
	.word	K_M,0
gafodn
	DS_CODEEND
	.word	D_M,0
gafoering
	DS_CODEEND
	DS_JMP	drn_enterring


*******************************
* I'm in air

wgqllp
	DS_CODEEND
	DS_SLP1

 SUBRP	drn_inair

	DS_CODE
	clr	a2
	callr	drone_seek2

	cmpi	MODE_INAIR2,b6
	jreq	wgqllp

	DS_CODEEND
	DS_END


*******************************
* Opponent in air

 SUBRP	drn_opinair

	DS_CODE

	movk	1,a0
	callr	rnd
	jrnz	deqrrun			;Skip?
deqrlp
	cmpi	MODE_INAIR2,b7
	jrne	deqrk

	DS_CODEEND
	DS_SLP1
	DS_CODE

	move	*a13(CLOSEST_XDIST),a1
	move	*a13(CLOSEST_ZDIST),a14
	cmp	a1,a14
	jrge	deqrbig
	move	a1,a14
deqrbig
	cmpi	150,a14
	jrgt	deqrlp			;Opp far?
deqrk
	DS_CODEEND
	.word	K_M,0			;Jump up

deqrrun
	DS_CODEEND
	.word	L_M+P_M+K_M,2	;Run away
	DS_END



*******************************
* Enter ring at closest entry point

ioyvlp
	DS_CODEEND
	DS_SLP1

 SUBRP	drn_enterring

	DS_CODE

	move	*a8(INRING),a0
	jrnz	ioyvx			;Opp out?

	move	*a13(INRING),a0
	jrz	ioyvx			;In ring?

	move	*a13(OBJ_XPOSINT),a14

	movi	RING_Z_CENTER,a1
	movi	RING_X_CENTER-260,a0
	cmp	a0,a14
	jrle	ioyvsk
	movi	RING_X_CENTER+260,a0
	cmp	a0,a14
	jrge	ioyvsk

	move	*a13(OBJ_ZPOSINT),a14

	movi	RING_X_CENTER,a0
	movi	RING_TOP-10,a1
	cmp	a1,a14
	jrle	ioyvsk
	movi	RING_BOT+10,a1
ioyvsk
	movk	10,a2
	callr	drone_seekxz		;Seek to visinity
	jrnz	ioyvlp

	DS_CODEEND
	.word	P_M+SP_M+K_M+SK_M+B_M,0	;Enter

ioyvx
	DS_CODEEND
	DS_END


*******************************

 SUBRP	drn_taunt

	DS_CODE

	move	*a8(OBJ_ZPOSINT),a0
	move	*a13(OBJ_ZPOSINT),a1
	sub	a1,a0
	cmpi	100,a0
	jrlt	zxaex

	move	*a8(OBJ_XPOSINT),a0
	move	*a13(OBJ_XPOSINT),a1
	sub	a1,a0
	abs	a0
	cmpi	300,a0
	jrgt	zxaex

;Time to execute high-risk move!
	movi	8000h+6*60,a0
	move	a0,*a13(RISK)

	move	*a13(WRESTLERNUM),a0
	X32	a0
	addi	zxaetaunt_t,a0
	move	*a0,a0,L
	calla	change_anim1a
zxaex
	DS_CODEEND
	DS_END


zxaetaunt_t
	.long	hrt_4_taunt_anim		;0 Bret Hart
	.long	rzr_4_taunt_anim		;1 Razor Ramon
	.long	und_4_taunt_anim		;2 Undertaker
	.long	yok_4_taunt_anim		;3 Yokozuna
	.long	shn_4_taunt_anim		;4 Shawn Michaels
	.long	bam_4_taunt_anim		;5 Bam Bam
	.long	dnk_4_taunt_anim		;6 Doink
	.long	0		  		;7 spare
	.long	lex_4_taunt_anim		;8 Lex Luger


*******************************

 SUBRP	drn_oppdead

	DS_CODE
znfilp
	clr	a0			;Close
	move	a0,*a13(DRN_SEEKDIR)
	move	a0,*a13(DRN_SEEKDIST)

	callr	drone_seekdirdist
	DS_CODEEND
	DS_SLP1
	DS_CODE

	movk	32,a1
	move	*a13(WRESTLERNUM),a0
	subk	2,a0
	jreq	znfiut			;Undertaker?
	movi	90,a1
znfiut
	move	*a13(CLOSEST_DIST),a0
	cmp	a1,a0
	jrle	znfix
;	jruc	znfinotut

	move	*a8(ANIMODE),a0		;Let ut walk through dead opps
	ori	MODE_OVERLAP,a0
	move	a0,*a8(ANIMODE)
znfinotut

	move	*a13(DRN_JOY),a0
	jrnz	znfilp
znfix
	DS_CODEEND
	.word	P_M,0



*******************************
* Push stick to move drone towards his opp dir/dist seek position
* A7 = Old joy bits
* A8 = *Closest opp proc
* Trashes scratch, A2-A5

 SUBRP	drone_seekdirdist

	move	*a13(DRN_SEEKDIR),a4	;0-f
	move	*a13(DRN_SEEKDIST),a3	;0-4
	move	a3,a0
	X16	a3
	X4	a0
	add	a0,a3			;*20

	move	a4,a2
	callr	bjzqdrn_getxz
	jrnz	bjzqok

	movk	7,b0
	move	a4,a5
bjzqlp
	addk	1,a4
	sll	32-4,a4
	srl	32-4,a4
	move	a4,a2
	callr	bjzqdrn_getxz
	jrnz	bjzqnewok

	subk	1,a5
	sll	32-4,a5
	srl	32-4,a5
	move	a5,a2
	callr	bjzqdrn_getxz
	jrnz	bjzqnew5ok

	dsj	b0,bjzqlp

	clr	a0
	move	a0,*a13(DRN_JOY)

	rets

bjzqnew5ok
	move	a5,a4
bjzqnewok
	move	a4,*a13(DRN_SEEKDIR)
bjzqok
	movk	30,a2
	callr	drone_seekxz
	jrnz	bjzqx

	move	*a13(DRN_MODE),a0
	addk	1,a0
	jrge	bjzqx			;Was -1? Skip dir change

	move	a7,*a13(DRN_JOY)	;Restore to lessen glitch

	movk	3,a0			;>Get rnd +-2/3
	callr	rnd
	subk	1,a0
	jrnz	bjzqrnz
	subk	2,a0			;0 into -2
bjzqrnz
	addk	1,a0
	jrgt	bjzqrpos
	subk	2,a0
bjzqrpos

	add	a0,a4
	sll	32-4,a4
	srl	32-4,a4
	move	a4,*a13(DRN_SEEKDIR)

bjzqx
	rets


bjzqdrn_getxz
	add	a3,a2
	X16	a2
	addi	bjzqsine_t,a2

	move	*a2(4*16),a14
	move	*a8(OBJ_XPOSINT),a0
	add	a14,a0

	cmpi	RING_X_CENTER-220,a0
	jrlt	bjzqxzbad
	cmpi	RING_X_CENTER+220,a0
	jrgt	bjzqxzbad

	move	*a2,a14
	move	*a8(OBJ_ZPOSINT),a1
	add	a14,a1

	cmpi	RING_TOP,a1
	jrlt	bjzqxzbad
	cmpi	RING_BOT,a1
	jrle	bjzqxzok
bjzqxzbad
	clr	a2			;Set Z
bjzqxzok
	move	a2,a2
	rets

bjzqsine_t
	.word	-50,-46,-35,-19
	.word	0,19,35,46,50,46,35,19
	.word	0,-19,-35,-46,-50,-46,-35,-19

	.word	-100,-92,-71,-38
	.word	0,38,71,92,100,92,71,38
	.word	0,-38,-71,-92,-100,-92,-71,-38

	.word	-150,-139,-106,-57
	.word	0,57,106,139,150,139,106,57
	.word	0,-57,-106,-139,-150,-139,-106,-57

	.word	-200,-185,-141,-76
	.word	0,76,141,185,200,185,141,76
	.word	0,-76,-141,-185,-200,-185,-141,-76

	.word	-250,-231,-177,-95
	.word	0,95,177,231,250,231,177,95
	.word	0,-95,-177,-231,-250,-231,-177,-95

	.word	-300,-277,-212,-115
	.word	0,114,212,277,300,277,212,114
	.word	0,-114,-212,-277,-300,-277,-212,-115


*******************************
* Push stick to move drone towards closest opp

 SUBRP	drone_seek

	movi	70,a2

 SUBRP	drone_seek2

	move	*a8(OBJ_XPOSINT),a0
	move	*a8(OBJ_ZPOSINT),a1


*******************************
* Push stick to move drone towards an XZ location
* A0 = X to seek
* A1 = Z
* A2 = Range to stop
* A13= *Plyr proc
*0A0H = Joy bits set or 0 (Pass CC)
* Trashes scratch

 SUBRP	drone_seekxz

	move	a3,b0

	move	*a13(OBJ_XPOSINT),a3
	sub	a0,a3

	clr	a0

	move	a3,a14
	abs	a3
	sub	a2,a3
	jrle	jugfonx
	move	a14,a14
	jrlt	jugfnolft
	subk	4,a0			;Left

jugfnolft	addk	8,a0			;Rgt
jugfonx
	move	*a13(OBJ_ZPOSINT),a3

	sub	a1,a3
	move	a3,a14
	abs	a3
	sub	a2,a3
	jrle	jugfonz
	move	a14,a14
	jrlt	jugfnoup
	subk	1,a0			;Up

jugfnoup	addk	2,a0			;Dn
jugfonz
	move	a0,*a13(DRN_JOY)

	move	b0,a3
	move	a0,a0
	rets


*******************************
* Adjust drone skill level (called each round)
* 8 is typical starting difficulty
* A13 = *Plyr proc
* Trashes scratch, A2-A5

 SUBR	drone_calcskill

	move	*a13(PLYR_TYPE),a0
	jrz	kxccx			;Human?

	move	*a13(DRN_SKILLRNDM),a0

	move	@current_round,a3	;1-3
	subk	1,a3
	jrgt	kxccn1st

	movk	4,a0
	callr	rndrng0
	subk	2,a0
	move	a0,*a13(DRN_SKILLRNDM)
kxccn1st
	move	@CURRENT_LADDER,a5,L	;* to position
	subi	LADDER,a5
	sra	5,a5			;/32 (Gives 0-6)
	move	a5,a1
	sra	1,a1			;0-3
	add	a1,a5			;A5=0-9
	add	a0,a5			;-2 to 2 randomness

	clr	a4
	move	@PSTATUS,a0
	btst	0,a0
	jrnz	kxccp1
	movk	16,a4
kxccp1
	movi	p1winstreakd,a0
	add	a4,a0
	move	*a0,a0
	jrlt	kxccloser			;Lost? (-2 per match lost)



	X2	a0
;	add	a0,a5			;+1 per match won
;	add	a0,a5			;+1 per match won



	add	a0,a5			;+1 per match won
kxccloser
	X2	a0
	add	a0,a5			;+2 per match won

;	X2	a0
;	add	a0,a5			;+2 per match won
;kxccloser
;	X2	a0
;	add	a0,a5			;+4 per match won

	movi	p1rounds,a0
	add	a4,a0
	move	*a0,a0
	add	a0,a5			;+3 per round won
	X2	a0
	add	a0,a5

	X2	a3
	sub	a3,a5			;-2 per round past 1st


	movk	ADJDIFF,a0		;Get difficulty level (1-10)
	calla	GET_ADJ
	subk	2,a0
	X2	a0
	add	a0,a5			;+8 default
	jrge	kxccminok
	clr	a5
kxccminok
	cmpi	29,a5
	jrle	kxccmaxok
	movk	29,a5
kxccmaxok
	move	a5,*a13(DRN_SKILL)

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0CHlr attack count

	clr	a0
	movi	atkcnt_t,a1
	movi	AT_NUM*NUM_WRES,b0
kxccaclp
	move	a0,*a1+
	dsj	b0,kxccaclp

kxccx
	rets



********************************
* Get random # with mask
* A0 = Mask
*0A0H = Rnd # (Pass CC)
* Trashes scratch

 SUBRP	rnd

	move	@RAND,a1,L
	rl	a1,a1
	move	@HCOUNT,a14
	rl	a14,a1
	add	sp,a1
	move	a1,@RAND,L

	and	a1,a0
	rets


********************************
* Quickly produce a random # in range 0-X
* A0 = X
*0A0H = Random # (0 to A0) (No CC)
* Trashes scratch

 SUBRP	rndrng0

	move	@RAND,a1,L
	rl	a1,a1
	move	@HCOUNT,a14
	rl	a14,a1
	add	sp,a1
	move	a1,@RAND,L

	addk	1,a0
	mpyu	a1,a0		;Condition codes not valid!

	rets






********************************

	.end
