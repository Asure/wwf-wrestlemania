ogfqlp
	DS_CODEEND
	DS_SLP1

 SUBRP	drn_seek

	DS_CODE

	move	b6,a0
	jrz	ogfqskok
	subk	MODE_BLOCK,a0
	jrne	ogfqx
ogfqskok
	movi	3fh,a0
	callr	rnd
	jrz	ogfqx
	callr	drone_seek
	jrnz	ogfqlp
ogfqx
	DS_CODEEND
	DS_END


*******************************
* Get real close

nvkglp
	DS_CODEEND
	DS_SLP1

 SUBRP	drn_seekclose

	DS_CODE

	move	b6,a0
	jrz	nvkgskok
	subk	MODE_BLOCK,a0
	jrne	nvkgx
nvkgskok
	movi	3fh,a0
	callr	rnd
	jrz	nvkgx

	move	*a13(OBJ_XPOSINT),a14
	movk	32,a2
	move	*a8(OBJ_XPOSINT),a0
	cmp	a0,a14
	jrge	nvkgtorgt
	neg	a2
nvkgtorgt
	add	a2,a0

	move	*a8(OBJ_ZPOSINT),a1
	movk	23,a2
	callr	drone_seekxz
	jrnz	nvkglp
nvkgx
	DS_CODEEND
	DS_END


