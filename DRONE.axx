	.file	"drone.asm"
	.title	"wrestling drone code"
	.width	132
	.option	b,d,l,t
	.mnolist


	.include	"macros.h"
	.include	"mproc.equ"
	.include	"display.equ"
	.include	"gsp.equ"
	.include	"sys.equ"
	.include	"audit.equ"
	.include	"game.equ"
	.include	"anim.equ"
	.include	"plyr.equ"
	.include	"ring.equ"
	.include	"damage.equ"


;sounds external


;symbols externally defined

	.ref	process_ptrs,PSTATUS
	.ref	PCNT,round_tickcount

	.ref	CHECK_COMBO_GO

	.ref	GET_ADJ
	.ref	p1winstreakd,p1rounds,current_round
	.ref	LADDER,CURRENT_LADDER

	.ref	change_anim1a
	.ref	hrt_4_taunt_anim,rzr_4_taunt_anim,und_4_taunt_anim
	.ref	yok_4_taunt_anim,shn_4_taunt_anim,bam_4_taunt_anim
	.ref	dnk_4_taunt_anim,lex_4_taunt_anim


;symbols defined in this file


;uninitialized ram definitions

	BSSX	droneoff	,16		;!0=Drone code off
	.bss	atkcnt_t,AT_NUM*NUM_WRES*16	;# times hit by each atk


;equates for this file

BLKTEST	.equ	0

U_M	.equ	MOVE_UP<<5
D_M	.equ	MOVE_DOWN<<5
L_M	.equ	MOVE_LEFT<<5
R_M	.equ	MOVE_RIGHT<<5

P_M	.equ	PLAYER_PUNCH_VAL
B_M	.equ	PLAYER_BLOCK_VAL
SP_M	.equ	PLAYER_SPUNCH_VAL
K_M	.equ	PLAYER_KICK_VAL
SK_M	.equ	PLAYER_SKICK_VAL

	.if	MODE_NORMAL!=0
	.emsg	"FIX code!"
	.endif


	.text

***************************************************************
* Main drone logic
* A13 = *Plyr process
* Trashes scratch, A2-A10, B2-B7

 SUBR	drone_main

	.if	DEBUG
	move	@droneoff,a0
	jrnz	ayupxx
	.endif


	move	*a13(DRN_BUT),a6	;A6=Old buts
	move	*a13(DRN_JOY),a7	;A7=Old joy

	move	*a13(CLOSEST_NUM),a14
	X32	a14
	addi	process_ptrs,a14
	move	*a14,a8,L		;A8=*Closest's proc

;	callr	drone_getcurskillo
;	move	a0,a10
	move	*a13(DRN_SKILL),a10
	X16	a10			;A10=Skill for indexing (*16)

	move	*a13(PLYRMODE),a0
	move	a0,b6			;B6=My pmode
	move	*a8(PLYRMODE),a0
	move	a0,b7			;B7=Opp pmode

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0FHind friendly wrestlers

	movi	process_ptrs,a2
	movk	NUM_WRES,b0
	clr	b2			;B2=Team dist ranking (0-2)
	clr	b3			;B3=# alive on my team (0-3)
ayupfflp
	move	*a2+,a3,L
	jrz	ayupffnxt

	move	*a13(PLYR_SIDE),a0
	move	*a3(PLYR_SIDE),a1
	cmp	a0,a1
	jrne	ayupffnxt			;Not on my team?

	move	*a3(PLYRMODE),a0
	subk	MODE_DEAD,a0
	jreq	ayupffnxt

	addk	1,b3

	move	*a13(CLOSEST_NUM),a0
	move	*a3(CLOSEST_NUM),a1
	cmp	a0,a1
	jrne	ayupffnxt			;Diff opponents?

	move	*a13(CLOSEST_DIST),a0
	move	*a3(CLOSEST_DIST),a1
	cmp	a1,a0
	jrle	ayupffnxt			;I'm closer?

	addk	1,b2
ayupffnxt
	dsj	b0,ayupfflp

ayupffdn
	move	b2,b2
	jrz	ayupffdoit			;I'm closest?

	move	*a13(DRN_ACT_p),a9,L
	jrnz	ayupffx			;Script running?

	move	*a13(DRN_MODE),a0
	movi	-3,a1
	move	a1,*a13(DRN_MODE)	;Set mode
	addk	3,a0
	jrne	ayupnewmdm3		;Init hang back?
	jruc	ayupffx

ayupffdoit
	move	*a13(DRN_MODE),a0
	addk	3,a0
	jreq	ayupnewmd			;Set new mode if in hang back?

ayupffx
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Random mode changes

	move	@PCNT,a0
	sll	32-5,a0
	jrnz	ayupnomdchk

	movk	3,a0
	callr	rnd
	jrnz	ayupnomdchk

	move	*a13(DRN_MODE),a0
	addk	3,a0
	jrle	ayupmcnosc			;Hang back?
ayupnewmd
	movk	1,a0			;No aggressive
	move	@CURRENT_LADDER,a1,L	;* to position
	cmpi	LADDER,a1
	jreq	ayupmdeasy			;1st ladder?

	movk	3,a0			;Range
	cmpi	13*16,a10
	jrle	ayupmdeasy
	addk	1,a0			;More aggressive
ayupmdeasy
	callr	rndrng0
	subk	2,a0
	move	a0,*a13(DRN_MODE)	;-2 to 2

	move	*a13(DRN_ACT_p),a9,L
	jrnz	ayupmcnosc			;Script running?
	clr	a0
	move	a0,*a13(DRN_JOY)	;So we don't walk into ropes
ayupmcnosc
ayupnewmdm3
	movk	4,a2			;Rgt side
	move	*a13(OBJ_XPOSINT),a0
	move	*a8(OBJ_XPOSINT),a1
	sub	a1,a0
	jrge	ayupmetorgt
	movk	12,a2			;Left side
ayupmetorgt
	move	a2,*a13(DRN_SEEKDIR)

	movk	4,a0
	callr	rndrng0

	move	*a13(DRN_MODE),a1
	addk	3,a1
	jrne	ayupnodhb			;!Hang back?
	ANDK	1,a0			;Make 3-4 or 4-5
	addk	2,a0
	move	b2,a14
	add	a14,a0
ayupnodhb
	move	a0,*a13(DRN_SEEKDIST)

ayupnomdchk
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Passive mode movement

	.if	BLKTEST
	jruc	ayupskmv
	.endif

	move	*a13(DRN_MODE),a0
	jrge	ayupskmv			;Aggressive?

	move	b6,b6
	jrnz	ayupskmv			;!MODE_NORMAL?

	move	*a13(DRN_ACT_p),a9,L
	jrnz	ayupskmv			;Script running?

	callr	drone_seekdirdist
ayupskmv

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0DecH charge delay

	move	*a13(DRN_BUTCHRG),a0
	jrz	ayupnochrgn

	move	*a13(DRN_BUTCHRGDLY),a0
	subk	1,a0
	move	a0,*a13(DRN_BUTCHRGDLY)
ayupnochrgn

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Handle getup time

	move	*a13(GETUP_TIME),a2
	jrle	ayupnogt

	movi	99,a0
	callr	rndrng0
	move	a10,a1
	addi	ayupgetup_t,a1
	move	*a1,a1
	cmp	a1,a0
	jrge	ayupdsabt

	subk	5,a2
	jrge	ayupgtok
	clr	a2
ayupgtok	move	a2,*a13(GETUP_TIME)
	jruc	ayupdsabt
ayupnogt
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ

	move	*a13(DRN_DELAY),a0
	subk	1,a0
	jrle	ayupnewact
	move	a0,*a13(DRN_DELAY)
	jruc	ayupx
ayupnewact
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0BHlock detection

	move	*a8(ATTACK_TIME),a4
	move	@round_tickcount,a5
	sub	a5,a4			;-=Attack passed, +=Ticks till atk
	jrlt	ayupnoblk

	movi	50,a1			;Closer Z allowed
	move	*a8(ATTACK_TYPE),a2
	cmpi	AT_PUSH,a2
	jreq	ayupnoblk
	cmpi	AT_MSL,a2
	jreq	ayupmsla			;Missile atk?

	move	*a13(CLOSEST_XDIST),a0
	cmpi	180,a0
	jrgt	ayupnoblk			;Too far?
	movi	100,a1
ayupmsla
	move	*a13(CLOSEST_ZDIST),a0
	cmp	a1,a0
	jrgt	ayupnoblk			;Too far?

	move	*a8(GETUP_TIME),a14
	jrgt	ayupnoblk			;Out of control?

	cmpi	MODE_INAIR2,b7
	jreq	ayupnoblk			;Jumping on me?

	btst	PLAYER_BLOCK_BIT,a6
	jrnz	ayupx			;Trying to blk?

	move	*a8(ATTACK_TYPE),a2
	move	*a13(PLYRNUM),a0
	movi	AT_NUM,a3
	mpys	a0,a3
	add	a2,a3
	X16	a3
	addi	atkcnt_t,a3

	move	*a3,a2			;# missed blks
	cmpi	10,a2
	jrlo	ayupacok
	movk	9,a2
ayupacok
	X16	a2
	addi	ayupblkatk_t,a2
	move	*a2,a2			;Get %

	move	b3,a14			;# on team
	subk	1,a14
	X32	a14
	sub	a14,a2			;Decrease per extra bud

	.if	BLKTEST
	movi	100,a2
	.endif

	movi	99,a0
	callr	rndrng0
	move	a10,a1
	addi	ayupblkbase_t,a1
	move	*a1,a1			;Base %
	add	a2,a1
	cmp	a1,a0
	jrge	ayupmissb

	cmpi	15,a4
	jrge	ayupminbtok		;Min time OK?
	movk	15,a4
ayupminbtok

	move	*a8(ATTACK_TYPE),a2
	cmpi	AT_LEAPING,a2
	jrne	ayupsblk			;!Leaping?

;	LOCKUP

	move	a10,a0
	srl	4+2,a0			;Skill/4
	callr	rndrng0
	move	a0,a0
	jrz	ayupsblk			;Skip?

	move	a5,*a8(ATTACK_TIME)	;Cancel

	movi	slhtoss,a9		;Flip opp
	jruc	ayupnewsc

ayupsblk
	move	a4,*a13(DRN_DELAY)

	movk	B_M,a0			;Block it
	move	a0,*a13(DRN_BUT)

	cmpi	AT_PUPPET,a2
	jrne	ayupdsabt			;!Hip toss?

	movi	B_M+L_M+D_M,a0		;Special block
	move	a4,a3			;Dly
	clr	a9
	jruc	ayupsetbx

ayupmissb
	move	a5,*a8(ATTACK_TIME)	;Cancel

	move	*a3,a0			;Cnt+1
	addk	1,a0
	move	a0,*a3

ayupnoblk
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>New script selection

	move	*a13(DRN_ACT_p),a9,L	;A9=*Script
	jrnz	ayupcact			;Continue script?


	clr	a2

	cmpi	MODE_BLOCK,b6
	jrne	ayupnps			;!Blking?
	btst	PLAYER_PUNCH_BIT,a6
	jrnz	ayupnps			;Already pushed?

	.if	BLKTEST
	jruc	ayupnps
	.endif

	movk	7,a0
	callr	rndrng0
	move	a0,a0
	jrnz	ayupnps			;Skip 88%?

	move	*a13(CLOSEST_XDIST),a0
	cmpi	110,a0
	jrgt	ayupnps			;Too far?
	move	*a13(CLOSEST_ZDIST),a0
	cmpi	40,a0
	jrgt	ayupnps			;Too far?
	movk	P_M+B_M,a2		;Push
	move	a2,*a13(DRN_BUT)
	jruc	ayupx
ayupnps
	move	a2,*a13(DRN_BUT)

	.if	BLKTEST
	jruc	ayupx
	.endif


	move	b6,b6
	jrnz	ayupdoact			;!MODE_NORMAL?


	move	*a13(INRING),a0
	jrz	ayupringok			;In ring?

	move	*a8(INRING),a0
	jrnz	ayupringok			;Opp out?

	movi	drn_enterring,a9
	jruc	ayupnewsc
ayupringok

	move	*a13(DRN_MODE),a3
	cmpi	-3,a3
	jrle	ayuppass			;Hang back?

	cmpi	MODE_ONGROUND,b7
	jreq	ayupdoact			;Atk?

	cmpi	MODE_INAIR2,b7
	jrne	ayuponia
	movi	drn_opinair,a9		;Avoid jump
	jruc	ayupnewsc
ayuponia
	cmpi	MODE_RUNNING,b7
	jrne	ayuponrun
	move	*a13(CLOSEST_XDIST),a0
	cmpi	80,a0
	jrle	ayuponrun			;Too close?
	movi	drn_oprun,a9		;Anti run
	jruc	ayupnewsc
ayuponrun

	move	*a8(ATTACK_TIME),a0
	move	@round_tickcount,a1
	sub	a1,a0			;-=Attack passed, +=Ticks till atk
	addk	15,a0
	jrge	ayupdoact			;Get him after his atk (or no blk)?


	move	a3,a3
	jrlt	ayuppass			;Passive?

	movk	1fh,a0			;.6 sec
	cmpi	22*16,a10
	jrle	ayupcat
	movk	7,a0			;.15 sec
ayupcat
	callr	rnd
	jrz	ayupdoactpup		;Atk?


ayuppass
	move	@PCNT,a0		;Chk every 16
	addk	1,a0
	sll	32-4,a0
	jrnz	ayupx

	move	*a13(CLOSEST_XDIST),a1
	move	*a13(CLOSEST_ZDIST),a14
	cmp	a1,a14
	jrge	ayupbig
	move	a1,a14
ayupbig
	cmpi	70,a14
	jrlt	ayupdoactpup		;Opp in my face? Attack!

	move	*a13(DRN_MODE),a0
	addk	3,a0
	jrle	ayupx			;Hang back?

	move	@CURRENT_LADDER,a1,L	;* to position
	cmpi	LADDER,a1
	jreq	ayupnratk			;1st ladder?

	movk	0fh,a0			;Avg 4.8 sec
	callr	rnd
	jrz	ayupdoactpup		;Random attack?
ayupnratk
	move	b7,b7
	jrz	ayupx			;Opp MODE_NORMAL? Be passive
ayupdoactpup
	move	b7,a0
	subk	MODE_PUPPET2,a0
	jreq	ayupx
	subk	MODE_PUPPET-MODE_PUPPET2,a0
	jreq	ayupx
	cmpi	MODE_HEADHELD,b7
	jreq	ayupx
	cmpi	MODE_HEADHOLD,b7
	jreq	ayupx
	cmpi	MODE_ATTACHED,b7
	jreq	ayupx


ayupdoact
	cmpi	MODE_HEADHELD,b6
	jreq	ayupslctscrpt

	cmpi	MODE_ONGROUND,b6
	jrne	ayupnognd
	movi	drn_roll,a9
	jruc	ayupnewsc
ayupnognd
	cmpi	MODE_INAIR2,b6
	jrne	ayupnin2
	movi	drn_inair,a9
	jruc	ayupnewsc
ayupnin2
	cmpi	MODE_ONTURNBKL,b6
	jrne	ayupnotb
	movi	drn_ontb,a9
	jruc	ayupnewsc
ayupnotb
	cmpi	MODE_DEAD,b6
	jrne	ayupndead
	movk	7,a0
	callr	rnd
	jruc	ayupbutx
ayupndead
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	ayupunint			;Wait?

	cmpi	MODE_RUNNING,b6
	jrne	ayupnrun
	movi	drn_run,a9
	jruc	ayupnewsc
ayupnrun

	cmpi	MODE_HEADHOLD,b6
	jrne	ayupnhh

	clr	a0
	move	a0,*a13(DRN_BUTCHRG)	;Clr it

;	movk	1,a0			;50%
;	callr	rnd
;	jrnz	ayupnhh			;Don't combo?

	move	a8,a3
	move	a13,a8
	calla	CHECK_COMBO_GO
	jrlt	ayupncmb			;Can't combo?
	move	a3,a8
	movi	drn_combo,a9
	jruc	ayupnewsc
ayupncmb
	move	a3,a8
ayupnhh

	move	*a13(DRN_BUTCHRG),a0
	jrz	ayupnochrg

	move	*a13(DRN_BUTCHRGDLY),a0
	jrgt	ayupnochrg

	cmpi	MODE_BLOCK,b7
	jreq	ayupnochrg			;Opp blking?

	move	*a13(DRN_BUTCHRG_p),a9,L ;Fire charge
	jruc	ayupnewsc
ayupnochrg

	move	*a13(CLOSEST_DIST),a14
	cmpi	200,a14
	jrgt	ayupopnb

	cmpi	MODE_BLOCK,b7
	jrne	ayupopnb			;!Blking?

	move	*a13(CLOSEST_ZDIST),a14
	cmpi	40,a14
	jrgt	ayupbsk

	move	*a13(CLOSEST_XDIST),a14
	cmpi	60,a14
	jrgt	ayupbsk

	move	*a8(STICK_REL_CUR),a14
	cmpi	MOVE_DOWN_LEFT,a14
	jreq	ayupbht			;Hip toss blocked?

	movi	M_shrtblkr,a9		;Attack
	jruc	ayupgetscrpt
ayupbht
	movi	M_shrtblkrdl,a9		;Attack
	jruc	ayupgetscrpt
;	movi	hgrab,a9
;	jruc	ayupnewsc
ayupbsk
	movi	drn_seekclose,a9
	jruc	ayupnewsc
ayupopnb

	cmpi	MODE_DEAD,b7
	jrne	ayupopnd

	movi	drn_oppdead,a9
	jruc	ayupnewsc
ayupopnd

ayupslctscrpt

	move	*a13(WRESTLERNUM),a0
	X32	a0
	addi	ayupwnshort_t,a0

	move	*a13(CLOSEST_XDIST),a1
	move	*a13(CLOSEST_ZDIST),a14
	X2	a14			;Z*2
	cmp	a1,a14
	jrge	ayuphavebig
	move	a1,a14
ayuphavebig
	cmpi	100,a14
	jrlt	ayupshrt
	addi	ayupwnmed_t-ayupwnshort_t,a0

	cmpi	180,a14
	jrlt	ayupmed
	addi	ayupwnlong_t-ayupwnmed_t,a0
ayupshrt
ayupmed
	move	*a0,a9,L		;Get * mode list
	move	b6,a2
	move	b7,a3
ayupmdlp
	movb	*a9,a0			;My mode #
	addk	8,a9
	movb	*a9,a14			;His mode #
	addk	8,a9
	move	*a9+,a1,L		;* script * table

	move	a0,a0
	jrn	ayupinochk			;Don't chk?
	cmp	a2,a0
	jrne	ayupmdlp			;Not in mode?
ayupinochk
	move	a14,a14
	jrn	ayupdef			;Don't chk?
	cmp	a3,a14
	jrne	ayupmdlp			;Not in mode?
ayupdef
	move	a1,a9
ayupgetscrpt
	move	*a9+,a0			;# entries
	jrge	ayupneok			;!Headhold?
	abs	a0
	cmpi	26*16,a10
	jrle	ayupneok			;!Hard?
	movk	1,a0			;Only do first two
ayupneok
	callr	rndrng0
	X32	a0
	add	a0,a9
	move	*a9,a9,L		;* new script

ayupnewsc
	move	b6,a0
	move	a0,*a13(DRN_SPMODE)


	cmpi	MODE_HEADHOLD,b6
	jrne	ayupnhh2

	movk	1,a3
	cmpi	2,b3
	jrlt	ayuphhd1			;1 opp?
	movk	22,a3
ayuphhd1
	movi	sklhhdly_t,a0
	add	a10,a0			;+Offset
	move	*a0,a0
	callr	rndrng0
	add	a0,a3			;Increase per extra bud

	move	@PCNT,a0
	sll	32-1,a0
	jrz	ayuphhdok			;Skip half of checks?

	cmpi	65,a3
	jrle	ayuphhdok
	movi	65,a3			;Max delay
ayuphhdok
	clr	a0
	jruc	ayupsetbx
ayupnhh2

	cmpi	MODE_HEADHELD,b6
	jrne	ayupnhhe

	clr	a0
	move	a0,*a13(DRN_BUTCHRG)	;Clr it

	move	b3,a3			;# on team
	movk	7,a0
	callr	rnd
	jrz	ayuphrskmp			;12% skip multiplyr delay?
	subk	1,a3
	X16	a3
ayuphrskmp
	movi	sklhrdly_t,a0
	add	a10,a0			;+Offset
	move	*a0,a0
	callr	rndrng0
	addk	1,a0
	add	a0,a3			;Increase per extra bud

	move	@PCNT,a0
	sll	32-1,a0
	jrz	ayuphrdok			;Skip half of checks?

	cmpi	70,a3
	jrle	ayuphrdok
	movi	70,a3			;Max delay
ayuphrdok
	clr	a0
	jruc	ayupsetbx
ayupnhhe


ayupcact
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0CHhk script for mode change

	move	b6,a0
	jrz	ayupmdsame			;MODE_NORMAL?
	subk	MODE_BLOCK,a0
	jreq	ayupmdsame			;Treat as normal?
	move	*a13(DRN_SPMODE),a0
	move	b6,a1
	cmp	a1,a0
	.if	DEBUG
	jreq	ayupdsok
	jruc	ayupdsabt			;For breakpoint
ayupdsok
	.endif
	jrne	ayupdsabt

ayupmdsame

	.if	DEBUG
	move	a9,a9			;Chk script *
	jrz	ayupa9ok
	cmpi	0ff000000h,a9
	jrhs	ayupa9ok
	LOCKUP
ayupa9ok
	.endif

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Read script command
ayupscplp
	move	*a9+,a0
	jrge	ayupnocd			;No command?

	sll	32-14,a0
	jrc	ayupdsdone			;Done? (Bit 14)

	srl	32-14,a0

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Seek until 0

	subk	1,a0			;ayup1
	jrne	ayupnseekt0

	callr	drone_seek
	jrz	ayupscplp

	subk	16,a9
	jruc	ayupdsdone
ayupnseekt0
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Random skill lvl abort

	subk	1,a0			;ayup2
	jrne	ayupnrnda

	cmpi	MODE_BLOCK,b7
	jreq	ayupdsabt			;Blking?

	move	*a9+,a3,L		;*Skill table

;	clr	a2
;	cmpi	sklrev_t,a3
;	jrne	ayupnsr
;	move	b3,a2			;# on team
;	subk	1,a2
;	X16	a2
;ayupnsr
	movi	99,a0
	callr	rndrng0
	add	a10,a3			;+Offset
	move	*a3,a1
;	sub	a2,a1			;Decrease per extra bud
	cmp	a1,a0
	jrlt	ayupscplp			;Cont?

	movk	10,a0
	move	a0,*a13(DRN_DELAY)

	jruc	ayupdsabt
ayupnrnda
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Wait till interruptable

	subk	1,a0			;ayup3
	jrne	ayupnwtint

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrz	ayupscplp			;Off?

	subk	16,a9
	jruc	ayupdsdone
ayupnwtint
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0AbHort if opponent blocking

	subk	1,a0			;ayup4
	jrne	ayupnaib

	cmpi	MODE_BLOCK,b7
	jrne	ayupscplp			;!Blocked?

	jruc	ayupdsabt
ayupnaib
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0CaHll code

	subk	1,a0			;ayup5
	jrne	ayupncall

	move	*a9+,a0,L
	call	a0

	jruc	ayupscplp
ayupncall
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Rnd jump

	subk	1,a0			;ayup6
	jrne	ayupnrj

	movi	99,a0
	callr	rndrng0
	move	*a9+,a1			;Percent to jmp
	move	*a9+,a2,L
	cmp	a1,a0
	jrge	ayupscplp

	move	a2,a9			;New addr
	jruc	ayupscplp
ayupnrj
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Jump

	subk	1,a0			;ayup7
	jrne	ayupnjmp

	move	*a9+,a9,L
	jruc	ayupscplp
ayupnjmp
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0CaHll function

	exgpc	a9
	jruc	ayupscplp
ayupnocd
;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			>Joy & button bits

	move	*a9+,a3			;Get delay
ayupsetbx
	move	a0,a1
	sll	32-5,a0
	srl	32-5,a0
	move	a0,*a13(DRN_BUT)

	srl	5,a1
	move	*a13(FACING_DIR),a14
	btst	PLAYER_RIGHT_BIT,a14
	jrnz	ayuprgt			;Facing rgt?

	move	a1,a0			;0FHlip L&R bits
	move	a1,a14
	sll	32-2,a1
	srl	3,a0			;Bit0=Rgt
	sll	32-3,a14
	srl	31,a14
	sll	1,a14			;Bit1=Left
	or	a0,a1
	or	a14,a1
	rl	2,a1
ayuprgt
	move	a1,*a13(DRN_JOY)

	move	a3,*a13(DRN_DELAY)
	move	a3,a3
	jrgt	ayupdsdone
ayupdsabt
	clr	a9
ayupdsdone
	move	a9,*a13(DRN_ACT_p),L

ayupunint

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ			0CaHlc ctrl bit transitions
ayupx
	move	*a13(DRN_BUT),a0
ayupbutx
	move	*a13(DRN_BUTCHRG),a14
	or	a14,a0
	move	a0,*a13(DRN_BUT)
	xor	a0,a6
	move	a6,a1
	and	a0,a6
	move	a6,*a13(DRN_BUTDT)
	andn	a0,a1
	move	a1,*a13(DRN_BUTUT)

	move	*a13(DRN_JOY),a0
	xor	a0,a7
	move	a7,a1
	and	a0,a7
	move	a7,*a13(DRN_JOYDT)
	andn	a0,a1
	move	a1,*a13(DRN_JOYUT)

ayupxx
	rets


SKLM	.macro	w,ad
	.word	:w:,:w:+:ad:,:w:+:ad:*2,:w:+:ad:*3,:w:+:ad:*4
	.endm

ayupgetup_t				;% to bump getup time
	SKLM	10,2
	SKLM	20,2
	SKLM	30,2
	SKLM	40,2
	SKLM	50,2
	SKLM	60,10
ayupblkbase_t				;Base % to block
	SKLM	10,2
	SKLM	20,2
	SKLM	30,1
	SKLM	35,1
	SKLM	40,1
	SKLM	47,7
ayupblkatk_t				;% to block per attack
	.word	0,10,20,30,40
	.word	50,50,50,50,50
sklhhdly_t				;Max delay on hh
	SKLM	150,-6
	SKLM	120,-6
	SKLM	90,-6
	SKLM	60,-6
	SKLM	28,-3
	SKLM	13,-2
sklhrdly_t				;Max delay on hh rev
	SKLM	150,-6
	SKLM	120,-6
	SKLM	90,-6
	SKLM	60,-6
	SKLM	28,-3
	SKLM	13,-2
sklrep_t				;% to repeat
	SKLM	20,4
	SKLM	45,2
	SKLM	55,4
	SKLM	75,2
	SKLM	85,2
	SKLM	90,3


