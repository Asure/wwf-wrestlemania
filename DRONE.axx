*******************************
* Drone script commands

BBL	.macro	w,w2,l
	.byte	:w:,:w2:
	.long	:l:
	.endm

DS_CODE	.macro
	.word	8000h+0
	.endm
DS_CODEEND	.macro
	exgpc	a9
	.endm
DS_SEEKTIL0	.macro
	.word	8000h+1
	.endm
DS_RNDA	.macro	l
	.word	8000h+2
	.long	:l:
	.endm
DS_WTINT	.macro
	.word	8000h+3
	.endm
DS_ABIFBLK	.macro
	.word	8000h+4
	.endm
DS_CALL	.macro	a
	.word	8000h+5
	.long	:a:
	.endm
DS_RJMP	.macro	p,a
	.word	8000h+6,:p:
	.long	:a:
	.endm
DS_JMP	.macro	a
	.word	8000h+7
	.long	:a:
	.endm
DS_SLP1	.macro
	.word	0c000h+0
	.endm
DS_END	.macro
	.word	0,0
	.endm

;ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ		0BaHm bam scripts

bam_s_t
	BBL	MODE_HEADHOLD,-1,baM_hh
	BBL	MODE_HEADHELD,-1,baM_hhr
	BBL	MODE_OPPOVERHEAD,-1,baM_ooh
	BBL	-1,MODE_ONGROUND,M_og
	BBL	-1,MODE_ONTURNBKL,M_opptbkl
	BBL	-1,MODE_CLIMBTURNBKL,M_opptbkl
	WL	-1,baM_n
bam_m_t
	BBL	MODE_HEADHOLD,-1,baM_hh
	BBL	MODE_HEADHELD,-1,baM_hhr
	BBL	MODE_OPPOVERHEAD,-1,baM_ooh
	BBL	-1,MODE_ONGROUND,Mm_og
	BBL	-1,MODE_ONTURNBKL,M_opptbkl
	BBL	-1,MODE_CLIMBTURNBKL,M_opptbkl
	WL	-1,baMm_n

baM_n	;Normal
	.word	(baM_n_-$)/32-1
	.long	tbrqrun
	.long	tbrqp,tbrqsp,tbrqk,tbrqsk
	.long	tbrqspx
	.long	tbrqhgrab,tbrqhgrab,tbrqhgrab
	.long	tbrqflng
	.long	tbrqhtoss,tbrqhtoss
	.long	tbrqllsk		;Karate kick
	.long	tbrqspsk		;Pickup
baM_n_
baMm_n
	.word	(baMm_n_-$)/32-1
	.long	drn_seek
	.long	drn_retreat
	.long	tbrqrun
	.long	tbrqsp
	.long	tbrqsk
;	.long	tbrqhgrab,tbrqhgrab,tbrqhgrab
	.long	tbrqflng
	.long	tbrqllsk		;Karate kick
	.long	tbrqspsk		;Pickup
	.long	tbrqfast		;Hyper
	.long	tbrqchrg
baMm_n_
baM_hh	;Holding head
;	.word	1-1
;	.long	tbrqbahh
	.word	-(7-1)
	.long	tbrqbahhpg		;Pogo
	.long	tbrqlrrsp		;Pile drvr
	.long	tbrqjk		;Pickup
	.long	tbrqbahhrsk	;Knees (3 way)
	.long	tbrqbahhrsk
	.long	tbrqbahhrsk
	.long	tbrqspsk2		;Neck brkr

baM_hhr ;Head held reversals
	.word	4-1
	.long	tbrqk
	.long	tbrqbahhpg		;Pogo
	.long	tbrqlrrsp		;Pile drvr
	.long	tbrqspsk2		;Neck brkr

baM_ooh ;Holding opp over head
	.word	2-1
	.long	tbrqk		;Slam
	.long	tbrqdsk		;Back brkr

tbrqbahhrsk ;Knees
	.word	R_M+SK_M,2
	.word	0,5
;FIX! - chk timing
	.word	SK_M,4, 0,4, SK_M,4, 0,4, SK_M,4, 0,4
	DS_RNDA	sklrep_t
	.word	SK_M,4, 0,4, SK_M,4, 0,4, SK_M,4, 0,4
	DS_RJMP	33,tbrqk		;Hip toss
	DS_RJMP	33,tbrqsp		;Pickup
	.word	D_M+SP_M,0	;Pile drvr
tbrqbahhpg
	.word	U_M,2, D_M,2, 0,2, D_M,2, SK_M,50
	DS_RNDA	sklrep_t
	.word	SP_M,2, 0,2, SP_M,2, 0,2, SP_M,2, 0,15	;Repeat
	DS_RNDA	sklrep_t
	.word	SP_M,2, 0,2, SP_M,2, 0,2, SP_M,2, 0,15
	.word	SP_M,2, 0,2, SP_M,2, 0,2, SP_M,0


