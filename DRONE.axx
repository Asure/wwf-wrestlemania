	DS_JMP	djorcstrt
djorut2
	.word	K_M,2
	DS_JMP	djorcstrt

djoryok
	.word	R_M,2, 0,2, R_M,2, 0,2
	DS_RJMP	50,djoryok2
	.word	SP_M,2
	DS_JMP	djorcstrt
djoryok2
	.word	P_M,2
	DS_JMP	djorcstrt

djorshn
	.word	R_M,2, 0,2, R_M,2, 0,2
	DS_RJMP	50,djorshn2
	.word	P_M,2
	DS_JMP	djorcstrt
djorshn2
	.word	K_M,2
	DS_JMP	djorcstrt

djorbam
	.word	R_M,2, 0,2, R_M,2, 0,2
	DS_RJMP	50,djorbam2
	.word	SP_M,2
	DS_JMP	djorcstrt
djorbam2
	.word	P_M,2
	DS_JMP	djorcstrt

djordnk
	.word	R_M,2, 0,2, R_M,2, 0,2
	DS_RJMP	50,djordnk2
	.word	SP_M,2
	DS_JMP	djorcstrt
djordnk2
	.word	SK_M,2
	DS_JMP	djorcstrt

djorlex
	.word	R_M,2, 0,2, R_M,2, 0,2
	DS_RJMP	50,djorlex2
	.word	SK_M,2
	DS_JMP	djorcstrt
djorlex2
