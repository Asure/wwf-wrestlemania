 SUBRP	drone_chrg

	move	*a13(DRN_BUTCHRG),a14
	jrnz	vcoux			;Already charging?

	movk	20h,a0
	callr	rnd

	move	*a13(WRESTLERNUM),a1
	X64	a1
	addi	vcouwres_t,a1
	add	a0,a1
	move	*a1,a1,L		;Get * script

	move	*a1+,a0
	move	a0,*a13(DRN_BUTCHRG)
;FIX!-all same
	move	*a1+,a0
	move	a0,*a13(DRN_BUTCHRGDLY)
	move	a1,*a13(DRN_BUTCHRG_p),L

vcoux
	rets

vcouwres_t
	.long	vcoubrt,vcoubrt
	.long	vcouraz,vcouraz2
	.long	vcouut,vcouut2
	.long	vcouyok,vcouyok
	.long	vcoushn,vcoushn2
	.long	vcoubam,vcoubam2
	.long	vcoudnk,vcoudnk2
	.long	0,0
	.long	vcoulex,vcoulex2

vcouraz
	.word	SP_M,TSEC*2		;Slashes
	DS_JMP	vcourun
vcouut
	.word	P_M,TSEC*2		;Neck breaker
	DS_JMP	vcourun
vcouyok
	.word	P_M,TSEC*2		;Salt throw
	DS_CODE
	movk	1,a0
	move	a0,*a13(DRN_MODE)	;Aggressive
	DS_CODEEND
	DS_JMP	vcourun
vcoushn
	.word	P_M,TSEC*2		;Suplex
	DS_JMP	vcourun
vcoubam
	.word	P_M,TSEC*2		;Fire punch
	DS_CODE
	clr	a0
	move	a0,*a13(DRN_BUTCHRG)	;Fire it
	DS_CODEEND
	.word	0,4
	.word	P_M,4, 0,4, P_M,4, 0,4, P_M,4, 0,4	;Repeat
	DS_RNDA	sklrep_t
	.word	P_M,4, 0,4, P_M,4, 0,4, P_M,4, 0,4
	DS_RNDA	sklrep_t
	.word	P_M,4, 0,4, P_M,4, 0,4, P_M,4, 0,4
	.word	P_M,4, 0,4, P_M,4, 0,4, P_M,0
vcoubam2
	.word	SP_M,TSEC*2		;Neck brkr
	DS_JMP	vcourun
vcoudnk
	.word	P_M,TSEC*2		;Buzzer
	DS_JMP	vcourun
vcoudnk2
	.word	P_M,TSEC*2		;Buzzer (leap)
	.word	R_M,2
	DS_CODE
	clr	a0
	move	a0,*a13(DRN_BUTCHRG)	;Fire it
	DS_CODEEND
	.word	R_M,2			;Need?
	DS_END
vcoulex
	.word	P_M,TSEC*2		;Smash
	DS_JMP	vcourun
vcoulex2
vcoubrt
vcouraz2
vcouut2
vcoushn2
	.word	SK_M,TSEC*2		;Flying kick
;	DS_JMP	vcourun

vcourun
	DS_CALL	drone_chkrun
	.word	P_M+K_M,0		;Run & end
	DS_CODE

	move	*a13(OBJ_XPOSINT),a0
	move	*a8(OBJ_XPOSINT),a14
	sub	a14,a0
	abs	a0
	cmpi	150,a0
	jrge	vcourx			;X too far?

	move	*a13(OBJ_ZPOSINT),a1
	move	*a8(OBJ_ZPOSINT),a14
	sub	a14,a1
	abs	a1
	cmpi	40,a1
	jrge	vcourx			;Z too far?

	clr	a0
	move	a0,*a13(DRN_BUTCHRG)	;Fire it
vcourx
	DS_CODEEND
	DS_END



