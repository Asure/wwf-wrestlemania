	.file	"robo.asm"
	.title	"robotron game"
	.width	132
	.option	b,d,l,t
	.mnolist


	.include	"mproc.equ"		;Mproc equates
	.include	"display.equ"		;Display proc equates
	.include	"gsp.equ"		;Gsp asm equates
	.include	"sys.equ"
	.include	"game.equ"
	.include	"audit.equ"
	.include	"macros.h"
	.include	"link.equ"

;	.include	"roboimg.glo"
	.include	"roboimg.tbl"
	.include	"fontsimg.glo"

	;kludge
	.ref	robo_p

*****************************************************************************

	;from ADJUST.ASM
	.ref	BINBCD

	;from COLL2.ASM
	.ref	collisions,CCCCount

	;from DCSSOUND.ASM
	.ref	nosounds,SNDSND

	;from DISPLAY.ASM
	.ref	pal_getf,STOPOBJS,fg2bg

	;from MAIN.ASM
	.ref	dpageflip,IRQSKYE

	;from MPROC.ASM
	.ref	KIL1C

	;from STRING.ASM
	.ref	setup_message,print_string_R,mess_objid,copy_string
	.ref	dec_to_asc

	;from UTIL.ASM
	.ref	get_all_buttons_cur,get_stick_val_cur,RNDRNG0,get_start_cur
	.ref	WIPEOUT,CYCLE_TABLE,civani,civanic

	;from WRESTLE.ASM	
	.if DEBUG
	.ref	CPULEFT
	.endif
	.ref	HALT,PCNT

	;for WRESTLE.ASM
	.def	RE_DEADPLAYER,RE_WAVEDONE,RE_ABORT,RE_BACKUP

	.ref	_switch_addr,_switch2_addr,ADD_VOICE

*****************************************************************************

	BSSX	robo_end,	16	;reason for wave end
	BSSX	robotron_score,	32	;UHL score
	.bss	player_dead,	16
	.bss	starts_down,	16	;are both starts down?
	.bss	player_object,	32	;pointer to char1 obj
	.bss	gun_proc,	32	;gun process address
	.bss	robo_wave,	16	;which wave to perform?
	.bss	live_badguys,	16	;wave-preserving badguy count
	.bss	forward,	16	;skip wave
	.bss	backward,	16	;drop back a wave

*****************************************************************************

ROBO_DEBUG	equ	0
WAVE_CONTROL	equ	0
BOG_MONITOR	equ	0

ROBO_PAGE	equ	0*256

ROBJ_MOM	equ	1
ROBJ_DAD	equ	2
ROBJ_KID	equ	3

;termination causes
RE_DEADPLAYER	equ	1
RE_WAVEDONE	equ	2
RE_ABORT	equ	3
RE_BACKUP	equ	4


*****************************************************************************
******************************************************************************
******************************************************************************
	.ref	robo_icon_trigger
	.ref	p1icon_total
	.ref	p2icon_total


 SUBR	robo_check

	.if DEBUG
	jruc	ouwkrobo_ok
	.endif
	jruc	ouwkrobo_end

	move	@p1icon_total,a0,L
	move	@robo_icon_trigger,a14
	cmp	a0,a14
	jrle	ouwkrobo_ok
	move	@p2icon_total,a0,L
	cmp	a0,a14
	jrgt	ouwkrobo_end
ouwkrobo_ok
	sll	1,a14
	move	a14,@robo_icon_trigger
	callr	reset_roboscore
	callr	robo_sound_init

;	movi	-1,a0
;	calla	ADD_VOICE

	clr	a0
ouwkrobo_loop
	JSRP	robo_game
	move	@robo_end,a14
	cmpi	RE_DEADPLAYER,a14
	jreq	ouwkplayer_died
	cmpi	RE_WAVEDONE,a14
	jreq	ouwkwave_successful
	cmpi	RE_ABORT,a14
	jreq	ouwkwave_aborted
	cmpi	RE_BACKUP,a14
	jreq	ouwkback_up
	jruc	ouwkrobo_end

ouwkplayer_died
	jruc	ouwkrobo_loop

ouwkwave_successful
	inc	a0
	cmpi	16,a0
	jrne	ouwkrobo_loop
	jruc	ouwkrobo_end

ouwkwave_aborted
	jruc	ouwkrobo_end

ouwkback_up
	dec	a0
	jrnn	ouwkrobo_loop
	clr	a0
	jruc	ouwkrobo_loop

ouwkrobo_end
	RETP


*****************************************************************************
******************************************************************************
******************************************************************************

 SUBRP	reset_roboscore

	clr	a14
	move	a14,@robotron_score,L
	rets


*****************************************************************************
******************************************************************************
******************************************************************************

 SUBR	robo_game

	sla	4,a0
	move	a0,@robo_wave,W

	calla	display_blank
	calla	WIPEOUT			;CLEAN SYSTEM OUT

	clr	a0
	move	a0,@HALT
	move	a0,@dtype		;2d mode
	move	a0,@IRQSKYE
	move	a0,@CCCCount

	movk	1,a0			;page flipping on
	move	a0,@dpageflip

	SLEEPK	1

	movi	SCRNEND,a0		;[256,405]
	move	a0,@SCRNLR,L

	clr	a0
	move	a0,@WORLDTLX,L
	move	a0,@WORLDTLY,L

	SLEEPK	2

	calla	nosounds		;kill the select music

	;draw the frame
	move	@robo_wave,a0
	addi	vrtsborder_colors,a0
	move	*a0,a0,W
	callr	draw_frame

	movk	1,a0
	move	a0,@DISPLAYON

	SLEEPK	2

	clr	a14
	move	a14,@player_dead,W	;clear the done flag

	;initialize the robo palette color cycles
	callr	robo_pal_cycles

	;initialize the badguy count
	clr	a14
	move	a14,@live_badguys,W

	;place the wave count
	callr	wave_count

	;create the score monitor
	CREATE	ROBOSCORE_PID,score

	;set up the player object
	CREATE	ROBOMAN_PID,our_hero		;start the little guy up
	CREATE	PLYRGUN_PID,player_gun	;give him a weapon
	move	a0,@gun_proc,L		;save the address

	;set up some grunts
	move	@robo_wave,a0
	addi	vrtswave_grunts,a0
	move	*a0,a0,W
	move	@robo_wave,a2
	addi	vrtsgrunt_speeds,a2
	move	*a2,a2,W
	callr	make_grunts

	;make some hulks
	move	@robo_wave,a0
	addi	vrtswave_hulks,a0
	move	*a0,a0,W
	callr	make_hulks

	;sphereoids
	move	@robo_wave,a0
	addi	vrtswave_sphereoids,a0
	move	*a0,a0,W
	callr	make_sphereoids

	;quarks
	move	@robo_wave,a0
	addi	vrtswave_quarks,a0
	move	*a0,a0,W
	callr	make_quarks

	;make a few posts
	move	@robo_wave,a0
	addi	vrtswave_posts,a0
	move	*a0,a0,W

	move	@robo_wave,a1
	addi	vrtspost_types,a1
	move	*a1,a1,W

	move	@robo_wave,a2
	addi	vrtspost_colors,a2
	move	*a2,a2,W

	callr	make_posts

	;and some people
	move	@robo_wave,a0
	move	a0,a1
	move	a0,a2
	addi	vrtswave_moms,a0
	addi	vrtswave_dads,a1	
	addi	vrtswave_kids,a2
	move	*a0,a0,W
	move	*a1,a1,W
	move	*a2,a2,W
	callr	make_humans

	;start the collision checker
	CREATE	COLL_PID,collisions

	;create the both-start-btn watcher
	clr	a0
	move	a0,@starts_down,W
	move	a0,@forward,W
	move	a0,@backward,W
	CREATE	MISC_PID,watch_both_starts

	.if	WAVE_CONTROL
	CREATE	MISC_PID,wave_mover
	.endif

	.if DEBUG
	.if BOG_MONITOR
	CREATE	MISC_PID,bog_o_meter
	.endif
	.endif

	calla	display_unblank

vrtsnot_done
	SLEEPK	1
	move	@live_badguys,a14
	jrz	vrtswave_done

	move	@player_dead,a14
	jrnz	vrtsdead_hero

	move	@starts_down,a14
	jrnz	vrtswave_abort

	move	@forward,a14
	jrnz	vrtswave_done

	move	@backward,a14
	jrnz	vrtsback_up
	jruc	vrtsnot_done


vrtswave_done
	movi	RE_WAVEDONE,a14
	jruc	vrtsquit
vrtsdead_hero
	movi	RE_DEADPLAYER,a14
	jruc	vrtsquit
vrtswave_abort
	movi	RE_ABORT,a14
	jruc	vrtsquit

vrtsback_up
	movi	RE_BACKUP,a14
	jruc	vrtsquit

vrtsquit
	move	a14,@robo_end,W

	;put the wave back in a0 just like we found it
	move	@robo_wave,a0,W
	sra	4,a0
	RETP


vrtsborder_colors
	.if	ROBO_DEBUG
	.word	1
	.endif
	.word	01,06,01,14,07,03,02,08
	.word	00,10,01,06,01,14,07,03

vrtswave_grunts
	.if	ROBO_DEBUG
	.word	4
	.endif
;	.word	15,17,22,34,20,30,00,30
;	.word	30,25,30,00,30,27,25,30

	.word	15,17,22,34,20,32,00,35
	.word	60,25,35,00,35,27,25,35

vrtsgrunt_speeds
	.if	ROBO_DEBUG
	.word	1000
	.endif
	.word	20,15,15,15,15,15,15,15
	.word	15,15,14,14,14,14,14,13

vrtswave_posts
	.if	ROBO_DEBUG
	.word	15
	.endif
	.word	05,15,25,25,20,25,00,25
	.word	00,20,25,00,25,05,20,25

vrtspost_types
	.if	ROBO_DEBUG
	.word	0
	.endif
	.word	0,1,3,8,4,2,0,7
	.word	0,5,0,1,3,8,4,2

vrtspost_colors
	.if	ROBO_DEBUG
	.word	0Fh
	.endif
	.word	15,14,11,13,14,15,14,11
	.word	14,10,15,14,11,13,14,15

vrtswave_hulks
	.if	ROBO_DEBUG
	.word	0
	.endif
	.word	00,05,06,07,00,07,12,08
	.word	04,00,08,13,08,20,02,03

vrtswave_sphereoids
	.if	ROBO_DEBUG
	.word	0
	.endif
	.word	00,01,03,04,01,04,00,05
	.word	05,01,05,00,05,02,01,05

vrtswave_quarks
	.if	ROBO_DEBUG
	.word	0
	.endif
	.word	00,00,00,00,00,00,10,00
	.word	00,00,00,12,00,00,00,00

vrtswave_moms
	.if	ROBO_DEBUG
	.word	2
	.endif
	.word	01,01,02,02,15,03,04,03
	.word	03,00,03,03,03,05,00,03

vrtswave_dads
	.if	ROBO_DEBUG
	.word	2
	.endif
	.word	01,01,02,02,00,03,04,03
	.word	03,22,03,03,03,05,00,03

vrtswave_kids
	.if	ROBO_DEBUG
	.word	2
	.endif
	.word	00,01,02,02,01,03,04,03
	.word	03,00,03,03,03,05,22,03


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	PLAYER SECTION
*

	;reg use
	; a4  - current position in animation script
	; a5  - head of current animation script
	; a6  - tail of current animation script
	; a8  - player object
	; a9  - motion count accumulator
	; a10 - direction of motion

 SUBRP	our_hero

	;create the player object
	movi	[fmkcstart_x,0],a0
	movi	[fmkcstart_y,0],a1
	movi	man_d1,a2
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSPLYR|TYPPLYR,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;set the global pointer
	move	a8,@player_object,L

	; initiailize direction of motion
	clr	a10

fmkcnot_done
	PUSHP	a4,a5,a6
	SLEEPK	1
	PULLP	a4,a5,a6

	; move him first
	callr	fmkcmove_player

	; change his animation frame, if neccesary
	callr	fmkcchange_frame

	jruc	fmkcnot_done

fmkcplayer_dead
	;kill the gun process
	move	@gun_proc,a0,L
	calla	KILL

	movi	BULLET_PID,a0
	calla	KIL1C

	movi	GRUNT_PID,a0
	calla	KIL1C

	movi	HULK_PID,a0
	calla	KIL1C

	movi	HUMAN_PID,a0
	calla	KIL1C

	movi	SPHEREOID_PID,a0
	calla	KIL1C

	movi	ENFORCER_PID,a0
	calla	KIL1C

	movi	SPARK_PID,a0
	calla	KIL1C

	movi	QUARK_PID,a0
	calla	KIL1C

	movi	TANK_PID,a0
	calla	KIL1C

	movi	SHELL_PID,a0
	calla	KIL1C

	calla	STOPOBJS

	;switch frames
	movi	robo_dead,a0,L
	calla	civanic

	;death sound
	movi	RS_DIE,a0
	calla	robo_sound

	SLEEP	120
	movk	1,a14
	move	a14,@player_dead,W

	DIE

******************************************************************************
*
*	player move routine
*

 SUBRP	fmkcmove_player

	clr	a0
	calla	get_stick_val_cur
	btst	JOYDN,a0
	jrnz	fmkcmove_down
	btst	JOYUP,a0
	jrnz	fmkcmove_up
	btst	JOYRGT,a0
	jrnz	fmkcmove_right
	btst	JOYLFT,a0
	jrnz	fmkcmove_left
	jruc	fmkcno_move

fmkcmove_down
	btst	JOYRGT,a0
	jrnz	fmkcmove_downright
	btst	JOYLFT,a0
	jrnz	fmkcmove_downleft

	;increment Y
	move	*a8(OYPOS),a14,W
	inc	a14
	move	a14,*a8(OYPOS),W
	jruc	fmkcmove_done

fmkcmove_up
	btst	JOYRGT,a0
	jrnz	fmkcmove_upright
	btst	JOYLFT,a0
	jrnz	fmkcmove_upleft

	;decrement Y
	move	*a8(OYPOS),a14,W
	dec	a14
	move	a14,*a8(OYPOS),W
	jruc	fmkcmove_done

fmkcmove_right
	;increment X
	move	*a8(OXPOS),a14,W
	inc	a14
	move	a14,*a8(OXPOS),W
	jruc	fmkcmove_done

fmkcmove_left
	;decrement X
	move	*a8(OXPOS),a14,W
	dec	a14
	move	a14,*a8(OXPOS),W
	jruc	fmkcmove_done

fmkcmove_upright
	; decrement Y and increment X
	move	*a8(OYPOS),a14,W
	dec	a14
	move	a14,*a8(OYPOS),W
	move	*a8(OXPOS),a14,W
	inc	a14
	move	a14,*a8(OXPOS),W
	jruc	fmkcmove_done

fmkcmove_upleft
	; decrement Y and decrement X
	move	*a8(OYPOS),a14,W
	dec	a14
	move	a14,*a8(OYPOS),W
	move	*a8(OXPOS),a14,W
	dec	a14
	move	a14,*a8(OXPOS),W
	jruc	fmkcmove_done

fmkcmove_downright
	; increment Y and increment X
	move	*a8(OYPOS),a14,W
	inc	a14
	move	a14,*a8(OYPOS),W
	move	*a8(OXPOS),a14,W
	inc	a14
	move	a14,*a8(OXPOS),W
	jruc	fmkcmove_done

fmkcmove_downleft
	; increment Y and decrement X
	move	*a8(OYPOS),a14,W
	inc	a14
	move	a14,*a8(OYPOS),W
	move	*a8(OXPOS),a14,W
	dec	a14
	move	a14,*a8(OXPOS),W
	jruc	fmkcmove_done

fmkcmove_done
	; check bounds
	move	*a8(OXPOS),a14,W
	cmpi	fmkclow_x,a14,W
	jrgt	fmkcnot_lowx
	; too low on x
	inc	a14
	move	a14,*a8(OXPOS),W

fmkcnot_lowx
	cmpi	fmkchigh_x,a14,W
	jrle	fmkcnot_highx
	; too high on x
	dec	a14
	move	a14,*a8(OXPOS),W

fmkcnot_highx

	move	*a8(OYPOS),a14,W
	cmpi	fmkclow_y,a14,W
	jrgt	fmkcnot_lowy
	; too low on y
	inc	a14
	move	a14,*a8(OYPOS),W

fmkcnot_lowy
	cmpi	fmkchigh_y,a14,W
	jrle	fmkcnot_highy
	; too high on y
	dec	a14
	move	a14,*a8(OYPOS),W

fmkcnot_highy
fmkcno_move

fmkcdone_moving
	rets

******************************************************************************
*
*	player animation routine
*


 SUBRP	fmkcchange_frame
	;reg use
	; a0  scratch
	; a1  sctatch
	; a3  new direction of motion
	; a10 old direction of motion - update

	clr	a0
	clr	a2
	calla	get_stick_val_cur
	move	a0,a3

	cmp	a0,a10
	jreq	fmkcsame_direction
	jruc	fmkcnew_direction

fmkcnew_direction
	; start a new script.  first use the joystick bits to compute an
	; offset into the script table.
	X32	a0		;multiply by 32
	addi	fmkcscript_map,a0	;add the address of the script table
	move	*a0,a0,L	;get the address of the script

	; get the tail and head of the image list for this script
	move	*a0+,a6,L
	move	a0,a5

	;a5 now points to the first image in the script.  change to it.
	move	*a5,a0,L
	calla	civanic

	;set the new direction thingie and script pointer
	move	a3,a10
	move	a5,a4

	;set the motion count
	movi	fmkcmotion_count,a9
	jruc	fmkcdone_changing

fmkcsame_direction
	;check the motion count
	dec	a9
	jrnz	fmkcdone_changing

	;reset the motion count
	movi	fmkcmotion_count,a9

	;increment the pointer, wrap if neccesary
	addi	20h,a4
	cmp	a4,a6
	jrne	fmkcno_wrap
	move	a5,a4

fmkcno_wrap
	;a4 is the new image.  change to it.
	move	*a4,a0,L
	calla	civanic

	jruc	fmkcdone_changing

fmkcdone_changing
	rets


******************************************************************************
*
*	player collision routines
*

 SUBR	player_die
	PUSH	a1,a7

	;we hit some kind of bad guy and are dead
	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	DEADPLAYER_PID,a1
	movi	fmkcplayer_dead,a7
	calla	XFERPROC

	PULL	a1,a7
	rets


******************************************************************************
*
*	player configuration data
*

;start position
fmkcstart_x	equ	197
fmkcstart_y	equ	123

; motion boundaries
fmkclow_x		equ	53
fmkchigh_x		equ	347-7
fmkclow_y		equ	45
fmkchigh_y		equ	231-12

;motion count - controls animation speed
fmkcmotion_count	equ	2	;there will be trouble if this is zero

; walking animation scripts
fmkcani_holdstill
	.long	fmkcani_holdstillx
	.long	man_d1
fmkcani_holdstillx

fmkcani_walkup
	.long	fmkcani_walkupx
	.long	man_u1
	.long	man_u2
	.long	man_u1
	.long	man_u3
fmkcani_walkupx

fmkcani_walkdown
	.long	fmkcani_walkdownx
	.long	man_d1
	.long	man_d2
	.long	man_d1
	.long	man_d3
fmkcani_walkdownx

fmkcani_walkright
	.long	fmkcani_walkrightx
	.long	man_r1
	.long	man_r2
	.long	man_r1
	.long	man_r3
fmkcani_walkrightx

fmkcani_walkleft
	.long	fmkcani_walkleftx
	.long	man_l1
	.long	man_l2
	.long	man_l1
	.long	man_l3
fmkcani_walkleftx

fmkcani_bad
	.long	fmkcani_badx
	.long	robo_bad
fmkcani_badx

; direction - script mappings: use AND combo of joy bits as index
fmkcscript_map
	.long	fmkcani_holdstill
	.long	fmkcani_walkup
	.long	fmkcani_walkdown
	.long	fmkcani_bad
	.long	fmkcani_walkleft
	.long	fmkcani_walkleft
	.long	fmkcani_walkleft
	.long	fmkcani_bad
	.long	fmkcani_walkright
	.long	fmkcani_walkright
	.long	fmkcani_walkright
	.long	fmkcani_bad
	.long	fmkcani_bad
	.long	fmkcani_bad
	.long	fmkcani_bad
	.long	fmkcani_bad
fmkcscript_mapx


*****************************************************************************
*
*	player gun process
*

	;reg use
	;a9  time till next shot is allowed

 SUBRP	player_gun

	clr	a9
	jruc	nkwfsleep

nkwfcheck_shot
	movk	1,a0
	calla	get_stick_val_cur
	jrz	nkwfsleep			;no shot

	;fire in the indicated direction
	move	a0,a10
	CREATE	BULLET_PID,bullet
	movi	nkwfrate_of_fire,a9

	;shoot sound
	movi	RS_SHOOT,a0
	callr	robo_sound

	jruc	nkwfsleep
	
nkwftoo_soon
	dec	a9
	jruc	nkwfsleep

nkwfsleep
	SLEEPK	1
	move	a9,a9
	jrnz	nkwftoo_soon
	jruc	nkwfcheck_shot

nkwfdone
	DIE

nkwfrate_of_fire	equ	6	;min ticks between shots


*****************************************************************************
*
*	player bullet process
*

	;reg use
	; a4 velocity accumulator (used to pick the correct bullet)
	; a5 vert indicator
	; a8 bullet object
	;a10 (in) stick bits

 SUBRP	bullet

	;create a bullet object
	movi	[500,0],a0
	clr	a1
	movi	bullet_hrz,a2
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSPLYR|TYPBULLET,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;set the speed and start position
	move	@player_object,a9,L
	clr	a4
	clr	a5
	move	*a9(OXPOS),a0,W
	addk	hdrzbstart_xoff,a0
	move	a0,*a8(OXPOS),W
	move	*a9(OYPOS),a0,W
	addk	hdrzbstart_yoff,a0
	move	a0,*a8(OYPOS),W

	btst	JOYRGT,a10
	jrz	hdrznot_right
	move	*a8(OXPOS),a14,W	;pos
	addi	hdrzbstart_radj,a14
	move	a14,*a8(OXPOS),W
	movi	hdrzbullet_speed,a0	;speed
	move	a0,*a8(OXVEL),L
	inc	a4

hdrznot_right

	btst	JOYLFT,a10
	jrz	hdrznot_left
	move	*a8(OXPOS),a14,W	;pos
	addi	hdrzbstart_ladj,a14
	move	a14,*a8(OXPOS),W
	movi	-hdrzbullet_speed,a0	;speed
	move	a0,*a8(OXVEL),L
	dec	a4

hdrznot_left

	btst	JOYUP,a10
	jrz	hdrznot_up
	move	*a8(OYPOS),a14,W	;pos
	addi	hdrzbstart_uadj,a14
	move	a14,*a8(OYPOS),W
	movi	-hdrzbullet_speed,a0	;speed
	move	a0,*a8(OYVEL),L
	dec	a4
	inc	a5

hdrznot_up

	btst	JOYDN,a10
	jrz	hdrznot_down
	move	*a8(OYPOS),a14,W	;pos
	addi	hdrzbstart_dadj,a14
	move	a14,*a8(OYPOS),W
	movi	hdrzbullet_speed,a0	;speed
	move	a0,*a8(OYVEL),L
	inc	a4
	inc	a5

hdrznot_down

	;set the image
	movi	bullet_hrz,a0
	move	a5,a5
	jrz	hdrzhoriz
	movi	bullet_vrt,a0
hdrzhoriz

	;vert/horz is set.  check for diagonal instead
	cmpi	1,a4
	jreq	hdrzimage_set
	cmpi	-1,a4
	jreq	hdrzimage_set

	;it's a diagonal.  if a4 is 0, use frontslash
	move	a4,a4
	jrz	hdrzfront_slash
	movi	bullet_bck,a0
	jruc	hdrzimage_set

hdrzfront_slash
	movi	bullet_fnt,a0

hdrzimage_set
	calla	civanic

hdrzloop
	callr	bounds_check
	move	a0,a0
	jrnz	hdrzhit_wall
	SLEEPK	1
	jruc	hdrzloop

hdrzhit_wall
	;zoinks!  We've hit a wall. back up to be flush against it.
	; a2 holds the number of pixels we have to back up.

	;well, we can overlap on the wall a LITTLE.  say, 2 pixels.
	subk	2,a2

	move	*a8(OXVEL),a0,L
	jrz	hdrzy_adjust
	jrn	hdrzneg_xvel
	move	*a8(OXPOS),a0,W
	sub	a2,a0
	move	a0,*a8(OXPOS),W
	jruc	hdrzy_adjust
hdrzneg_xvel
	move	*a8(OXPOS),a0,W
	add	a2,a0
	move	a0,*a8(OXPOS),W

hdrzy_adjust
	move	*a8(OYVEL),a0,L
	jrz	hdrzkill_bullet
	jrn	hdrzneg_yvel
	move	*a8(OYPOS),a0,W
	sub	a2,a0
	move	a0,*a8(OYPOS),W
	jruc	hdrzkill_bullet
hdrzneg_yvel
	move	*a8(OYPOS),a0,W
	add	a2,a0
	move	a0,*a8(OYPOS),W

hdrzkill_bullet
	SLEEPK	1
	calla	DELOBJA8
	DIE


******************************************************************************
*
* player bullet collision routines
*

 SUBR	bullet_die
	PUSH	a1,a7,a9,a10,a11

	;we hit some kind of bad guy and are stopped.
	movi	CLSDEAD,a14
	move	a14,*A8(OID)
	move	*a8(OPLINK),a0,L
	movi	DEADBULLET_PID,a1
	movi	hdrzkill_bullet,a7
	calla	XFERPROC

	PULL	a1,a7,a9,a10,a11
	rets


hdrzbullet_speed	equ	00080000h	;pixels per frame

hdrzlow_x		equ	53
hdrzhigh_x		equ	346
hdrzlow_y		equ	45
hdrzhigh_y		equ	230

;hero anim point is top left.  bullet anim point is center.  use these to
; adjust the starting position of the bullet.
; No.  The bullet anim points are gone now.  Unk.
hdrzbstart_xoff	equ	3
hdrzbstart_yoff	equ	5

hdrzbstart_radj	equ	7
hdrzbstart_ladj	equ	-13
hdrzbstart_uadj	equ	-14
hdrzbstart_dadj	equ	8


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	GRUNT SECTION
*

	;reg use
	; a0 (in) # of grunts
	; a1 scratch
	; a2 (in) initial speed

 SUBRP	make_grunts

	move	a0,a0
	jrz	jzlldone

jzllanother_grunt
	PUSHP	a0

jzllget_pos
	movi	jzllmax_x-jzllmin_x,a0
	calla	RNDRNG0
	move	a0,a9
	movi	jzllmax_y-jzllmin_y,a0
	calla	RNDRNG0
	move	a0,a10

	addi	jzllmin_x,a9
	addi	jzllmin_y,a10

	cmpi	jzllmid_x1,a9
	jrle	jzllplace_grunt
	cmpi	jzllmid_x2,a9
	jrge	jzllplace_grunt
	cmpi	jzllmid_y1,a10
	jrle	jzllplace_grunt
	cmpi	jzllmid_y2,a10
	jrge	jzllplace_grunt
	jruc	jzllget_pos

jzllplace_grunt
	;assign a random starting position
	move	a2,a11
	CREATE	GRUNT_PID,grunt
	PULLP	a0
	dsj	a0,jzllanother_grunt

jzlldone
	rets


jzllmin_x	equ	53	;grunt start outer boundaries
jzllmax_x	equ	347-9
jzllmin_y	equ	45
jzllmax_y	equ	231-13

jzllmid_x1	equ	200-60	;grunt start inner boundaries
jzllmid_x2	equ	200+60
jzllmid_y1	equ	138-60
jzllmid_y2	equ	138+60


*****************************************************************************
*
*	grunt process
*

	STRUCTPD
	WORD	dhrpACCEL_TIMER	;UHW accelerator count
	LONG	dhrpDEATH_SEQUENCE	;UHL anim to use when dying
				;    (set by coll routines)

	;reg use
	; a8 object handle
	; a9 (in)  starting x
	; a9 (use) ticks between moves
	;a10 (in)  starting y
	;a10 (use) ticks until next move
	;a11 (in)  initial speed
	;a11 (use) frame count

 SUBRP	grunt

	;increment the badguy count
	move	@live_badguys,a14,W
	inc	a14
	move	a14,@live_badguys,W

	;create a grunt object
	move	a9,a0
	sla	16,a0
	move	a10,a1
	sla	16,a1
	movi	grunt_1,a2
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPGRUNT,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;initialize move timer
	move	a11,a9

	;initialize time till next move
	move	a9,a0
	calla	RNDRNG0
	add	a11,a0
	move	a0,a10

	;initialize accel counter
	movi	dhrpacceleration,a14
	move	a14,*a13(dhrpACCEL_TIMER),W

	;initialize frame counter
	clr	a11

dhrploop
	move	*a13(dhrpACCEL_TIMER),a14,W
	dec	a14
	jrnz	dhrpno_accel

	movi	dhrpacceleration,a14
	cmpi	dhrptop_speed,a9
	jreq	dhrpno_accel
	dec	a9

dhrpno_accel
	move	a14,*a13(dhrpACCEL_TIMER),W
	SLEEPK	1

	dsj	a10,dhrploop
	callr	dhrpmove_grunt
	move	a9,a10
	jruc	dhrploop

dhrpdie
	;we've croaked
	;decrement the badguy count
	move	@live_badguys,a14,W
	dec	a14
	move	a14,@live_badguys,W

	;set up the animation
	move	*a13(dhrpDEATH_SEQUENCE),a9,L
	move	*a8(OCTRL),a0

dhrpdieloop
	move	*a9+,a0,L
	jrz	dhrpdead_n_buried
	calla	civanic
	sleepk	dhrpdeath_speed
	jruc	dhrpdieloop

dhrpdead_n_buried
	calla	DELOBJA8

	DIE

******************************************************************************
*
*	grunt move routine
*

 SUBRP	dhrpmove_grunt
	move	@player_object,a14,L

	;move in X
	move	*a14(OXPOS),a0,W
	move	*a8(OXPOS),a1,W
	sub	a1,a0
	jrz	dhrpdone_movex
	jrn	dhrpmove_left
	jruc	dhrpmove_right

dhrpmove_left
	move	*a8(OXPOS),a1,W
	addi	-dhrpxmotion_inc,a1
	move	a1,*a8(OXPOS),W
	jruc	dhrpdone_movex

dhrpmove_right
	move	*a8(OXPOS),a1,W
	addi	dhrpxmotion_inc,a1
	move	a1,*a8(OXPOS),W
	jruc	dhrpdone_movex

dhrpdone_movex

	move	*a14(OYPOS),a0,W
	move	*a8(OYPOS),a1,W
	sub	a1,a0
	jrz	dhrpdone_movey
	jrn	dhrpmove_up
	jruc	dhrpmove_down

dhrpmove_up
	move	*a8(OYPOS),a1,W
	addi	-dhrpymotion_inc,a1
	move	a1,*a8(OYPOS),W
	jruc	dhrpdone_movey

dhrpmove_down
	move	*a8(OYPOS),a1,W
	addi	dhrpymotion_inc,a1
	move	a1,*a8(OYPOS),W
	jruc	dhrpdone_movey

dhrpdone_movey

	;step through the animation
	inc	a11
	cmpi	4,a11
	jrne	dhrpno_wrap
	clr	a11

dhrpno_wrap
	move	a11,a14
	X32	a14
	addi	dhrpwalk_script,a14
	move	*a14,a0,L
	calla	civanic

	;sound
	movi	RS_GRUNT,a0
	callr	robo_sound
	rets


******************************************************************************
*
*	grunt collision routines
*

 SUBR	grunt_shot
	;hit by player gunfire
	PUSH	a1,a7

	;jeepers.  we're dead.
	movi	CLSDEAD,a14
	move	a14,*a8(OID),W

	move	*a0(OXVEL),a14,L
	jrz	dhrpvert_bullet
	move	*a0(OYVEL),a1,L
	jrz	dhrphorz_bullet

	add	a1,a14
	jrz	dhrpdiag_13
	jruc	dhrpdiag_24

dhrphorz_bullet
	movi	dhrpdie_vert,a14
	jruc	dhrpdeath_set
dhrpvert_bullet
	movi	dhrpdie_horz,a14
	jruc	dhrpdeath_set
dhrpdiag_13
	movi	dhrpdie_diag24,a14
	jruc	dhrpdeath_set
dhrpdiag_24
	movi	dhrpdie_diag13,a14
	jruc	dhrpdeath_set

dhrpdeath_set

	move	*a8(OPLINK),a0,L
	move	a14,*a0(dhrpDEATH_SEQUENCE),L
	movi	DEADGRUNT_PID,a1
	movi	dhrpdie,a7

	move	*a0(PA9),a9,L
	move	*a0(PA10),a10,L
	calla	XFERPROC

	movi	dhrpgrunt_points,a0
	callr	score_points

	;die sound
	movi	RS_HIT,a0
	calla	robo_sound

	PULL	a1,a7
	rets


 SUBR	grunt_die
	;hit a mine or something

	PUSH	a1,a7

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	dhrpdie_vert,a14
	move	a14,*a0(dhrpDEATH_SEQUENCE),L
	movi	DEADGRUNT_PID,a1
	movi	dhrpdie,a7
	move	*a0(PA9),a9,L
	move	*a0(PA10),a10,L
	calla	XFERPROC

	PULL	a1,a7
	rets


******************************************************************************
*
*	grunt configuration data
*


dhrpwalk_script
	.long	grunt_1
	.long	grunt_2
	.long	grunt_1
	.long	grunt_3
dhrpwalk_scriptx

dhrpdie_vert
	.long	grunt_xv1
	.long	grunt_xv2
	.long	grunt_xv3
	.long	grunt_xv4
	.long	0
dhrpdie_vertx

dhrpdie_horz
	.long	grunt_xh1
	.long	grunt_xh2
	.long	grunt_xh3
	.long	grunt_xh4
	.long	0
dhrpdie_horzx

dhrpdie_diag13
	.long	grunt_xdf1
	.long	grunt_xdf2
	.long	grunt_xdf3
	.long	grunt_xdf4
	.long	0
dhrpdie_diag13x

dhrpdie_diag24
	.long	grunt_xdb1
	.long	grunt_xdb2
	.long	grunt_xdb3
	.long	grunt_xdb4
	.long	0
dhrpdie_diag24x

dhrpdeath_speed	equ	3		;death seq anim speed

dhrpacceleration	equ	100		;decrement motion clock every X cycles
dhrptop_speed	equ	3		;as fast as they get
dhrpxmotion_inc	equ	0004h
dhrpymotion_inc	equ	0004h

dhrpgrunt_points	equ	100		;points for killing a grunt

*****************************************************************************
******************************************************************************
******************************************************************************
*
*	POST SECTION
*
	;reg use
	; a0 - (in) # of posts to create
	; a1 - (in) type (0-8)
	; a2 - (in) color (0-F)

 SUBRP	make_posts

	move	a0,a9		;move the inputs to safer spots
	jrz	pfqkdone

	move	a1,a10		;type

	move	a2,a11		;color
	sla	8,a11
	or	a2,a11

pfqkanother_post
pfqkget_pos
	movi	pfqkmax_y-pfqkmin_y,a0
	calla	RNDRNG0
	move	a0,a2			;hide a0
	movi	pfqkmax_x-pfqkmin_x,a0
	calla	RNDRNG0
	move	a2,a1			;put it back

	addi	pfqkmin_x,a0
	addi	pfqkmin_y,a1

	cmpi	pfqkmid_x1,a0
	jrle	pfqkplace_post
	cmpi	pfqkmid_x2,a0
	jrge	pfqkplace_post
	cmpi	pfqkmid_y1,a1
	jrle	pfqkplace_post
	cmpi	pfqkmid_y2,a1
	jrge	pfqkplace_post
	jruc	pfqkget_pos

pfqkplace_post
	sla	16,a0			;X pos
	sla	16,a1			;Y pos

	;create the post object
	move	a10,a14
	X32	a14
	addi	pfqkpost_types,a14
	move	*a14,a14,L
	move	*a14,a2,L		;DON'T advance

	clr	a3
	movi	DMACNZ,a4
	movi	CLSNEUT|TYPPOST,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	move	a10,*a8(OMISC),W	;stuff the type in the object

	move	a11,*a8(OCONST),W

	movi	robo_p,a0
	calla	pal_getf
	move	a0,*a8(OPAL),W

	dsj	a9,pfqkanother_post

pfqkdone
	rets


pfqkmin_x	equ	53	;post start outer boundaries
pfqkmax_x	equ	347-17
pfqkmin_y	equ	45
pfqkmax_y	equ	231-10

pfqkmid_x1	equ	200-50	;post start inner boundaries
pfqkmid_x2	equ	200+50
pfqkmid_y1	equ	138-50
pfqkmid_y2	equ	138+50


******************************************************************************
*
*	post collision routines
*

 SUBR	post_die

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	CREATE	DEADPOST_PID,kill_post

	rets


	;reg use
	; a8 - * image
	; a9 - anim pointer

 SUBR	kill_post

	move	*a8(OMISC),a0,W
	X32	a0
	addi	pfqkpost_types,a0
	move	*a0,a9,L
	move	*a8(OCTRL),a14,W
	xori	DMACNZ,a14
	ori	DMAWNZ,a14
	move	a14,*a8(OCTRL),W
pfqkkploop
	move	*a9+,a0,L
	jrz	pfqkkpdone
	calla	civanic
	SLEEPK	pfqkdie_speed
	jruc	pfqkkploop

pfqkkpdone
	calla	DELOBJA8
	DIE


pfqkdie_speed	equ	3

pfqkpost_types
	.long	pfqkstar		;0
	.long	pfqkcrystal	;1
	.long	pfqkdiamond	;2
	.long	pfqksquare		;3
	.long	pfqkrectangle	;4
	.long	pfqkR2084		;5
	.long	pfqkpcube		;6
	.long	pfqkspiral		;7
	.long	pfqktriangle	;8
	.long	0
pfqkpost_typesx

pfqkstar
	.long	star_1,star_2,star_3,0

pfqkcrystal
	.long	crystal_1,crystal_2,crystal_3,0

pfqkdiamond
	.long	diamond_1,diamond_2,diamond_3,0

pfqksquare
	.long	square_1,square_2,square_3,0

pfqkrectangle
	.long	rectangle_1,rectangle_2,rectangle_3,0

pfqkR2084
	.long	R2084_1,R2084_2,R2084_3,0

pfqkpcube
	.long	pcube_1,pcube_2,pcube_3,0

pfqkspiral
	.long	spiral_1,spiral_2,spiral_3,0

pfqktriangle
	.long	triangle_1,triangle_2,triangle_3,0


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	HUMAN SECTION
*

	.bss	humans_saved,	16

	;reg use
	; a0 # of moms
	; a1 # of dads
	; a2 # of kids 

 SUBRP	make_humans

	;initialize the savecount
	clr	a14
	move	a14,@humans_saved,W

	;first make the moms
	move	a0,a0
	jrz	ikolskip_moms
ikolmom_loop
	PUSHP	a0,a1,a2
	callr	ikolrand_position
	movi	ROBJ_MOM,a9
	CREATE	HUMAN_PID,human
	PULLP	a0,a1,a2
	dsj	a0,ikolmom_loop

ikolskip_moms

	;dads
	move	a1,a1
	jrz	ikolskip_dads
ikoldad_loop
	PUSHP	a1,a2
	callr	ikolrand_position
	movi	ROBJ_DAD,a9
	CREATE	HUMAN_PID,human
	PULLP	a1,a2
	dsj	a1,ikoldad_loop

ikolskip_dads

	;kids
	move	a2,a2
	jrz	ikolskip_kids
ikolkid_loop
	PUSHP	a2
	callr	ikolrand_position
	movi	ROBJ_KID,a9
	CREATE	HUMAN_PID,human
	PULLP	a2
	dsj	a2,ikolkid_loop

ikolskip_kids
	rets


	;reg use
	; no input
	;a10 - (ret) an X val
	;a11 - (ret) a Y val

 SUBRP ikolrand_position
	movi	ikolmax_x-ikolmin_x,a0
	calla	RNDRNG0
	move	a0,a10
	addi	ikolmin_x,a10

	movi	ikolmax_y-ikolmin_y,a0
	calla	RNDRNG0
	move	a0,a11
	addi	ikolmin_y,a11

	rets


******************************************************************************
*
*	human process
*
	STRUCTPD
	LONG	ikolHITPOST	;UHL post we've hit

	;reg use
	; a8 - hObject
	; a9 - (in)  OID
	; a9 - (use) image table address (ikolmom_table, ikoldad_table...)
	;a10 - (in)  x
	;a10 - (use) direction of motion (1-8)
	;a11 - (in)  y
	;a11 - (use) frame index (0-3)


 SUBRP	human

	cmpi	ROBJ_MOM,a9
	jreq	ikolinit_mom
	cmpi	ROBJ_DAD,a9
	jreq	ikolinit_dad
	cmpi	ROBJ_KID,a9
	jreq	ikolinit_kid

	LOCKUP	;bad objid

ikolinit_mom
	movi	ikolmom_table,a9
	jruc	ikolmake_obj

ikolinit_dad
	movi	ikoldad_table,a9
	jruc	ikolmake_obj

ikolinit_kid
	movi	ikolkid_table,a9
	jruc	ikolmake_obj

ikolmake_obj
	;cweate a widdle people object
	move	a10,a0
	sla	16,a0
	move	a11,a1
	sla	16,a1
	move	*a9(ikolwalk_down),a2,L
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSNEUT|TYPHUMAN,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;choose a direction of motion
	movi	7,a0
	calla	RNDRNG0
	inc	a0
	move	a0,a10

	;set the frame index
	movi	3,a11
	callr	ikoladvance_frame

ikolmove_loop
	SLEEPK	ikolsleep_time
	callr	ikolrand_dirchange
	callr	ikolmove_onestep
	move	a0,a0
	jrnz	ikolhit_wall
	callr	ikoladvance_frame
	jruc	ikolmove_loop

ikolhit_wall
	;sleep first because: If you move and bump into both a wall and a
	; post at the same time (could happen), and then you immediately
	; reverse direction, you'll then get flipped AGAIN when you hit
	; the post and get forwarded right through the wall.  yuck.  so
	; instead when you hit a wall, wait a frame and let the post
	; collisions sort themselves out, THEN change direction.
	SLEEPK	1
	callr	ikolreverse_direction
	callr	ikoladvance_frame
	jruc	ikolmove_loop

ikolhit_post
	callr	post_adjust
	callr	ikoladvance_frame
	jruc	ikolmove_loop

ikolsaved
	;sound
	movi	RS_RESCUE,a0
	callr	robo_sound

	;increment the save count
	move	@humans_saved,a14,W
	inc	a14
	move	a14,@humans_saved,W

	cmpi	5,a14
	jrle	ikolno_cap
	movi	5,a14
ikolno_cap
	dec	a14

	PUSH	a14
	sla	4,a14
	addi	ikolscore_table,a14
	move	*a14,a0,W
	callr	score_points
	PULL	a14

	X32	a14
	addi	ikolsaved_table,a14
	move	*a14,a0,L
	calla	civanic

	SLEEP	120
	calla	DELOBJA8
	jruc	ikoldone

ikolkilled
	movi	skull,a0
	calla	civanic

	SLEEP	120
	calla	DELOBJA8
;	jruc	ikoldone		;fall through

ikoldone
	DIE


******************************************************************************
* Human has bounced into or started inside a post.  Make it better.
* Do this by reversing the direction of the human and moving it forward
* in the new direction until it's clear of the post.
*

	;reg use
	; a0 - X overlap
	; a1 - Y overlap

 SUBRP	post_adjust
	PUSH	a0,a1,a2,a3,a7

	move	*a13(ikolHITPOST),a7,L

	callr	ikolreverse_direction

	;calculate degree of X and Y overlap
	move	a10,a2
	X32	a2
	addi	ikolwalk_increments,a2
	move	*a2+,a3,W	;y vel
	jrn	ikolyvel_neg
	jrz	ikolyvel_zero

ikolyvel_pos
	move	*a7(OYPOS),a1
	move	*a7(OSIZEY),a14
	add	a14,a1
	move	*a8(OYPOS),a14
	sub	a14,a1
	jruc	ikoldo_xvel
ikolyvel_zero
	movi	100h,a1
	jruc	ikoldo_xvel
ikolyvel_neg
	move	*a8(OYPOS),a1
	move	*a8(OSIZEY),a14
	add	a14,a1
	move	*a7(OYPOS),a14
	sub	a14,a1
;	jruc	ikoldo_xvel

ikoldo_xvel
	move	*a2,a3,W	;x vel
	jrn	ikolxvel_neg
	jrz	ikolxvel_zero

ikolxvel_pos
	move	*a7(OXPOS),a0
	move	*a7(OSIZEX),a14
	add	a14,a0
	move	*a8(OXPOS),a14
	sub	a14,a0
	jruc	ikolovlap_done
ikolxvel_zero
	movi	100h,a0
	jruc	ikolovlap_done
ikolxvel_neg
	move	*a8(OXPOS),a0
	move	*a8(OSIZEX),a14
	add	a14,a0
	move	*a7(OXPOS),a14
	sub	a14,a0
;	jruc	ikolovlap_done

ikolovlap_done
	;a0 and a1 are the X and Y overlaps, respectively.  We need only
	; worry about the smallest of the two and move that many steps.  Note
	; that if velocity in a given direction is zero, the overlap is
	; set to some outrageously large value so that the other direction
	; is all that counts.
	cmp	a1,a0
	jrle	ikollow_set
	move	a1,a0
ikollow_set
	;a0 is now the smallest.
	move	a0,a1
	move	a10,a2
	X32	a2
	addi	ikolwalk_increments,a2
	move	*a2+,a3,W	;y vel
	mpys	a3,a1
	move	*a2,a3,W	;x vel
	mpys	a0,a3
	move	a3,a0

	;a0 and a1 now hold X and Y adjustments, respectively.
	move	*a8(OXPOS),a14
	add	a0,a14
	move	a14,*a8(OXPOS)
	move	*a8(OYPOS),a14
	add	a1,a14
	move	a14,*a8(OYPOS)
	
	PULL	a0,a1,a2,a3,a7
	rets


******************************************************************************
*
*	human movement/animation routine
*

	;reg use
	; a0 - scratch
	; a0 (out) - walls hit (0-2)
	; a1 - scratch
	; a8 - (in)  hObject
	; a9 - (in)  image table address (ikolmom_table, ikoldad_table...)
	;a10 - (in)  direction of motion (1-8)
	;a11 - (in)  frame index (0-3)

 SUBRP	ikolmove_onestep

	;move the object
	move	a10,a1
	X32	a1
	addi	ikolwalk_increments,a1
	move	*a1+,a14,W
	move	*a8(OYPOS),a0,W
	add	a14,a0
	move	a0,*a8(OYPOS),W
	move	*a1+,a14,W
	move	*a8(OXPOS),a0,W
	add	a14,a0
	move	a0,*a8(OXPOS),W

	clr	a1
	move	*a8(OXPOS),a0,W

	cmpi	ikolmin_x,a0
	jrge	ikolnot_lowx

	;low x
	inc	a1
	movi	ikolmin_x,a0
	move	a0,*a8(OXPOS),W

ikolnot_lowx
	cmpi	ikolmax_x,a0
	jrle	ikolnot_highx

	;high x
	inc	a1
	movi	ikolmax_x,a0
	move	a0,*a8(OXPOS),W

ikolnot_highx

	move	*a8(OYPOS),a0,W

	cmpi	ikolmin_y,a0
	jrge	ikolnot_lowy

	;low y
	inc	a1
	movi	ikolmin_y,a0
	move	a0,*a8(OYPOS),W

ikolnot_lowy
	cmpi	ikolmax_y,a0
	jrle	ikolnot_highy

	;high y
	inc	a1
	movi	ikolmax_y,a0
	move	a0,*a8(OYPOS),W

ikolnot_highy
	move	a1,a0
	rets


******************************************************************************
* Changes direction one time in ikoldirchange_chance.
*

 SUBRP	ikolrand_dirchange

	;1 chance in ikoldirchange_chance of spontaneously switching direction
	movi	ikoldirchange_chance,a0
	calla	RNDRNG0
	move	a0,a0
	jrnz	ikoldirchange_done
	movi	7,a0
	calla	RNDRNG0
	inc	a0
	move	a0,a10

ikoldirchange_done
	rets


******************************************************************************
* Reverses direction
*

 SUBRP	ikolreverse_direction

	;reverse direction of motion
	subi	4,a10
	jrp	ikolrd_done
	addi	8,a10
ikolrd_done
	rets

******************************************************************************
* Advances the frame
*

 SUBRP	ikoladvance_frame

	;advance the frame and set the new image
	inc	a11
	cmpi	4,a11
	jrne	ikolno_wrap
	;wraparound.  reset to start
	clr	a11

ikolno_wrap
	;calculate the next frame
	move	a9,a0
	move	a10,a1
	sla	4,a1		;mult by 10h
	addi	ikolmotion_table,a1

	;a1 now points to one of the entries in ikolmotion table
	move	*a1,a1,W
	add	a1,a0

	;a0 now points to an entry in ikolxxx_table
	move	a11,a1
	X32	a1		;mult by 20h
	add	a1,a0
	move	*a0,a0,L

	calla	civanic

	rets


******************************************************************************
*
*	human collision routines
*

 SUBR	human_saved
	PUSH	a1,a7

	;change the obj id
	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	SAVEDHUMAN_PID,a1
	movi	ikolsaved,a7
	calla	XFERPROC

	PULL	a1,a7
	rets

 SUBR	human_killed
	PUSH	a1,a7

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	DEADHUMAN_PID,a1
	movi	ikolkilled,a7
	calla	XFERPROC

	PULL	a1,a7
	rets


 SUBR	human_hitpost
	PUSH	a1,a7

	move	a0,a1
	move	*a8(OPLINK),a0,L
	move	a1,*a0(ikolHITPOST),L
	move	*a0(PA8),a8,L
	move	*a0(PA9),a9,L
	move	*a0(PA10),a10,L
	move	*a0(PA11),a11,L
	movi	HUMAN_PID,a1
	movi	ikolhit_post,a7
	calla	XFERPROC

	PULL	a1,a7
	rets

******************************************************************************
*
*	human configuration data
*


ikolmin_x	equ	53	;human start/motion outer boundaries
ikolmax_x	equ	347-11
ikolmin_y	equ	45
ikolmax_y	equ	231-13

ikolsleep_time	equ	7
ikolx_step		equ	1
ikoly_step		equ	1

ikoldirchange_chance	equ	40

ikolwalk_increments
	.word	0,0			;because direction is 1-8, not 0-7
	.word	-ikoly_step,0
	.word	-ikoly_step,ikolx_step
	.word	0,ikolx_step
	.word	ikoly_step,ikolx_step
	.word	ikoly_step,0
	.word	ikoly_step,-ikolx_step
	.word	0,-ikolx_step
	.word	-ikoly_step,-ikolx_step
ikolwalk_incrementsx

ikolmotion_table
	.word	0			;because direction is 1-8, not 0-7
	.word	ikolwalk_up
	.word	ikolwalk_right
	.word	ikolwalk_right
	.word	ikolwalk_right
	.word	ikolwalk_down
	.word	ikolwalk_left
	.word	ikolwalk_left
	.word	ikolwalk_left
ikolmotion_tablex

;image table direction offsets
ikolwalk_left	equ	0000h
ikolwalk_right	equ	ikolwalk_left + (4 * 20h)
ikolwalk_up	equ	ikolwalk_right + (4 * 20h)
ikolwalk_down	equ	ikolwalk_up + (4 * 20h)

ikolscore_table
	.word	1000,2000,3000,4000,5000
ikolscore_tablex

;image tables
ikolmom_table
	.long	mom_l1
	.long	mom_l2
	.long	mom_l1
	.long	mom_l3

	.long	mom_r1
	.long	mom_r2
	.long	mom_r1
	.long	mom_r3

	.long	mom_u1
	.long	mom_u2
	.long	mom_u1
	.long	mom_u3

	.long	mom_d1
	.long	mom_d2
	.long	mom_d1
	.long	mom_d3
ikolmom_tablex

ikoldad_table
	.long	dad_l1
	.long	dad_l2
	.long	dad_l1
	.long	dad_l3

	.long	dad_r1
	.long	dad_r2
	.long	dad_r1
	.long	dad_r3

	.long	dad_u1
	.long	dad_u2
	.long	dad_u1
	.long	dad_u3

	.long	dad_d1
	.long	dad_d2
	.long	dad_d1
	.long	dad_d3
ikoldad_tablex

ikolkid_table
	.long	kid_l1
	.long	kid_l2
	.long	kid_l1
	.long	kid_l3

	.long	kid_r1
	.long	kid_r2
	.long	kid_r1
	.long	kid_r3

	.long	kid_u1
	.long	kid_u2
	.long	kid_u1
	.long	kid_u3

	.long	kid_d1
	.long	kid_d2
	.long	kid_d1
	.long	kid_d3
ikolkid_tablex

ikolsaved_table
	.long	one_k
	.long	two_k
	.long	three_k
	.long	four_k
	.long	five_k
ikolsaved_tablex


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	HULK SECTION
*

	;reg use
	; a0 - (in) # of hulks

 SUBRP	make_hulks

	move	a0,a0
	jrz	ijysdone

ijysanother_hulk
	PUSHP	a0

ijysget_pos
	movi	ijysmax_x-ijysmin_x,a0
	calla	RNDRNG0
	move	a0,a9
	movi	ijysmax_y-ijysmin_y,a0
	calla	RNDRNG0
	move	a0,a10

	addi	ijysmin_x,a9
	addi	ijysmin_y,a10

	cmpi	ijysmid_x1,a9
	jrle	ijysplace_hulk
	cmpi	ijysmid_x2,a9
	jrge	ijysplace_hulk
	cmpi	ijysmid_y1,a10
	jrle	ijysplace_hulk
	cmpi	ijysmid_y2,a10
	jrge	ijysplace_hulk
	jruc	ijysget_pos

ijysplace_hulk
	;assign a random starting position
	CREATE	HULK_PID,hulk
	PULLP	a0
	dsj	a0,ijysanother_hulk

ijysdone
	rets


ijysmin_x	equ	53	;hulk start outer boundaries
ijysmax_x	equ	347-13
ijysmin_y	equ	45
ijysmax_y	equ	231-16

ijysmid_x1	equ	200-50	;hulk start inner boundaries
ijysmid_x2	equ	200+50
ijysmid_y1	equ	138-50
ijysmid_y2	equ	138+50


*****************************************************************************
*
*	hulk process
*

	STRUCTPD
	LONG	fkorPD_SCRIPT	;UHL script head
	WORD	fkorPD_FRAME_NDX	;UHW frame index

	;reg use
	; a8 - object handle
	; a9 - (in)  starting x
	; a9 - (use) frame change count
	;a10 - (in)  starting y
	;a11 - direction of motion (0-3)

 SUBRP	hulk

	;choose a direction of motion
	movi	3,a0
	calla	RNDRNG0
	move	a0,a11

	X32	a0
	addi	fkoranim_list,a0
	move	*a0,a6,L
	move	a6,*a13(fkorPD_SCRIPT),L
	clr	a7
	move	a7,*a13(fkorPD_FRAME_NDX),W

	;create the hulk object
	move	a9,a0		;x pos
	sla	16,a0
	move	a10,a1		;y pos
	sla	16,a1

	move	a7,a14		;img
	X32	a14
	add	a6,a14
	move	*a14,a2,L

	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPHULK,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;set the move counter
	movi	fkormove_freq/2,a0
	calla	RNDRNG0
	addi	fkormove_freq,a0
	move	a0,a9

fkorloop
	SLEEPK	1
	dsj	a9,fkorloop
	callr	fkormove_hulk
	movi	fkormove_freq,a9
	jruc	fkorloop


fkorbeen_shot	;we immediately wake up here if we've been hit and moved
		; by a player bullet.
	callr	fkordo_bounds_check
	jruc	fkorloop

	DIE


******************************************************************************
*
*	hulk move routine
*

	;reg use
	; a0 scratch
	; a1 scratch
	; a8 object handle
	;a11 direction of motion (0-3)

 SUBRP	fkormove_hulk
	;move him
	move	a11,a14
	X32	a14
	addi	fkormove_table,a14
	move	*a14+,a0,W
	move	*a14,a1,W
	move	*a8(OXPOS),a14,W
	add	a0,a14
	move	a14,*a8(OXPOS),W
	move	*a8(OYPOS),a14,W
	add	a1,a14
	move	a14,*a8(OYPOS),W

	;
	;note the fall-through here
	;

	;bounds check
 SUBRP	fkordo_bounds_check
	clr	a1

	clr	a0
	move	*a8(OXPOS),a0,W
	cmpi	fkorlow_x,a0
	jrlt	fkortoo_left
	cmpi	fkorhigh_x,a0
	jrgt	fkortoo_right
	jruc	fkorvert_check

fkortoo_left
	movi	fkorlow_x,a14
	move	a14,*A8(OXPOS),W
	ori	M_HIT_LEFT,a1
	jruc	fkorvert_check

fkortoo_right
	movi	fkorhigh_x,a14
	move	a14,*A8(OXPOS),W
	ori	M_HIT_RIGHT,a1
;	jruc	fkorvert_check

fkorvert_check
	clr	a0
	move	*a8(OYPOS),a0,W
	cmpi	fkorlow_y,a0
	jrlt	fkortoo_high
	cmpi	fkorhigh_y,a0
	jrgt	fkortoo_low
	jruc	fkordone_boundcheck

fkortoo_high
	movi	fkorlow_y,a14
	move	a14,*A8(OYPOS),W
	ori	M_HIT_TOP,a1
	jruc	fkordone_boundcheck

fkortoo_low
	movi	fkorhigh_y,a14
	move	a14,*A8(OYPOS),W
	ori	M_HIT_BOTTOM,a1
	jruc	fkordone_boundcheck

fkordone_boundcheck
	move	a1,a1
	jrnz	fkorchange_direction

fkorno_wallhit
	movi	fkorturn_prob,a0
	PUSH	a1
	calla	RNDRNG0
	PULL	a1
	move	a0,a0
	jrnz	fkordone_moving

	;spontaneous direction change.  random for now
;	jruc	fkorchange_direction	;fall through

fkorchange_direction
	;turn 90 degrees by randomly incrementing or decrementing direction
	movi	1,a0
	PUSH	a1
	calla	RNDRNG0
	PULL	a1
	move	a0,a0
	jrz	fkorinc_direction
	dec	a11
	jruc	fkordir_rangecheck
	
fkorinc_direction
	inc	a11

fkordir_rangecheck
	cmpi	-1,a11
	jrne	fkordir_notlow
	movi	3,a11

fkordir_notlow
	cmpi	4,a11
	jrne	fkordir_changed
	clr	a11

fkordir_changed

	;verify that this is a good direction
	cmpi	0,a11
	jreq	fkorvalidate_up
	cmpi	1,a11
	jreq	fkorvalidate_right
	cmpi	2,a11
	jreq	fkorvalidate_down
	cmpi	3,a11
	jreq	fkorvalidate_left

fkorvalidate_up
	andi	M_HIT_TOP,a1
	jrnz	fkorchange_direction
	jruc	fkorvalid_dir
fkorvalidate_right
	andi	M_HIT_RIGHT,a1
	jrnz	fkorchange_direction
	jruc	fkorvalid_dir
fkorvalidate_down
	andi	M_HIT_BOTTOM,a1
	jrnz	fkorchange_direction
	jruc	fkorvalid_dir
fkorvalidate_left
	andi	M_HIT_LEFT,a1
	jrnz	fkorchange_direction
	jruc	fkorvalid_dir

fkorvalid_dir

	move	a11,a0
	X32	a0
	addi	fkoranim_list,a0
	move	*a0,a0,L
	move	a0,*a13(fkorPD_SCRIPT),L

fkordone_moving
	
fkornew_frame
	move	*a13(fkorPD_FRAME_NDX),a14,W
	move	*a13(fkorPD_SCRIPT),a6,L
	inc	a14
	cmpi	4,a14
	jrne	fkorno_wrap
	clr	a14
fkorno_wrap
	move	a14,*a13(fkorPD_FRAME_NDX),W
	X32	a14
	add	a6,a14
	move	*a14,a0,L
	calla	civanic

	rets


******************************************************************************
*
*	hulk collision routines
*

 SUBR	hulk_pushback
	PUSH	a1,a7,a9,a10,a11,a13

	;immediately move the hulk in the direction of the bullet's motion
	move	*a0(OXVEL),a14,L
	sra	17,a14
	move	*a8(OXPOS),a1,W
	add	a14,a1
	move	a1,*a8(OXPOS),W

	move	*a0(OYVEL),a14,L
	sra	17,a14
	move	*a8(OYPOS),a1,W
	add	a14,a1
	move	a1,*a8(OYPOS),W

	;wake up at the collision check
	move	*a8(OPLINK),a0,L
	move	*a0(PA9),a9,L
	move	*a0(PA10),a10,L
	move	*a0(PA11),a11,L
	movi	HULK_PID,a1
	movi	fkorbeen_shot,a7
	calla	XFERPROC
	PULL	a1,a7,a9,a10,a11,a13

	rets


******************************************************************************
*
*	hulk configuration data
*

fkorstep_x		equ	4
fkorstep_y		equ	4

fkorlow_x		equ	53	;hulk move boundaries
fkorhigh_x		equ	347-13
fkorlow_y		equ	45
fkorhigh_y		equ	231-16

fkormove_freq	equ	8	;frames between moves

fkorturn_prob	equ	30	;chance per frame of spontaneously changing
				;direction
fkormove_table
	.word	0,-fkorstep_y
	.word	fkorstep_x,0
	.word	0,fkorstep_y
	.word	-fkorstep_x,0
fkormove_tablex

fkoranim_list
	.long	fkoranim_vert
	.long	fkoranim_right
	.long	fkoranim_vert
	.long	fkoranim_left
fkoranim_listx

fkoranim_vert
	.long	hulk_ud1
	.long	hulk_ud2
	.long	hulk_ud1
	.long	hulk_ud3
fkoranim_vertx

fkoranim_left
	.long	hulk_l1
	.long	hulk_l2
	.long	hulk_l1
	.long	hulk_l3
fkoranim_leftx

fkoranim_right
	.long	hulk_r1
	.long	hulk_r2
	.long	hulk_r1
	.long	hulk_r3
fkoranim_rightx


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	SPHEREOID SECTION
*

	;reg use
	; a0 - (in) # of sphereoids

 SUBRP	make_sphereoids

	move	a0,a0
	jrz	istgdone

istganother_sphereoid
	PUSHP	a0

istgget_pos
	movi	istgmax_x-istgmin_x,a0
	calla	RNDRNG0
	move	a0,a9
	movi	istgmax_y-istgmin_y,a0
	calla	RNDRNG0
	move	a0,a10

	addi	istgmin_x,a9
	addi	istgmin_y,a10

	cmpi	istgmid_x1,a9
	jrle	istgplace_sphereoid
	cmpi	istgmid_x2,a9
	jrge	istgplace_sphereoid
	cmpi	istgmid_y1,a10
	jrle	istgplace_sphereoid
	cmpi	istgmid_y2,a10
	jrge	istgplace_sphereoid
	jruc	istgget_pos

istgplace_sphereoid
	;assign a random starting position
	CREATE	SPHEREOID_PID,sphereoid
	PULLP	a0
	dsj	a0,istganother_sphereoid

istgdone
	rets


istgmid_x1	equ	200-80	;sphereoid start inner boundaries
istgmid_x2	equ	200+80
istgmid_y1	equ	138-80
istgmid_y2	equ	138+80


*******************************************************************************
*
*	sphereoid process
*

	STRUCTPD
	LONG	istgOXACC		;UHL x acceleration
	LONG	istgOYACC		;UHL y acceleration
	WORD	istgOCHILDREN	;UHW # of children left to spawn
	WORD	istgOSTAGE		;UHW stage in life cycle

	;reg use
	; a7 (use) event timer (related to istgOSTAGE)
	; a8 (use) * object
	; a9 (in)  x pos
	; a9 (use) anim counter
	;a10 (in)  y pos
	;a10 (use) frame pointer
	;a11 (use) time until next vel change

 SUBRP	sphereoid

	;increment the badguy count
	move	@live_badguys,a14,W
	inc	a14
	move	a14,@live_badguys,W

	;create the sphereoid object
	move	a9,a0		;x pos
	sll	16,a0
	move	a10,a1		;y pos
	sll	16,a1
	movi	istgstandard_script,a10
	move	*a10+,a2,L	;img
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPSPHEREOID,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;initialize anim counter
	movi	istganim_speed,a9

	;set initial velocities and accelerations
	callr	istgset_va

	;initialize life cycle and event timer
	movi	istgSTAGE_YOUTH,a14
	move	a14,*a13(istgOSTAGE),W
	movi	istgyouth_time/2,a0
	calla	RNDRNG0
	addi	istgyouth_time*3/4,a0
	move	a0,a7

istgloop
	PUSHP	a7
	SLEEPK	1
	PULLP	a7
	dec	a9
	jrnz	istgno_anim

	;advance the frame
	move	*a10+,a0,L
	jrnz	istgnewframe

	;reset script.  depends on the stage
	move	*a13(istgOSTAGE),a14,W
	cmpi	istgSTAGE_PARENT,a14
	jreq	istgset_parent_script
	movi	istgstandard_script,a10
	jruc	istgscript_set
istgset_parent_script
	movi	istgparent_script,a10

istgscript_set
	move	*a10+,a0,L

istgnewframe
	calla	civanic

	;reset the counter
	movi	istganim_speed,a9

istgno_anim
	;adjust velocities
	callr	istgacc_add

	;bounds check
	callr	istgin_bounds

	;adjust vel and acc if it's time
	dec	a11
	jrnz	istgno_va_change
	callr	istgset_va

istgno_va_change

	;do event?
	dec	a7
	jrnz	istgno_event

	;event.  depends on the stage in the life cycle
	move	*a13(istgOSTAGE),a14,W
	cmpi	istgSTAGE_YOUTH,a14
	jreq	istgyouth_event
	cmpi	istgSTAGE_PARENT,a14
	jreq	istgparent_event
	;default
	jruc	istgdotage_event

istgyouth_event
	;switch to middle age
	movi	istgSTAGE_PARENT,a14
	move	a14,*a13(istgOSTAGE),W

	;set the number of kids to be spawned
	movi	istgmax_kids-istgmin_kids,a0
	calla	RNDRNG0
	addi	istgmin_kids,a0
	move	a0,*a13(istgOCHILDREN),W

	;set the spawn timer
	movi	istgspawn_time/2,a0
	calla	RNDRNG0
	addi	istgspawn_time*3/4,a0
	move	a0,a7
	jruc	istgno_event

istgparent_event
	;spawn a brat
	PUSHP	a10,a11
	move	*a8(OXVAL),a10,L
	move	*a8(OYVAL),a11,L
	CREATE	ENFORCER_PID,enforcer
	PULLP	a10,a11

	;decrement the kid count
	move	*a13(istgOCHILDREN),a14,W
	dec	a14
	jrz	istgbarren
	move	a14,*a13(istgOCHILDREN),W
	movi	istgspawn_time/2,a0
	calla	RNDRNG0
	addi	istgspawn_time*3/4,a0
	move	a0,a7
	jruc	istgno_event

istgbarren
	;that was the last kid.  age
	movi	istgSTAGE_DOTAGE,a14
	move	a14,*a13(istgOSTAGE),W
	movi	istgold_age_time,a7
	jruc	istgno_event

istgdotage_event
	;nothing fancy.  just die.
	jruc	istgdie_peacefully
	
istgno_event
	jruc	istgloop

istgbeen_shot
	;crud.  we've been shot.  score the points
	movi	istgsphereoid_points,a0
	callr	score_points

	;decrement the badguy count
	move	@live_badguys,a14,W
	dec	a14
	move	a14,@live_badguys,W

	;clear the velocity
	clr	a14
	move	a14,*a8(OXVEL),L
	move	a14,*a8(OYVEL),L

	;go through the death routine
	movi	istgparent_script,a10,L
	move	*a8(OCTRL),a14,W
	xori	DMAWNZ,a14
	ori	DMACNZ,a14
	move	a14,*a8(OCTRL),W
	movi	istgdiecolor,a14
	move	a14,*a8(OCONST),W
	movi	robo_p,a0
	calla	pal_getf
	move	a0,*a8(OPAL),W

istgdie_loop
	SLEEPK	istganim_speed
	move	*a10+,a0,L
	jrz	istgscore_msg
	calla	civanic
	jruc	istgdie_loop

istgscore_msg
	movi	istgscore_image,a0
	move	*a8(OCTRL),a1,W
	xori	DMACNZ,a1
	ori	DMAWNZ,a1
	calla	civani
	movi	istgscore_xoff,a14
	move	a14,*a8(ODXOFF),W
	movi	istgscore_yoff,a14	
	move	a14,*a8(ODYOFF),W
	SLEEP	istgscore_time
	jruc	istgexpire

istgdie_peacefully
	;decrement the badguy count
	move	@live_badguys,a14,W
	dec	a14
	move	a14,@live_badguys,W

istgexpire
	calla	DELOBJA8

	DIE


 SUBRP	istgset_va

	movi	istghigh_v*2,a0
	calla	RNDRNG0
	subi	istghigh_v,a0
	move	a0,*a8(OXVEL),L

	movi	istghigh_v*2,a0
	calla	RNDRNG0
	subi	istghigh_v,a0
	move	a0,*a8(OYVEL),L

	movi	istghigh_a*2,a0
	calla	RNDRNG0
	subi	istghigh_a,a0
	move	a0,*a13(istgOXACC),L

	movi	istghigh_a*2,a0
	calla	RNDRNG0
	subi	istghigh_a,a0
	move	a0,*a13(istgOYACC),L

	movi	istgva_change_time,a0
	calla	RNDRNG0
	inc	a0
	move	a0,a11

	rets


 SUBRP	istgacc_add
	move	*a13(istgOXACC),a14,L
	move	*a8(OXVEL),a0,L
	add	a14,a0
	move	a0,*a8(OXVEL),L

	move	*a13(istgOYACC),a14,L
	move	*a8(OYVEL),a0,L
	add	a14,a0
	move	a0,*a8(OYVEL),L

	rets


 SUBRP	istgin_bounds

	move	*a8(OXPOS),a14,W
	movi	istgmin_x,a0
	cmp	a0,a14
	jrlt	istgx_adjust

	movi	istgmax_x,a0
	cmp	a0,a14
	jrgt	istgx_adjust
	jruc	istgy_check

istgx_adjust
	move	a0,*a8(OXPOS),W
	clr	a0
	move	a0,*a8(OXVEL),L
	move	a0,*a13(istgOXACC),L

istgy_check
	move	*a8(OYPOS),a14,W
	movi	istgmin_y,a0
	cmp	a0,a14
	jrlt	istgy_adjust

	movi	istgmax_y,a0
	cmp	a0,a14
	jrgt	istgy_adjust
	jruc	istgdone_check

istgy_adjust
	move	a0,*a8(OYPOS),W
	clr	a0
	move	a0,*a8(OYVEL),L
	move	a0,*a13(istgOYACC),L

istgdone_check
	rets


******************************************************************************
*
*	sphereoid collision routines
*

 SUBR	sphereoid_die
	PUSH	a1,a7

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	DEADSPHERE_PID,a1
	movi	istgbeen_shot,a7
	calla	XFERPROC

	PULL	a1,a7
	rets


******************************************************************************
*
*	sphereoid configuration data
*

istganim_speed	equ	3

istgva_change_time	equ	180

istgsphereoid_points	equ	1000

istgyouth_time	equ	180	;time before we have kids
istgspawn_time	equ	120	;time between kids
istgold_age_time	equ	180	;time between last kid and natural death

istgmin_kids	equ	3	;lower limit on spawned enforcers
istgmax_kids	equ	7	;upper limit

istghigh_v		equ	00004000h
istghigh_a		equ	00000C00h

istgmin_x	equ	53	;sphereoid move bounds
istgmax_x	equ	347-15
istgmin_y	equ	45
istgmax_y	equ	231-15

istgscore_image	equ	one_k	;image on being shot
istgdiecolor	equ	0909h	;color on being shot
istgscore_time	equ	60	;time to display score value
istgscore_xoff	equ	-3	;shotimage offset
istgscore_yoff	equ	-5

;life cycle stages
istgSTAGE_YOUTH 	equ	0000h
istgSTAGE_PARENT	equ	0001h
istgSTAGE_DOTAGE	equ	0002h

istgstandard_script
	.long	circle_1
	.long	circle_2
	.long	circle_3
	.long	circle_4
	.long	circle_5
	.long	0

istgparent_script
	.long	circle_1
	.long	circle_2
	.long	circle_3
	.long	circle_4
	.long	circle_5
	.long	circle_6
	.long	circle_7
	.long	circle_8
	.long	0


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	ENFORCER SECTION
*

	.bss	num_enforcers,		16	;active enforcers
	.bss	picket_duty,		32	;*img of picket enforcer

	;reg use
	;  a8 (use) *img
	;  a9 (use) next move timer (move/fire phase)
	;  a9 (use) frame pointer (death phase)
	; a10 (in)  initial X
	; a10 (use) frame pointer (grow phase)
	; a11 (in)  initial Y
	; a11 (use) next shot timer (move/fire phase)

 SUBRP	enforcer

	;increment the badguy count
	move	@live_badguys,a14,W
	inc	a14
	move	a14,@live_badguys,W
	move	@num_enforcers,a14,W
	inc	a14
	move	a14,@num_enforcers,W

	;create the enforcer object
	move	a10,a0
	move	a11,a1
	movi	qtjqgrow_script,a10
	move	*a10+,a2,L
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPENFORCER,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;grow phase

qtjqgrow_loop
	SLEEPK	qtjqgrow_speed
	move	*a10+,a0,L
	jrz	qtjqmf_phase
	calla	civanic
	jruc	qtjqgrow_loop

qtjqmf_phase
	;begin move/fire phase.  set initial course
	callr	qtjqnew_course
	movi	qtjqturn_time,a9
	movi	qtjqfire_time/2,a0
	calla	RNDRNG0
	addi	qtjqfire_time*3/4,a0
	move	a0,a11

qtjqmain_loop
	SLEEPK	1
	dec	a9
	jrnz	qtjqno_turn


	;picket phase
	;two cases: we're on picket duty, or we're not.
	move	@picket_duty,a14,L
	cmp	a14,a8
	jreq	qtjqon_picket

	;we're not on picket duty
	;if we're the only enforcer, quit now.
	move	@num_enforcers,a14,W
	cmpi	1,a14
	jreq	qtjqpicket_done

	;there are multiple enforcers.   If there is no picket, see if we
	; take the job.  If there is, quit.
	move	@picket_duty,a14,L
	jrnz	qtjqpicket_done

	;there is no picket.
	movi	qtjqpicket_prob,a0
	calla	RNDRNG0
	move	a0,a0
	jrnz	qtjqpicket_done

	;we're going to take picket duty
	move	a8,@picket_duty,L
	jruc	qtjqpicket_done

qtjqon_picket
	;we are on picket duty
	;if we're the only enforcer, see if we leave picket mode.
	move	@num_enforcers,a14,W
	cmpi	1,a14
	jrne	qtjqmultiple_enforcers

	;we're the only enforcer
	movi	qtjqstand_down_prob,a0
	calla	RNDRNG0
	move	a0,a0
	jrnz	qtjqpicket_done

	;and we've decided to stand down.
;	clr	a0	;unneccesary.  it's already 0 from above.
	move	a0,@picket_duty,L
	jruc	qtjqpicket_done

qtjqmultiple_enforcers
	;we may abandon our post
	movi	qtjqabandon_post_prob,a0
	calla	RNDRNG0
	move	a0,a0
	jrnz	qtjqpicket_done

	;yep.  we quit.
;	clr	a0	;unneccesary.  it's already 0 from above.
	move	a0,@picket_duty,L
;	jruc	qtjqpicket_done

qtjqpicket_done

	;change course
	callr	qtjqnew_course
	movi	qtjqturn_time,a9

qtjqno_turn

	dec	a11
	jrnz	qtjqno_shot

	;fire a spark
	PUSHP	a10
	move	*a8(OXVAL),a10,L
	move	*a8(OYVAL),a11,L
	CREATE	SPARK_PID,spark
	PULLP	a10
	movi	qtjqfire_time/2,a0
	calla	RNDRNG0
	addi	qtjqfire_time*3/4,a0
	move	a0,a11

qtjqno_shot

	;bounds check
	callr	qtjqin_bounds

	jruc	qtjqmain_loop

qtjqdie
	;decrement the badguy count
	move	@live_badguys,a14,W
	dec	a14
	move	a14,@live_badguys,W
	move	@num_enforcers,a14,W
	dec	a14
	move	a14,@num_enforcers,W

	;zero our velocity
	clr	a14
	move	a14,*a8(OXVEL),L
	move	a14,*a8(OYVEL),L

	;set up the animation
qtjqdieloop
	move	*a9+,a0,L
	jrz	qtjqdead_n_buried
	calla	civanic
	sleepk	qtjqdeath_speed
	jruc	qtjqdieloop

qtjqdead_n_buried
	calla	DELOBJA8

	DIE


 SUBRP	qtjqnew_course

	;two cases.  picket or !picket
	move	@picket_duty,a14,L
	cmp	a8,a14
	jrne	qtjqnc_notpicket

qtjqnc_picket
	;we're on picket duty.  if we're not against a wall, move toward the
	; nearest one.  if we are against a wall but not in a corner, move
	; toward the nearest corner.  if we're in a corner, sit tight.
;	jruc	qtjqnc_done

qtjqnc_notpicket
	;velocity is the distance between enforcer and player / 64 / 2
	move	@player_object,a0,L
	move	*a0(OXVAL),a14,L
	move	*a8(OXVAL),a1,L
	sub	a1,a14
	sra	7,a14
	
	move	a14,*a8(OXVEL),L

	move	*a0(OYVAL),a14,L
	move	*a8(OYVAL),a1,L
	sub	a1,a14
	sra	7,a14
	move	a14,*a8(OYVEL),L

qtjqnc_done
	rets

 SUBRP	qtjqin_bounds

	move	*a8(OXPOS),a14,W
	movi	qtjqmin_x,a0
	cmp	a0,a14
	jrlt	qtjqx_adjust

	movi	qtjqmax_x,a0
	cmp	a0,a14
	jrgt	qtjqx_adjust
	jruc	qtjqy_check

qtjqx_adjust
	move	a0,*a8(OXPOS),W
	clr	a0
	move	a0,*a8(OXVEL),L

qtjqy_check
	move	*a8(OYPOS),a14,W
	movi	qtjqmin_y,a0
	cmp	a0,a14
	jrlt	qtjqy_adjust

	movi	qtjqmax_y,a0
	cmp	a0,a14
	jrgt	qtjqy_adjust
	jruc	qtjqdone_check

qtjqy_adjust
	move	a0,*a8(OYPOS),W
	clr	a0
	move	a0,*a8(OYVEL),L

qtjqdone_check
	rets


******************************************************************************
*
*	enforcer collision routines
*

 SUBR	enforcer_die
	;hit by player gunfire
	PUSH	a1,a7

	;jeepers.  we're dead.
	movi	CLSDEAD,a14
	move	a14,*a8(OID),W

	move	*a0(OXVEL),a14,L
	jrz	qtjqvert_bullet
	move	*a0(OYVEL),a1,L
	jrz	qtjqhorz_bullet

	add	a1,a14
	jrz	qtjqdiag_13
	jruc	qtjqdiag_24

qtjqhorz_bullet
	movi	qtjqdie_vert,a9
	jruc	qtjqdeath_set
qtjqvert_bullet
	movi	qtjqdie_horz,a9
	jruc	qtjqdeath_set
qtjqdiag_13
	movi	qtjqdie_diag24,a9
	jruc	qtjqdeath_set
qtjqdiag_24
	movi	qtjqdie_diag13,a9
	jruc	qtjqdeath_set

qtjqdeath_set
	move	*a8(OPLINK),a0,L
	movi	DEADNFORCER_PID,a1
	movi	qtjqdie,a7
	move	*a0(PA10),a10,L
	calla	XFERPROC

	movi	qtjqenforcer_points,a0
	callr	score_points

	PULL	a1,a7
	rets


******************************************************************************
*
*	enforcer configuration data
*

qtjqenforcer_points	equ	100

qtjqpicket_prob	equ	4	;one chance in X of becoming the picket if
				; there are multiple enforcers and none is
				; on the job already.

qtjqstand_down_prob equ	4	;one chance in X of leaving picket duty if
				; we're the only enforcer left.

qtjqabandon_post_prob equ	8	;one chance in X of leaving picket duty if
				; there are other enforcers around.

qtjqturn_time	equ	150
qtjqfire_time	equ	90

qtjqgrow_speed	equ	6

qtjqmin_x	equ	53	;enforcer move bounds
qtjqmax_x	equ	347-9
qtjqmin_y	equ	45
qtjqmax_y	equ	231-11

qtjqgrow_script
	.long	enf_g1
	.long	enf_g2
	.long	enf_g3
	.long	enf_g4
	.long	enf_g5
	.long	enf_1
	.long	0
qtjqgrow_scriptx

qtjqdie_vert
	.long	enf_xv1
	.long	enf_xv2
	.long	enf_xv3
	.long	enf_xv4
	.long	enf_xv5
	.long	0
qtjqdie_vertx

qtjqdie_horz
	.long	enf_xh1
	.long	enf_xh2
	.long	enf_xh3
	.long	enf_xh4
	.long	0
qtjqdie_horzx

qtjqdie_diag13
	.long	enf_xf1
	.long	enf_xf2
	.long	enf_xf3
	.long	enf_xf4
	.long	0
qtjqdie_diag13x

qtjqdie_diag24
	.long	enf_xb1
	.long	enf_xb2
	.long	enf_xb3
	.long	enf_xb4
	.long	0
qtjqdie_diag24x

qtjqdeath_speed	equ	3		;death seq anim speed


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	SPARK SECTION
*

	;reg use
	;  a6 (use) x acc
	;  a7 (use) y acc
	;  a8 (use) *image
	;  a9 (use) anim timer
	; a10 (in)  initial X
	; a10 (use) anim pointer
	; a11 (in)  initial Y
	; a11 (use) life timer

 SUBRP	spark

	;create a spark object
	move	a10,a0
	move	a11,a1

	movi	pohgscript,a10
	move	*a10+,a2,L
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPSPARK,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;set the initial velocity.
	move	@player_object,a0,L
	move	*a0(OXVAL),a1,L
	move	*a8(OXVAL),a2,L
	sub	a2,a1
	sra	5,a1
	move	a1,*a8(OXVEL),L

	move	*a0(OYVAL),a1,L
	move	*a8(OYVAL),a2,L
	sub	a2,a1
	sra	5,a1
	move	a1,*a8(OYVEL),L

	;and then add a little 'spin' by giving them some acceleration
	movi	pohghigh_acc*2,a0
	calla	RNDRNG0
	subi	pohghigh_acc,a0
	move	a0,a6
	movi	pohghigh_acc*2,a0
	calla	RNDRNG0
	subi	pohghigh_acc,a0
	move	a0,a7

	movi	pohganim_time,a9
	movi	pohglife_time,a11

pohgloop
	PUSHP	a6,a7
	SLEEPK	1
	PULLP	a6,a7

	;bounds check
	callr	pohgin_bounds

	;apply accelerations
	move	*a8(OXVEL),a14,L
	add	a6,a14
	move	a14,*a8(OXVEL),L

	move	*a8(OYVEL),a14,L
	add	a7,a14
	move	a14,*a8(OYVEL),L

	dec	a9
	jrnz	pohgno_anim

	move	*a10+,a0,L
	jrnz	pohgno_wrap
	movi	pohgscript,a10
	move	*a10+,a0,L
pohgno_wrap
	calla	civanic
	movi	pohganim_time,a9

pohgno_anim
	dec	a11
	jrz	pohgexpire
	jruc	pohgloop

pohgexpire
	calla	DELOBJA8

	DIE


 SUBRP	pohgin_bounds

	move	*a8(OXPOS),a14,W
	movi	pohgmin_x,a0
	cmp	a0,a14
	jrlt	pohgx_adjust

	movi	pohgmax_x,a0
	cmp	a0,a14
	jrgt	pohgx_adjust
	jruc	pohgy_check

pohgx_adjust
	move	a0,*a8(OXPOS),W
	clr	a6
	move	a6,*a8(OXVEL),L

pohgy_check
	move	*a8(OYPOS),a14,W
	movi	pohgmin_y,a0
	cmp	a0,a14
	jrlt	pohgy_adjust

	movi	pohgmax_y,a0
	cmp	a0,a14
	jrgt	pohgy_adjust
	jruc	pohgdone_check

pohgy_adjust
	move	a0,*a8(OYPOS),W
	clr	a7
	move	a7,*a8(OYVEL),L

pohgdone_check
	rets


******************************************************************************
*
*	spark collision routines
*

 SUBR	spark_die
	PUSH	a1,a7

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	DEADSPARK_PID,a1
	movi	pohgexpire,a7
	calla	XFERPROC

	PULL	a1,a7
	rets


******************************************************************************
*
*	spark configuration data
*

pohglife_time	equ	180		;how long they last
pohganim_time	equ	3		;frame rate

pohghigh_acc	equ	00000200h	;top acceleration

pohgmin_x	equ	53	;spark move bounds
pohgmax_x	equ	347-7
pohgmin_y	equ	45
pohgmax_y	equ	231-7

pohgscript
	.long	spark_1
	.long	spark_2
	.long	spark_3
	.long	spark_4
	.long	0


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	QUARK SECTION
*

	;reg use
	; a0 - (in) # of quarks

 SUBRP	make_quarks

	move	a0,a0
	jrz	vwpndone

vwpnanother_quark
	PUSHP	a0

vwpnget_pos
	;assign a random starting position
	movi	vwpnmax_x-vwpnmin_x,a0
	calla	RNDRNG0
	move	a0,a9
	movi	vwpnmax_y-vwpnmin_y,a0
	calla	RNDRNG0
	move	a0,a10

	addi	vwpnmin_x,a9
	addi	vwpnmin_y,a10

	cmpi	vwpnmid_x1,a9
	jrle	vwpnplace_quark
	cmpi	vwpnmid_x2,a9
	jrge	vwpnplace_quark
	cmpi	vwpnmid_y1,a10
	jrle	vwpnplace_quark
	cmpi	vwpnmid_y2,a10
	jrge	vwpnplace_quark
	jruc	vwpnget_pos

vwpnplace_quark
	CREATE	QUARK_PID,quark
	PULLP	a0
	dsj	a0,vwpnanother_quark

vwpndone
	rets


vwpnmid_x1	equ	200-60	;quark start inner boundaries
vwpnmid_x2	equ	200+60
vwpnmid_y1	equ	138-60
vwpnmid_y2	equ	138+60


*******************************************************************************
*
*	quark process
*

	STRUCTPD
	WORD	vwpnOCHILDREN	;UHW # of children left to spawn
	WORD	vwpnOSTAGE		;UHW stage in life cycle

	;reg use
	; a7 (use) event timer (related to vwpnOSTAGE)
	; a8 (use) * object
	; a9 (in)  x pos
	; a9 (use) anim counter
	;a10 (in)  y pos
	;a10 (use) frame pointer
	;a11 (use) time until next vel change

 SUBRP	quark

	;increment the badguy count
	move	@live_badguys,a14,W
	inc	a14
	move	a14,@live_badguys,W

	;create the quark object
	move	a9,a0		;x pos
	sll	16,a0
	move	a10,a1		;y pos
	sll	16,a1
	movi	vwpnstandard_script,a10
	move	*a10+,a2,L	;img
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPQUARK,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;initialize anim counter
	movi	vwpnanim_speed,a9

	;set initial velocities and accelerations
	callr	vwpnset_v

	;initialize life cycle and event timer
	movi	vwpnSTAGE_YOUTH,a14
	move	a14,*a13(vwpnOSTAGE),W
	movi	vwpnyouth_time,a7

vwpnloop
	PUSHP	a7
	SLEEPK	1
	PULLP	a7
	dec	a9
	jrnz	vwpnno_anim

	;advance the frame
	move	*a10+,a0,L
	jrnz	vwpnnewframe

	;reset script.  depends on the stage
	move	*a13(vwpnOSTAGE),a14,W
	cmpi	vwpnSTAGE_PARENT,a14
	jreq	vwpnset_parent_script
	movi	vwpnstandard_script,a10
	jruc	vwpnscript_set
vwpnset_parent_script
	movi	vwpnparent_script,a10

vwpnscript_set
	move	*a10+,a0,L

vwpnnewframe
	calla	civanic

	;reset the counter
	movi	vwpnanim_speed,a9

vwpnno_anim
	;bounds check
	callr	vwpnin_bounds

	;adjust vel if it's time
	dec	a11
	jrnz	vwpnno_v_change
	callr	vwpnset_v

vwpnno_v_change

	;do event?
	dec	a7
	jrnz	vwpnno_event

	;event.  depends on the stage in the life cycle
	move	*a13(vwpnOSTAGE),a14
	cmpi	vwpnSTAGE_YOUTH,a14
	jreq	vwpnyouth_event
	cmpi	vwpnSTAGE_PARENT,a14
	jreq	vwpnparent_event
	;default
	jruc	vwpndotage_event

vwpnyouth_event
	;switch to middle age
	movi	vwpnSTAGE_PARENT,a14
	move	a14,*a13(vwpnOSTAGE),W

	;set the number of kids to be spawned
	movi	vwpnmax_kids-vwpnmin_kids,a0
	calla	RNDRNG0
	addi	vwpnmin_kids,a0
	move	a0,*a13(vwpnOCHILDREN),W

	;set the spawn timer
	movi	vwpnspawn_time,a7
	jruc	vwpnno_event

vwpnparent_event
	;spawn a brat
	PUSHP	a10,a11
	move	*a8(OXVAL),a10,L
	move	*a8(OYVAL),a11,L
	CREATE	TANK_PID,tank
	PULLP	a10,a11

	;decrement the kid count
	move	*a13(vwpnOCHILDREN),a14,W
	dec	a14
	jrz	vwpnbarren
	move	a14,*a13(vwpnOCHILDREN),W
	movi	vwpnspawn_time,a7
	jruc	vwpnno_event

vwpnbarren
	;that was the last kid.  age
	movi	vwpnSTAGE_DOTAGE,a14
	move	a14,*a13(vwpnOSTAGE),W
	movi	vwpnold_age_time,a7
	jruc	vwpnno_event

vwpndotage_event
	;nothing fancy.  just die.
	jruc	vwpndie_peacefully
	
vwpnno_event
	jruc	vwpnloop


vwpnbeen_shot
	;crud.  we've been shot

vwpndie_peacefully

	;decrement the badguy count
	move	@live_badguys,a14,W
	dec	a14
	move	a14,@live_badguys,W

	calla	DELOBJA8

	DIE


 SUBRP	vwpnset_v

	movi	vwpnhigh_v,a0
	calla	RNDRNG0
	cmpi	vwpnhigh_v/2,a0
	jrgt	vwpnpositive_x

	subi	vwpnhigh_v,a0

vwpnpositive_x
	move	a0,*a8(OXVEL),L

	movi	vwpnhigh_v,a0
	calla	RNDRNG0
	cmpi	vwpnhigh_v/2,a0
	jrgt	vwpnpositive_y

	subi	vwpnhigh_v,a0

vwpnpositive_y
	move	a0,*a8(OYVEL),L

	movi	vwpnv_change_time/2,a0
	calla	RNDRNG0
	addi	vwpnv_change_time/2,a0
	move	a0,a11

	rets


 SUBRP	vwpnin_bounds

	move	*a8(OXPOS),a1,W
	movi	vwpnmin_x,a0
	move	*a8(ODXOFF),a14,W
	add	a14,a0
	cmp	a0,a1
	jrlt	vwpnx_adjust

	move	*a8(OSIZEX),a0,W
	neg	a0
	move	*a8(ODXOFF),a14,W
	add	a14,a0
	addi	vwpnmax_x,a0
	cmp	a0,a1
	jrgt	vwpnx_adjust
	jruc	vwpny_check

vwpnx_adjust
	move	a0,*a8(OXPOS),W
	move	*a8(OXVEL),a0,L
	neg	a0
	move	a0,*a8(OXVEL),L

vwpny_check
	move	*a8(OYPOS),a1,W
	movi	vwpnmin_y,a0
	move	*a8(ODYOFF),a14,W
	add	a14,a0
	cmp	a0,a1
	jrlt	vwpny_adjust

	move	*a8(OSIZEY),a0,W
	neg	a0
	move	*a8(ODYOFF),a14,W
	add	a14,a0
	addi	vwpnmax_y,a0
	cmp	a0,a1
	jrgt	vwpny_adjust
	jruc	vwpndone_check

vwpny_adjust
	move	a0,*a8(OYPOS),W
	move	*a8(OYVEL),a0,L
	neg	a0
	move	a0,*a8(OYVEL),L

vwpndone_check
	rets


******************************************************************************
*
*	quark collision routines
*

 SUBR	quark_die
	PUSH	a1,a7

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	DEADQUARK_PID,a1
	movi	vwpnbeen_shot,a7
	calla	XFERPROC

	PULL	a1,a7
	rets


******************************************************************************
*
*	quark configuration data
*

vwpnanim_speed	equ	3

vwpnv_change_time	equ	600	;time between random course changes

vwpnyouth_time	equ	90	;time before we have kids
vwpnspawn_time	equ	90	;time between kids
vwpnold_age_time	equ	120	;time between last kid and natural death

vwpnmin_kids	equ	3	;lower limit on spawned tanks
vwpnmax_kids	equ	7	;upper limit

vwpnhigh_v		equ	0001C000h

vwpnmin_x	equ	53	;quark move bounds
vwpnmax_x	equ	347-0
vwpnmin_y	equ	45
vwpnmax_y	equ	231-0

;life cycle stages
vwpnSTAGE_YOUTH 	equ	0000h
vwpnSTAGE_PARENT	equ	0001h
vwpnSTAGE_DOTAGE	equ	0002h

vwpnstandard_script
	.long	quark_1
	.long	quark_1
	.long	quark_2
	.long	quark_3
	.long	quark_4
	.long	0

vwpnparent_script
	.long	quark_1
	.long	quark_2
	.long	quark_3
	.long	quark_4
	.long	quark_5
	.long	quark_6
	.long	quark_7
	.long	quark_8
	.long	0


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	TANK SECTION
*

	STRUCTPD
	WORD	nzdzOSHOTS		;UHW shots left to be fired

	;reg use
	;  a7 (use) anim timer
	;  a8 (use) *img
	;  a9 (use) next move timer (move/fire phase)
	;  a9 (use) frame pointer (death phase)
	; a10 (in)  initial X
	; a10 (use) frame pointer (grow + move/fire phases)
	; a11 (in)  initial Y
	; a11 (use) next shot timer (move/fire phase)

 SUBRP	tank

	;increment the badguy count
	move	@live_badguys,a14,W
	inc	a14
	move	a14,@live_badguys,W

	;create the tank object
	move	a10,a0
	move	a11,a1
	movi	nzdzgrow_script,a10
	move	*a10+,a2,L
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPTANK,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;grow phase

nzdzgrow_loop
	SLEEPK	nzdzgrow_speed
	move	*a10+,a0,L
	jrz	nzdzmf_phase
	calla	civanic
	jruc	nzdzgrow_loop

nzdzmf_phase
	;begin move/fire phase.  set initial course
	callr	nzdzset_v
	movi	nzdzanim_time,a7
	movi	nzdzright_script,a10
	movi	nzdzfire_time/2,a0
	calla	RNDRNG0
	addi	nzdzfire_time*3/4,a0
	move	a0,a11
	movi	nzdznum_shots,a14
	move	a14,*a13(nzdzOSHOTS),W

nzdzmain_loop
	PUSHP	a7
	SLEEPK	1
	PULLP	a7
	dec	a9
	jrnz	nzdzno_turn

	;change course
	callr	nzdzset_v

nzdzno_turn

	dec	a11
	jrnz	nzdzno_shot

	move	*a13(nzdzOSHOTS),a14,W
	jrz	nzdzno_shot

	;fire a shell
	PUSHP	a7,a10,a11
	move	*a8(OXVAL),a10,L
	move	*a8(OYVAL),a11,L
	create	SHELL_PID,tank_shell
	PULLP	a7,a10,a11
	movi	nzdzfire_time/2,a0
	calla	RNDRNG0
	addi	nzdzfire_time*3/4,a0
	move	a0,a11

nzdzno_shot

	;bounds check
	callr	nzdzin_bounds

	;animate?
	dec	a7
	jrnz	nzdzno_anim
	move	*a10+,a0,L
	jrnz	nzdzno_wrap
	movi	nzdzright_script,a10
	move	*a10+,a0,L

nzdzno_wrap
	calla	civanic
	movi	nzdzanim_time,a7

nzdzno_anim
	jruc	nzdzmain_loop

nzdzdie
	;decrement the badguy count
	move	@live_badguys,a14,W
	dec	a14
	move	a14,@live_badguys,W

	;zero our velocity
	clr	a14
	move	a14,*a8(OXVEL),L
	move	a14,*a8(OYVEL),L

	;set up the animation
nzdzdieloop
	move	*a9+,a0,L
	jrz	nzdzdead_n_buried
	calla	civanic
	sleepk	nzdzdeath_speed
	jruc	nzdzdieloop

nzdzdead_n_buried
	calla	DELOBJA8

	DIE


 SUBRP	nzdzset_v

	movi	nzdzhigh_v,a0
	calla	RNDRNG0
	cmpi	nzdzhigh_v/2,a0
	jrgt	nzdzpositive_x

	subi	nzdzhigh_v,a0

nzdzpositive_x
	move	a0,*a8(OXVEL),L

	movi	nzdzhigh_v,a0
	calla	RNDRNG0
	cmpi	nzdzhigh_v/2,a0
	jrgt	nzdzpositive_y

	subi	nzdzhigh_v,a0

nzdzpositive_y
	move	a0,*a8(OYVEL),L

	movi	nzdzv_change_time/2,a0
	calla	RNDRNG0
	addi	nzdzv_change_time/2,a0
	move	a0,a9

	rets


 SUBRP	nzdzin_bounds

	move	*a8(OXPOS),a14,W
	movi	nzdzmin_x,a0
	cmp	a0,a14
	jrlt	nzdzx_adjust

	movi	nzdzmax_x,a0
	cmp	a0,a14
	jrgt	nzdzx_adjust
	jruc	nzdzy_check

nzdzx_adjust
	move	a0,*a8(OXPOS),W
	move	*a8(OXVEL),a0,L
	neg	a0
	move	a0,*a8(OXVEL),L

nzdzy_check
	move	*a8(OYPOS),a14,W
	movi	nzdzmin_y,a0
	cmp	a0,a14
	jrlt	nzdzy_adjust

	movi	nzdzmax_y,a0
	cmp	a0,a14
	jrgt	nzdzy_adjust
	jruc	nzdzdone_check

nzdzy_adjust
	move	a0,*a8(OYPOS),W
	move	*a8(OYVEL),a0,L
	neg	a0
	move	a0,*a8(OYVEL),L

nzdzdone_check
	rets


******************************************************************************
*
*	tank collision routines
*

 SUBR	tank_die
	;hit by player gunfire
	PUSH	a1,a7

	;jeepers.  we're dead.
	movi	CLSDEAD,a14
	move	a14,*a8(OID),W

	move	*a0(OXVEL),a14,L
	jrz	nzdzvert_bullet
	move	*a0(OYVEL),a1,L
	jrz	nzdzhorz_bullet

	add	a1,a14
	jrz	nzdzdiag_13
	jruc	nzdzdiag_24

nzdzhorz_bullet
	movi	nzdzdie_vert,a9
	jruc	nzdzdeath_set
nzdzvert_bullet
	movi	nzdzdie_horz,a9
	jruc	nzdzdeath_set
nzdzdiag_13
	movi	nzdzdie_diag24,a9
	jruc	nzdzdeath_set
nzdzdiag_24
	movi	nzdzdie_diag13,a9
	jruc	nzdzdeath_set

nzdzdeath_set
	move	*a8(OPLINK),a0,L
	movi	DEADTANK_PID,a1
	movi	nzdzdie,a7
	move	*a0(PA10),a10,L
	calla	XFERPROC

	movi	nzdztank_points,a0
	callr	score_points

	PULL	a1,a7
	rets


******************************************************************************
*
*	tank configuration data
*

nzdztank_points	equ	200

nzdznum_shots	equ	21

nzdzv_change_time	equ	250
nzdzfire_time	equ	90

nzdzhigh_v		equ	00010000h

nzdzgrow_speed	equ	6
nzdzanim_time	equ	2

nzdzmin_x	equ	53	;tank move bounds
nzdzmax_x	equ	347-13
nzdzmin_y	equ	45
nzdzmax_y	equ	231-16

nzdzgrow_script
	.long	tank_g1
	.long	tank_g2
	.long	tank_g3
	.long	tank_g4
	.long	tank_1
	.long	0

nzdzright_script
	.long	tank_1
	.long	tank_2
	.long	tank_3
	.long	tank_4
	.long	0

nzdzdie_vert
	.long	enf_xv1
	.long	enf_xv2
	.long	enf_xv3
	.long	enf_xv4
	.long	enf_xv5
	.long	0

nzdzdie_horz
	.long	enf_xh1
	.long	enf_xh2
	.long	enf_xh3
	.long	enf_xh4
	.long	0

nzdzdie_diag13
	.long	enf_xf1
	.long	enf_xf2
	.long	enf_xf3
	.long	enf_xf4
	.long	0

nzdzdie_diag24
	.long	enf_xb1
	.long	enf_xb2
	.long	enf_xb3
	.long	enf_xb4
	.long	0

nzdzdeath_speed	equ	3		;death seq anim speed


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	SHELL SECTION
*

	;reg use
	;  a8 (use) *image
	; a10 (in)  initial X
	; a11 (in)  initial Y
	; a11 (use) life timer

 SUBRP	tank_shell

	;create a shell object
	move	a10,a0
	move	a11,a1
	movi	shell,a2
	clr	a3
	movi	DMAWNZ,a4
	movi	CLSENMY|TYPSHELL,a5
	clr	a6
	clr	a7
	calla	BEGINOBJW

	;set the initial velocity.
	move	@player_object,a0,L
	move	*a0(OXVAL),a1,L
	move	*a8(OXVAL),a2,L
	sub	a2,a1
	sra	5,a1
	move	a1,*a8(OXVEL),L

	move	*a0(OYVAL),a1,L
	move	*a8(OYVAL),a2,L
	sub	a2,a1
	sra	5,a1
	move	a1,*a8(OYVEL),L

	movi	kaptlife_time,a11

kaptloop
	PUSHP	a6,a7
	SLEEPK	1
	PULLP	a6,a7

	;bounds check
	callr	kaptin_bounds

	dsj	a11,kaptloop

kaptexpire
	calla	DELOBJA8

	DIE


 SUBRP	kaptin_bounds

	move	*a8(OXPOS),a14,W
	movi	kaptmin_x,a0
	cmp	a0,a14
	jrlt	kaptx_adjust

	movi	kaptmax_x,a0
	cmp	a0,a14
	jrgt	kaptx_adjust
	jruc	kapty_check

kaptx_adjust
	move	a0,*a8(OXPOS),W
	move	*a8(OXVEL),a0,L
	neg	a0
	move	a0,*a8(OXVEL),L

kapty_check
	move	*a8(OYPOS),a14
	movi	kaptmin_y,a0
	cmp	a0,a14
	jrlt	kapty_adjust

	movi	kaptmax_y,a0
	cmp	a0,a14
	jrgt	kapty_adjust
	jruc	kaptdone_check

kapty_adjust
	move	a0,*a8(OYPOS),W
	move	*a8(OYVEL),a0,L
	neg	a0
	move	a0,*a8(OYVEL),L

kaptdone_check
	rets


******************************************************************************
*
*	shell collision routines
*

 SUBR	shell_die
	PUSH	a1,a7

	movi	CLSDEAD,a14
	move	a14,*a8(OID),W
	move	*a8(OPLINK),a0,L
	movi	DEADSHELL_PID,a1
	movi	kaptexpire,a7
	calla	XFERPROC

	PULL	a1,a7
	rets


******************************************************************************
*
*	shell configuration data
*

kaptlife_time	equ	240		;how long they last

kaptmin_x	equ	53	;shell move bounds
kaptmax_x	equ	347-7
kaptmin_y	equ	45
kaptmax_y	equ	231-7


*****************************************************************************
******************************************************************************
******************************************************************************
*
*	color cycling processes
*

 SUBRP	robo_pal_cycles

	;laser flash cycle
	movi	[0Ah,1],a8		;cycle color A
	movi	robo_p,a9		;pal name
	movi	COLTAB_LFLASH,a10	;use the LFLASH table
	movk	1,a11			;cycle speed
	CREATE	CYCPID,CYCLE_TABLE

	;rgb cycle
	movi	[0Bh,1],a8		;cycle color B
	movi	robo_p,a9		;pal name
	movi	COLTAB_RGB,a10		;use the RGB table
	movk	8,a11			;cycle speed
	CREATE	CYCPID,CYCLE_TABLE

	;decay cycle
	movi	[0Ch,1],a8		;cycle color C
	movi	robo_p,a9		;pal name
	movi	COLTAB_DECAY,a10	;use the DECAY table
	movk	2,a11			;cycle speed
	CREATE	CYCPID,CYCLE_TABLE

	;laser cycle
	movi	[0Dh,1],a8		;cycle color D
	movi	robo_p,a9		;pal name
	movi	COLTAB_LASER,a10	;use the LASER table
	movk	20,a11			;cycle speed
	CREATE	CYCPID,CYCLE_TABLE

	;blue-purple-red cycle
	movi	[0Eh,1],a8		;cycle color E
	movi	robo_p,a9		;pal name
	movi	COLTAB_BLUPURRED,a10	;use the BPR table
	movk	1,a11			;cycle speed
	CREATE	CYCPID,CYCLE_TABLE

	;red-gold cycle
	movi	[0Fh,1],a8		;cycle color F
	movi	robo_p,a9		;pal name
	movi	COLTAB_REDGOLD,a10	;use the RED-GOLD table
	movk	10,a11			;cycle speed
	CREATE	CYCPID,CYCLE_TABLE

	rets


COLTAB_LFLASH
	.WORD	0380H,1380H,2380H,3380H,4380H,5380H,6380H,7380H,7300H
	.WORD	7280H,7200H,7180H,7080H,7008H,7008H,7010H,7010H,701CH
	.WORD	701CH,601CH,501CH,409CH,309CH,209CH,219CH,029CH,039CH
	.WORD	139CH,239CH,339CH,539CH,739CH,7390H,7380H,6380H,4380H
	.word	-1

;	.word	7C00h,7FFFh,7FFFh,03E0h,7FFFh,7FFFh,001Fh,7FFFh,7FFFh

COLTAB_RGB
	.WORD	07C00H,001FH,77A0h,741Ah
	.word	-1

;	.word	7C00h,03E0h,001Fh

COLTAB_DECAY
	.WORD	001CH,001CH,011CH,021CH,031CH,039CH,239CH,2390H,2388H
	.WORD	2380H,4300H,5280H,7180H,6180H,7080H,7000H,6000H,5000H
	.WORD	4000H,3000H,2000H,1000H
	.word	-1

;	.word	7FFFh,6F7Bh,5EF7h,4E73h,3DEFh,2D6Bh,1CE7h,0C63h,0000h

COLTAB_LASER
	.word	7C1Fh,7FFFh,7F00h
	.word	-1

COLTAB_BLUPURRED
	.WORD	001CH,101CH,201CH,301CH,401CH,501CH,601CH,701CH,7010H
	.WORD	7010H,7008H,7008H,7000H,7000H,7008H,7008H,7010H,7010H
	.WORD	701CH,701CH,601CH,501CH,401CH,301CH,201CH,101CH
;	.word	001Fh,7C1Fh,7C00h
