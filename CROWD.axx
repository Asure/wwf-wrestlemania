	.long	tlqisal_norm,      tlqisal_cheer1	 ,tlqisal_cheer2
	.long	tlqijosh_norm,     tlqijosh_cheer1	 ,tlqijosh_cheer2
	.long	tlqimark_norm,     tlqimark_cheer1	 ,tlqimark_cheer1

	.long	tlqitony_norm,     tlqitony_cheer1	 ,tlqitony_cheer2
	.long	tlqicarlos_norm,   tlqicarlos_cheer1	 ,tlqicarlos_cheer2
	.long	tlqinewc_norm,     tlqinewc_cheer1	 ,tlqinewc_cheer2
	.long	tlqijoy_norm,      tlqijoy_cheer1	 ,tlqijoy_cheer1
	.long	tlqiside1_norm,    tlqiside1_cheer1	 ,tlqiside1_cheer1

	.long	tlqiside2_norm,    tlqiside2_cheer1	 ,tlqiside2_cheer1
	.long	tlqiside3_norm,    tlqiside3_cheer1	 ,tlqiside3_cheer1
	.long	tlqigeorge_norm,   tlqigeorge_cheer1	 ,tlqigeorge_cheer1
	.long	tlqidave_norm,     tlqidave_cheer1	 ,tlqidave_cheer1
	.long	tlqisophia_norm,   tlqisophia_cheer1	 ,tlqisophia_cheer2

	.long	tlqimancow_norm,   tlqimancow_cheer1	 ,tlqimancow_cheer2
	.long	tlqijak2_norm,	tlqijak2_cheer1	 ,tlqijak2_cheer2
	.long	tlqieugene_norm,	tlqieugene_cheer1	 ,tlqieugene_cheer2
	.long	tlqipenacho_norm,	tlqipenacho_cheer1 ,tlqipenacho_cheer2
	.long	tlqijenni_norm,	tlqijenni_cheer1 	 ,tlqijenni_cheer2


