*****************************************************************************
* blocking

mode_block	;7

	move	*a13(BLOCK_TIME),a0
	inc	a0
	move	a0,*a13(BLOCK_TIME)
	cmpi	160,a0
	jrlt	zvuqno

	calla	get_opp_plyrmode
	cmpi	MODE_BLOCK,a0
	jrnz	zvuqno
	move	*a13(CLOSEST_XDIST),a0
	cmpi	61h,a0
	jrge	zvuqno
	cmpi	45,a0
	jrlt	zvuqno
	move	*a13(CLOSEST_ZDIST),a0
	cmpi	30,a0
	jrlt	zvuqpunchblock

zvuqno
	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	jrz	zvuqno_interrupt

	;press.  if block isn't down, let mode_normal handle it
	move	a0,a2			;save a0 from ...val_down
	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0
	jrz	zvuqset_mode_normal
	move	a2,a0			;restore a0 from ...val_down

	X32	a0
	addi	zvuqaction_table,a0
	move	*a0,a0,L
	call	a0

zvuqno_interrupt
	rets

zvuqset_mode_normal
	SETMODE	NORMAL
	jruc	mode_normal

zvuqaction_table
	.long	zvuqz,zvuqpunchblock,zvuqz	;0-2
	.long	zvuqpunchblock		;3
	.long	zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz	;4-10
	.long	zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz	;11-17
	.long	zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz	;18-24
	.long	zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz,zvuqz	;25-31

