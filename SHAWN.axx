;	move	*a8(WHOHITME),a14,L
;	movk	15,a0
;	move	a0,*a14(IMMOBILIZE_TIME)
;
;	movi	shn_fstein_anim,a14
;	move	a14,*a8(SPECIAL_MOVE_ADDR),L
;	WRSND	W_SHAWN,KICK_T1,KICK_T2
;
;	SLEEPK	20
;
;	jruc	stmvlp
;
******************************************************************************

shn_hdhold_combo1
;And arm break

ivbzTIMEOUT	.equ	60

ivbzlp0
	SLEEPK	1
ivbzlp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
;	jrnz	ivbzlp0
	jrz	ivbzcont
	cmpi	MODE_HEADHELD,a0
	jrnz	ivbzlp0
ivbzcont
;In combo mode?
;	calla	CHECK_COMBO_GO
;	jrlt	ivbzlp0

	clr	a11

	WAITSWITCH_DWN	J_TOWARD,0,ivbzlp

	movi	ivbzTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,ivbzlp
	WAITSWITCH_DWN	B_PUNCH,J_ALL,ivbzlp

	calla	CHECK_COMBO_GO
	jrlt	ivbztryarm

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	ivbzslam
	cmpi	MODE_HEADHELD,a0
	jrnz	ivbzlp0

ivbzslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ivbzlp0				;ignore

;Start combo rules here
;	move	*a8(ATTACH_PROC),a14,L
;	movk	15,a0
;	move	a0,*a14(IMMOBILIZE_TIME)

	;target WHOIHIT
	SMRTTGT	a8,WHOIHIT

	CALLA	FIND_AND_KILL_ENDLESS
	movi	shn_combo_kick_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_SHAWN,KICK_T1,KICK_T2

	SLEEPK	20

	jruc	ivbzlp
ivbztryarm
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	ivbzslam2
	cmpi	MODE_HEADHELD,a0
	jrnz	ivbzlp0
	move	*a8(I_WILL_DIE),A14
	jrnz	ivbzlp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ivbzlp0				;ignore

	CALLA	DO_REVERSAL
	CALLA	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	ivbzis_reversal

ivbzslam2
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ivbzlp0				;ignore

	movk	9,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

ivbzis_reversal
	movk	32,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS

	movi	shn_break_arm_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_SHAWN,GRABHOLD_T1,GRABHOLD_T2

	SLEEPK	20

	jruc	ivbzlp

******************************************************************************

shn_hdhold_combo2

vvuzTIMEOUT	.equ	60

vvuzlp0
	SLEEPK	1
vvuzlp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrnz	vvuzlp0
;	jrz	vvuzcont
;	cmpi	MODE_HEADHELD,a0
;	jrnz	vvuzlp0
;vvuzcont
;In combo mode?
	calla	CHECK_COMBO_GO
	jrlt	vvuzlp0

	clr	a11

	WAITSWITCH_DWN	J_TOWARD,0,vvuzlp

	movi	vvuzTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,vvuzlp
	WAITSWITCH_DWN	B_KICK,J_ALL,vvuzlp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	vvuzslam
	cmpi	MODE_HEADHELD,a0
	jrnz	vvuzlp0


vvuzslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	vvuzlp0				;ignore

;Start combo rules here
;	move	*a8(ATTACH_PROC),a14,L
;	movk	15,a0
;	move	a0,*a14(IMMOBILIZE_TIME)

	;target WHOIHIT
	SMRTTGT	a8,WHOIHIT

	CALLA	FIND_AND_KILL_ENDLESS
	movi	shn_combo_punch_anim,A14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_SHAWN,KICK_T1,KICK_T2

	SLEEPK	20

	jruc	vvuzlp

*****************************************************************************

 SUBR	shawn_ani_init

	move	*a13(FACING_DIR),a0
	btst	PLAYER_RIGHT_BIT,a0
	jrnz	lekxp1
;Plyr 2
	movi	shn_stand4_anim,a0
	calla	change_anim1a

	movi	shn_torso4_anim,a0
	calla	change_anim2a

	PUSH	a10
	move	a13,a10
	CREATE	TAUNT_PID,do_taunt
	PULL	a10

	rets

lekxp1
	movi	shn_stand2_anim,a0
	calla	change_anim1a

	movi	shn_torso2_anim,a0
	calla	change_anim2a

	rets


*****************************************************************************
*
* SHAWNS CONTROL CODE
*
* a13 = * shawn process

 SUBR	move_shawn


	movi	shn_secret_moves,a11
	calla	check_secret_moves

	move	*a13(PLYRMODE),a0
	sll	5,a0			;x 32
	addi	bnucmode_table,a0
	move	*a0,a0,L
	call	a0
	rets

bnucmode_table
	.long	mode_normal		;0
	.long	mode_running		;1
	.long	mode_inair		;2
	.long	mode_attached		;3
	.long	mode_onground		;4
	.long	mode_bouncing		;5
	.long	mode_onturnbkl		;6
	.long	mode_block		;7
	.long	mode_dizzy		;8
	REFLONG	mode_dead		;9
	.long	mode_oppoverhead	;10
	.long	mode_climbturnbkl	;11
	.long	mode_waitanim		;12
	.long	mode_grapple		;13
	.long	mode_master		;14
	.long	mode_slave		;15
	.long	mode_headhold		;16
	.long	mode_puppet2		;17
	.long	mode_normal	;18
	.long	mode_headheld		;19
	.long	mode_puppet		;20
	.long	mode_inair2		;21
	.long	mode_normal	;22
	.long	mode_normal	;23
	.long	mode_chokehold		;24
	.long	mode_choking		;25

*****************************************************************************

mode_normal

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	yaedno_interrupt

	move	*a13(I_WILL_DIE),a0
	jrz	yaednope
	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	yaednope
;Player has died amidst a combo...
;Knock me down.
	movi	shn_fall_back_anim,a0
	calla	change_anim1a

;Zero health bar
	movi	-10,a0
	move	*a13(PLYRNUM),a1
	calla	adjust_health

	SETMODE	DEAD

	clr	a0
	move	a0,*a13(I_WILL_DIE)

	rets

yaednope
;Perhaps we need to interrupt any sequence when a wrestler has won?

	calla	get_opp_plyrmode
	cmpi	MODE_DEAD,a0
	jrne	yaedopp_not_dead

	;if closest is a zombie, skip pin section.
	calla	get_opp_process
	move	*a0(STATUS_FLAGS),a14
	btst	B_ZOMBIE,a14
	jrnz	yaedopp_not_dead
	
	;all opponents are dead.  Check for pins/raisearms

	;if we're attached to someone, don't interrupt it.
	move	*a13(ATTACH_PROC),a1,L
	jrz	yaedno_attch
	move	*a1(ATTACH_PROC),a2,L
	cmp	a2,a13
	jreq	yaedno_pin_yet
yaedno_attch

	;if a teammate has pinned, raise yer arm.
	calla	ck_teammate_pin	
	jrc	yaedraisearm

	;nobody has pinned.  if we're outside or all our opponents are
	; outside, do a raisearm.
	calla	raisearm_check
	jrc	yaedraisearm

	;we're inside with a pinnable opponent.  any button pins.
	move	*a13(BUT_VAL_CUR),a0
	jrz	yaedno_pin_yet

	;we have a press -- make sure opponent is on the ground
	calla	can_pin
	jrnc	yaedopp_notgnd

	;opponent is on the ground.  pin him.
	FACE24	shn,pin_anim
	calla	change_anim1a

	;set the 'I did a pin' flag.
	move	*a13(STATUS_FLAGS),a14
	ori	M_DID_PIN,a14
	move	a14,*a13(STATUS_FLAGS)

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

yaedraisearm
	FACE24	shn,raise_arm_anim
	calla	change_anim1a
	calla	set_raisearm_bit

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

yaedtoo_far_to_pin
yaedopp_notgnd
yaedopp_not_dead
yaedno_pin_yet

	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	yaedimmobilized

	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0	;maybe have to action tables?
	jrz	yaednblk			;1 for down transitions
	callr	yaedblock			;& 1 for current buttons
	jrc	yaednblk
	clr	a0
	move	a0,*a13(ATTACK_TYPE)
	rets
yaednblk
	move	*a13(BUT_VAL_CUR),a0
	andi	011111b,a0
	cmpi	PLAYER_PUNCH_VAL|PLAYER_KICK_VAL,a0
	jrz	yaedpunchkick

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	yaedaction_table,a0
	move	*a0,a0,L
	call	a0

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	yaedno_interrupt


	move	*a13(STICK_VAL_CUR),a0
	move	a0,*a13(MOVE_DIR)
	calla	climb_turnbuckle
	jrnc	yaedno_climb
	move	*a13(WRESTLERNUM),A5
	MOVI	CLIMB_ROPES,A2
	MOVI	1000,A0
	CALLA	ADD_IF_SILENT
	rets

yaedimmobilized
	clr	a14
	move	a14,*a13(MOVE_DIR)
yaedno_climb
	calla	execute_walk

yaedno_interrupt
	rets

yaedaction_table
	.long	yaedz,yaedpunch,yaedblock,yaedblock			;0-3
	.long	yaedsuper_punch,yaedsuper_punch,yaedblock,yaedblock	;4-7
	.long	yaedkick,yaedpunchkick,yaedblock,yaedblock		;8-11
	.long	yaedsuper_punch,yaedpunchkick,yaedblock,yaedblock	;12-15
	.long	yaedsuper_kick,yaedsuper_kick,yaedblock,yaedblock	;16-19
	.long	yaedgraboh,yaedgraboh,yaedblock,yaedblock		;20-23
	.long	yaedsuper_kick,yaedpunchkick,yaedblock,yaedblock	;24-27
	.long	yaedgraboh,yaedgraboh,yaedblock,yaedblock		;28-31

************
yaedz
	rets

************
yaedpunch		;1
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  62  95	headbutt
* normal	>		normal punch
*
* onground	< 120 120	elbow drop
* onground	>		normal punch
*
* running |
* bouncing			normal punch
*
* onturnbkl	<  60  60	punch
* onturnbkl	>		normal punch
*
* puppet|inair			normal punch


	JJXM_INIT
	JJXM	NORMAL,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	BLOCK,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	DIZZY,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	ONGROUND,	160,140,yaedpunch_lbdrop,yaedpunch_punch
	JJXM	RUNNING,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	BOUNCING,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	ONTURNBKL,	 	yaedpunch_punch
	JJXM	CLIMBTURNBKL,	 	yaedpunch_punch
	JJXM	PUPPET,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	PUPPET2,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	INAIR,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	ATTACHED,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	DEAD,		160,140,yaedpunch_lbdrop,yaedpunch_punch
	JJXM	OPPOVERHEAD,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	WAITANIM,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	GRAPPLE,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	MASTER,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	SLAVE,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	HEADHOLD,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	HEADHELD,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	CHOKEHOLD,	 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM	INAIR2,		 50, 45,yaedpunch_hdbutt,yaedpunch_punch
	JJXM_END

