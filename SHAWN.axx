*******************************************************************************

;	STRUCTPD
;	WORD		hkgcCHARGE_TIME	;UDW
hkgcCHARGE_TIME	.equ	SM_USRW1

shn_charge_suplex

;Try to spin around and suplex

hkgcstart_over
	clr	a14
	move	a14,*a13(hkgcCHARGE_TIME),W
hkgcloop1
	SLEEPK	1

	move	*a13(hkgcCHARGE_TIME),a14,W
	inc	a14
	move	a14,*a13(hkgcCHARGE_TIME),W

	move	*a8(BUT_VAL_CUR),a0
	btst	PLAYER_PUNCH_BIT,a0
	jrz	hkgcp1

	jruc	hkgcloop1

hkgcp1

;no longer holding button
	move	*a13(hkgcCHARGE_TIME),a14
	cmpi	100,a14
	jrlt	hkgcstart_over

	move	*a8(GETUP_TIME),a0
	jrnz	hkgcstart_over
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	hkgcstart_over
;	jrz	hkgcrev
	cmpi	MODE_HEADHOLD,a0
	jrz	hkgcstart_over
	cmpi	MODE_ONGROUND,a0
	jrz	hkgcstart_over
	cmpi	MODE_DEAD,a0
	jrz	hkgcstart_over

;Success!  Check for the UNINT bit, then queue it up.
	move	*a8(ANIMODE),a14
	btst	MODE_UNINT_BIT,a14
	jrnz	hkgcstart_over

	movi	shn_gsuplex_anim,a14

	move	*a8(PLYRMODE),a0
	cmpi	MODE_RUNNING,a0
	jrnz	hkgccont

	movi	shn_gsuplex_run_anim,a14

hkgccont
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_SHAWN,KICK_T1,KICK_T2

	jruc	hkgcstart_over
	

