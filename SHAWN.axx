*******************************************************************************

neupjump_kick
	.word	B_SKICK,		J_ALL
	.word	J_AWAY,			J_REAL_LR | J_UP | J_DOWN
	.word	J_AWAY,			J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 32		;max
	.long	neupscrt_flykick

neupscrt_flykick
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neupout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	neupout
	cmpi	MODE_DEAD,a0
	jrz	neupout
	cmpi	MODE_HEADHELD,a0
	jrz	neupout
	cmpi	MODE_ATTACHED,a0
	jrz	neupout

	movi	shn_4_jump_kick_anim,a0
	calla	change_anim1a

	WRSND	W_SHAWN,FLYKICK_T1,FLYKICK_T2

	rets

*******************************************************************************

neuphip_toss
;	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	neupscrt_hiptoss

	.word	B_PUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	neupscrt_hiptoss


neupscrt_hiptoss
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neupout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	neupout
;	cmpi	MODE_BLOCK,a0
;	jrz	neupout
	cmpi	MODE_DEAD,a0
	jrz	neupout
	cmpi	MODE_HEADHELD,a0
	jrz	neupout
	cmpi	MODE_INAIR,a0
	jrz	neupdoit
	cmpi	MODE_INAIR2,a0
	jrz	neupdoit

	move	*a13(CLOSEST_DIST),a0
	cmpi	70h,a0
	jrgt	neupout

neupdoit
	FACE24	shn,hiptoss_anim
	calla	change_anim1a

	WRSND	W_SHAWN,HIPTOSS_T1,PUNCH_T2
	rets

*******************************************************************************

neupgrab_fling2
	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	neupscrt_grabfling2

neuphip_toss2
	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	neupscrt_grabfling2

neupscrt_grabfling2
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neupout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	neupyes
	cmpi	MODE_RUNNING,a0
	jrz	neupyes
	rets

*******************************************************************************

neupgrab_fling
;	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	neupscrt_grabfling

	.word	B_SPUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	neupscrt_grabfling

neupscrt_grabfling

;Make this miss, rotate to missed opponent,
;and stay rotated to flung opponent, also make
;this work from both angles!

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neupout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	neupyes
	cmpi	MODE_RUNNING,a0
	jrnz	neupnope
neupyes
	FACE24	shn,hiptoss_anim
	calla	change_anim1a

	WRSND	W_SHAWN,GRABFLING_T1,PUNCH_T2
	rets

neupnope
;Don't fling when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_HEADHELD,a0
	jrz	neupout
	cmpi	MODE_ONGROUND,a0
	jrz	neupout
	cmpi	MODE_DEAD,a0
	jrz	neupout

;	move	*a13(LAST_FLING_ATTEMPT),a14,L
;	move	@PCNT,a0,L
;	sub	a14,a0
;	cmpi	3*60,a0
;	jrge	neupok2
;
;	FACE24	shn,slap_anim
;	calla	change_anim1a
;
;	WRSND	W_SHAWN,SPUNCH_T1,SPUNCH_T2
;	rets
;
;neupok2
;	move	@PCNT,a14,L			;use 32-bit PCNT!
;	move	a14,*a13(LAST_FLING_ATTEMPT),L

	FACE24	shn,grabfling_anim
	calla	change_anim1a

	WRSND	W_SHAWN,GRABFLING_T1,PUNCH_T2
	rets

*******************************************************************************

neupneck_grab
	.word	B_SPUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 32		;max
	.long	neupscrt_neck

neupscrt_neck
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neupout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	neupout
	cmpi	MODE_DEAD,a0
	jrz	neupout
	cmpi	MODE_HEADHELD,a0
	jrz	neupout

	move	*a13(LAST_HEADHOLD),a14,L
	move	@PCNT,a0,L
	sub	a14,a0
	cmpi	2*60,a0
	jrge	neupok2a

;This head grab is too close (in terms of time) to most recent grab
	.ref	shn_3_fake_hold_anim
	movi	shn_3_fake_hold_anim,a0
	calla	change_anim1a
	rets

neupok2a
	move	*a13(CLOSEST_XDIST),a1
	cmpi	90,a1
	jrgt	neupstd_grab

	movi	shn_3_head_hold2_anim,a0
	calla	change_anim1a
neupout	rets

neupstd_grab
	movi	shn_3_head_hold_anim,a0
	calla	change_anim1a
	rets

*******************************************************************************

neupcharge_flying_kick
	move	*a13(BUT_VAL_UP),a0
	btst	PLAYER_SKICK_BIT,a0
	jrz	neupno_kick

	move	*a13(PLYRNUM),a0
	calla	get_powerk_dtime
	cmpi	85,a0			;> min?
	jrlt	neupno_kick

	callr	neupscrt_kick
	setc
	rets

neupno_kick
	clrc
	rets

neupscrt_kick

	move	*a13(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	neupout
	cmpi	MODE_HEADHOLD,a0
	jrz	neupout

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neupout

	.ref	ck_ignore
	calla	ck_ignore
	jrc	neupout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	neupout
	cmpi	MODE_DEAD,a0
	jrz	neupout

neupok

	SETMODE	INAIR

	movk	1,a0			;Ensure leap at
	move	a0,*a8(OBJ_XVEL),L

	movi	shn_flying_kick_anim,a0
	calla	change_anim1a


	WRSND	W_SHAWN,FLYKICK_T1,FLYKICK_T2

	rets

*******************************************************************************

neupfrankensteiner
	.word	B_SKICK,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 32 		;max
	.long	neupscrt_fstein

neupscrt_fstein
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	neuprets
	move	*a13(PLYRMODE),a0
	CMPI	MODE_HEADHOLD,a0
	jrz	neuprets

;no frankensteiner if opponent is on the ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jreq	neuprets
	cmpi	MODE_DEAD,a0
	jreq	neuprets

	;don't do it if opponent is behind you
	calla	ck_ignore
	jrc	neuprets
	
	CALLA	FIND_AND_KILL_ENDLESS
	movi	shn_fstein_anim,a0
	calla	change_anim1a
	WRSND	W_SHAWN,KICK_T1,KICK_T2
neuprets	rets

	.if NUM_SHAWN_FINISHES
******************************************************************************
 SUBRP	shn_finish_move1

aojrTIMEOUT	.equ	TSEC

aojrend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		aojrend_wait			; br = no

aojrreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,aojrreset
	movi		aojrTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_DOWN,0,aojrreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,aojrreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,aojrreset
	WAITSWITCH_DWN	B_PUNCH,J_ALL,aojrreset

	movi		shn_finish1_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif
	

	.if NUM_SHAWN_FINISHES > 1
******************************************************************************
 SUBRP	shn_finish_move2

zmjiTIMEOUT	.equ	TSEC

zmjiend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		zmjiend_wait			; br = no

zmjireset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,zmjireset
	movi		zmjiTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_UP,0,zmjireset
	WAITSWITCH_DWN	J_RIGHT,J_UP,zmjireset
	WAITSWITCH_DWN	J_RIGHT,J_UP,zmjireset
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,zmjireset

	movi		shn_finish2_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif


*******************************************************************************
shn_swirl_speedkick

hnwlTIMEOUT	.equ	60

hnwllp0
	SLEEPK	1
hnwllp
	move	*a8(GETUP_TIME),a0
	jrnz	hnwllp0
	clr	a11

	WAITSWITCH_DWN	J_DOWN,0,hnwllp

	movi	hnwlTIMEOUT,a11
;	WAITSWITCH_DWN	J_DOWN_TOWARD,0,hnwllp
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,hnwllp
	WAITSWITCH_DWN	B_KICK,J_ALL,hnwllp

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	hnwllp0

	move	*a8(PLYRMODE),a0
	cmpi	MODE_DEAD,a0
	jrz	hnwllp0
	cmpi	MODE_HEADHOLD,a0
	jrz	hnwlknee
	cmpi	MODE_HEADHELD,a0
	jrnz	hnwlslam
	move	*a8(I_WILL_DIE),a14
	jrnz	hnwllp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	hnwllp0				;ignore

	CALLA	DO_REVERSAL
	CALLA	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

;	;immobilize WHOHITME
;	move	*a8(WHOHITME),a0,L
;	jruc	hnwlis_reversal

hnwlslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	hnwllp0				;ignore

;	movk	6,a10
;	CREATE	MESSAGE_PID,BONUS_MESS

;	;target WHOIHIT -- don't hit anyone else
;	SMRTTGT	a8,WHOIHIT

;	;immobilize WHOIHIT
;	move	*a8(WHOIHIT),a0,L

hnwlis_reversal
;	movk	15,a14
;	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS

	movi	shn_super_speedkick_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_SHAWN,KICK_T1,KICK_T2
	SLEEPK	20
	jruc	hnwllp

hnwlknee
	CALLA	FIND_AND_KILL_ENDLESS
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	hnwllp0				;ignore

;	move	*a8(WHOHITME),a14,L
;	movk	15,a0
;	move	a0,*a14(IMMOBILIZE_TIME)


	move	*a8(WHOIHIT),a0,L
	movi	6*60,a14
	move	a14,*a0(DELAY_METER)

	SPCDMG	D_FLYKICK/2,20

	movi	shn_flying_kick_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L

	SETMODE	INAIR

;	movi	1000h,a0
;	move	a0,*a13(OBJ_XVEL),L
;	movi	1000h,a0
;	move	a0,*a8(OBJ_XVEL),L
;	movi	1000h,a0
;	move	a0,*a13(OBJ_XVEL),L

	WRSND	W_SHAWN,FLYKICK_T1,FLYKICK_T2
	SLEEPK	5
	movi	40000h,a0
	move	a0,*a8(OBJ_YVEL),L
	SLEEPK	20
	jruc	hnwllp

; 
;*******************************************************************************
;
;	STRUCTPD
;	WORD		hnwlCHARGE_TIME	;UDW
;	WORD		hnwlTIMEOUT	;UDW
;
;shn_charge_speedkick
;
;hnwlstart_over
;	;charge on stick away
;	clr	a14
;	move	a14,*a13(hnwlCHARGE_TIME),W
;hnwlloop1
;	SLEEPK	1
;
;	move	*a13(hnwlCHARGE_TIME),a14,W
;	inc	a14
;	move	a14,*a13(hnwlCHARGE_TIME),W
;	move	*a8(STICK_VAL_CUR),a0
;
;;Arbitrarily define TOWARD to be RIGHT.  So if the opponent is to
;;our left, flip the L|R direction bits...
;
;;However, if the stick isn't pointed left or right, don't do
;;anything.
;	move	a0,a14
;	andi	MOVE_LEFT|MOVE_RIGHT,a14
;	jrz	hnwlno_flip
;
;	move	*a8(NEW_FACING_DIR),a14
;	btst	MOVE_LEFT_BIT,a14
;	jrz	hnwlno_flip
;	xori	MOVE_LEFT|MOVE_RIGHT,a0
;hnwlno_flip
;
;;If we're still holding away, jump back to hnwlloop1
;	btst	MOVE_LEFT_BIT,a0
