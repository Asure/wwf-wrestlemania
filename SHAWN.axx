*****************************************************************************
*
* RUNNING (if GETUP_TIME > 0 then player is out of control)
*

ijfjXRUN_VAL	equ	SHN_XRUN
ijfjZDRIFT_VAL	equ	SHN_ZDRIFT

mode_running

	move	*a13(RUN_TIME),a0		;Used for flying kick
	addk	1,a0
	move	a0,*a13(RUN_TIME)

	move	*a13(USR_VAR1),a0
	jrnz	ijfjno_vel

	calla	bounce_off_ropes

	movi	ijfjXRUN_VAL,a0
	move	*a13(MOVE_DIR),a14
	btst	PLAYER_RIGHT_BIT,a14
	jrnz	ijfjpos
	neg	a0
ijfjpos
	move	@hyper_speed_on,a14
	sll	a14,a0
	move	a0,*a13(OBJ_XVEL),L

ijfjno_vel

	move	*a13(GETUP_TIME),a0		;delay b4 gaining control
	jrnz	ijfjout_of_control

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	ijfjno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	move	*a13(MOVE_DIR),a1
	or	a0,a1
	andi	MOVE_LEFT|MOVE_RIGHT,a1
	cmpi	MOVE_LEFT|MOVE_RIGHT,a1
	jrne	ijfjcontinue_run

	;braking with stick.  abort run.

	SETMODE	NORMAL

ijfjcontinue_run
ijfjno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	clr	a1

	movi	-ijfjZDRIFT_VAL,a1
	btst	PLAYER_UP_BIT,a0
	jrnz	ijfjsetvel

	movi	ijfjZDRIFT_VAL,a1
	btst	PLAYER_DOWN_BIT,a0
	jrnz	ijfjsetvel

	clr	a1
ijfjsetvel
	move	a1,*a13(OBJ_ZVEL),L

;Delay reading buttons after just getting out of an out of control run
;so a mistaken move isn't fired off
	move	*a13(DELAY_BUTNS),a0
	jrnz	ijfjout_of_control

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	ijfjaction_table,a0
	move	*a0,a0,L
	call	a0
ijfjout_of_control
	rets

ijfjaction_table
	.long	ijfjz,ijfjpunch,ijfjblock,ijfjblock			;0-3
	.long	ijfjsuper_punch,ijfjsuper_punch,ijfjblock,ijfjblock	;4-7
	.long	ijfjkick,ijfjpunchkick,ijfjblock,ijfjblock		;8-11
	.long	ijfjsuper_punch,ijfjpunchkick,ijfjblock,ijfjblock	;12-15
	.long	ijfjsuper_kick,ijfjsuper_kick,ijfjblock,ijfjblock	;16-19
	.long	ijfjgraboh,ijfjgraboh,ijfjblock,ijfjblock		;20-23
	.long	ijfjsuper_kick,ijfjpunchkick,ijfjblock,ijfjblock	;24-27
	.long	ijfjgraboh,ijfjgraboh,ijfjblock,ijfjblock		;28-31

