shn_sliding_kicktoss

stmvTIMEOUT	.equ	60

stmvlp0
	SLEEPK	1
stmvlp
	clr	a11

;	WAITSWITCH_DWN	J_AWAY,0,stmvlp
	WAITSWITCH_DWN	J_TOWARD,0,stmvlp

	movi	stmvTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,stmvlp
	WAITSWITCH_DWN	B_KICK,J_ALL,stmvlp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	stmvlp0
	cmpi	MODE_HEADHOLD,a0
	jrz	stmvlp0
	cmpi	MODE_ONGROUND,a0
	jrz	stmvlp0
	cmpi	MODE_DEAD,a0
	jrz	stmvlp0

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	stmvlp0

	move	*a8(GETUP_TIME),a0
	jrnz	stmvlp0


;Don't do it when he is on ground
	SWAP	a8,a13
	calla	get_opp_plyrmode
	SWAP	a8,a13
	cmpi	MODE_ONGROUND,a0
	jrz	stmvlp
	cmpi	MODE_DEAD,a0
	jrz	stmvlp

;Don't do it if opponent is behind you
	SWAP	a8,a13
	calla	ck_ignore
	jrnc	stmvnorm
	SWAP	a8,a13
	jruc 	stmvlp
stmvnorm	
	SWAP	a8,a13

	WRSND	W_SHAWN,KICK_T1,KICK_T2
	movi	shn_sliding_kicktoss_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L

	SLEEPK	20

	jruc	stmvlp

