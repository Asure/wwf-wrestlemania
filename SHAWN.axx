;ntzvVEL	equ	30000h		;38000h	;30000h
;ntzvDVEL	equ	21f0eh		;27978h	;21f0eh
;ntzvVEL	equ	38000h		;38000h	;30000h
;ntzvDVEL	equ	30000h		;27978h	;21f0eh
ntzvVEL	equ	3a000h		;38000h	;30000h
ntzvDVEL	equ	31000h		;27978h	;21f0eh


 SUBR shn_velocity_table

;		X,	Z

	.long	0,	-ntzvVEL	;0 UP

	.long	ntzvDVEL,	-ntzvDVEL	;1 UP-RIGHT

	.long	ntzvVEL,	0	;2 RIGHT

	.long	ntzvDVEL,	ntzvDVEL	;3 DOWN-RIGHT

	.long	0,	ntzvVEL	;4 DOWN

	.long	-ntzvDVEL,	ntzvDVEL	;5 DOWN-LEFT

	.long	-ntzvVEL,	0	;6 LEFT

	.long	-ntzvDVEL,	-ntzvDVEL	;7 UP-LEFT


