*******************************************************************************
shn_flipslam
;Can do from head hold also!

fuxsTIMEOUT	.equ	30

fuxslp0
	SLEEPK	1
fuxslp
	move	*a8(GETUP_TIME),a0
	jrnz	fuxslp0

	clr	a11

	WAITSWITCH_DWN	J_UP,0,fuxslp

	movk	fuxsTIMEOUT,a11

;	WAITSWITCH_DWN	J_UP_TOWARD,0,fuxslp
	WAITSWITCH_DWN	J_TOWARD,0,fuxslp
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,fuxslp

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	fuxslp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrnz	fuxsslam
	move	*a8(I_WILL_DIE),A14
	jrnz	fuxslp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	fuxslp0				;ignore

	CALLA	DO_REVERSAL
	CALLA	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	fuxsis_reversal

fuxsslam
	cmpi	MODE_HEADHOLD,a0
	jrnz	fuxsslam2
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	fuxslp0				;ignore

	movi	39,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

fuxsis_reversal
	movk	15,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS
fuxsslam2
	movi	shn_flipslam_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_SHAWN,KICK_T1,KICK_T2

	SLEEPK	20

	jruc	fuxslp

*******************************************************************************
*

shn_grab_toss_air

gscvTIMEOUT	.equ	40

gscvlp0
	SLEEPK	1
gscvlp
	clr	a11

	WAITSWITCH_DWN	J_AWAY,0,gscvlp

	movi	gscvTIMEOUT,a11

	WAITSWITCH_DWN	J_AWAY,0,gscvlp
;	WAITSWITCH_DWN	B_PUNCH,J_DOWN_AWAY|J_UP_AWAY,gscvlp
	WAITSWITCH_DWN	B_PUNCH,J_ALL,gscvlp

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	gscvlp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jreq	gscvlp0

;Don't do it when he is on ground
	SWAP	a8,a13
	calla	get_opp_plyrmode
	SWAP	a8,a13
;Don't do it when he is on ground
	cmpi	MODE_ONGROUND,a0
	jrz	gscvlp
	cmpi	MODE_DEAD,a0
	jrz	gscvlp
	cmpi	MODE_INAIR,a0
	jrz	gscvdoit2
	cmpi	MODE_INAIR2,a0
	jrz	gscvdoit2

	move	*a8(CLOSEST_NUM),a0
	X32	a0
	addi	process_ptrs,a0
	move	*a0,a0,L
	move	*a0(ATTACK_TYPE),a0
	cmpi	AT_LEAPING,a0
	jrz	gscvdoit2

	move	*a8(CLOSEST_DIST),a0
	cmpi	6ch,a0
	jrgt	gscvlp

	FACE24	shn,hiptoss_anim
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_SHAWN,HIPTOSS_T1,PUNCH_T2

	SLEEPK	20

	jruc	gscvlp

gscvdoit2	FACE24	shn,hiptoss2_anim
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_SHAWN,HIPTOSS_T1,PUNCH_T2

	SLEEPK	20

	jruc	gscvlp

