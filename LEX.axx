mode_waitanim	;12

	move	*a13(ANIMODE),a0
	btst	MODE_END_BIT,a0
	jrz	qnxdnot_ended

	move	*a13(CODE_ADDR),a0,L
	call	a0

qnxdnot_ended
	rets


