	movi	pxlsTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,pxlslp
	WAITSWITCH_DWN	B_KICK,J_ALL,pxlslp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	pxlsslam
	cmpi	MODE_HEADHELD,a0
	jrnz	pxlslp0

pxlsslam
