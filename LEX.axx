gvbisuper_kick	;16
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  60   60	close in super move
* dizzy			"		"
* normal	>		jumping kick move
* dizzy			"		"
*
* onground	< 120  120	super stomp
* onground	>		normal kick
*
* running			big boot
* bouncing			big boot
*
* onturnbkl	<  60   96	jumping kick move
* climbturnbkl		"		"
* onturnbkl	>		normal kick
* climbturnbkl		"		"
*
	JJXM_INIT
	JJXM	NORMAL,		 60, 60,gvbiskick_special,gvbiskick_kick	;0
	JJXM	RUNNING,	 	gvbiskick_bigboot			;1
	JJXM	INAIR,		 60, 60,gvbiskick_special,gvbiskick_kick	;2
	JJXM	ATTACHED,	 60, 60,gvbiskick_special,gvbiskick_kick	;3
	JJXM	ONGROUND,	160,140,std_stomp,std_kick		;4
	JJXM	BOUNCING,	 	gvbiskick_bigboot			;5
	JJXM	ONTURNBKL,	 60, 96,gvbiskick_kick,std_kick		;6
	JJXM	BLOCK,		 60, 60,gvbiskick_special,gvbiskick_kick	;7
	JJXM	DIZZY,		 60, 60,gvbiskick_special,gvbiskick_kick	;8
	JJXM	DEAD,		160,140,std_stomp,std_kick		;9
	JJXM	OPPOVERHEAD,	 60, 60,gvbiskick_special,gvbiskick_kick	;10
	JJXM	CLIMBTURNBKL,	 60, 96,gvbiskick_kick,std_kick		;11
	JJXM	WAITANIM,	 60, 62,gvbiskick_special,gvbiskick_kick	;12
	JJXM	GRAPPLE,	 60, 62,gvbiskick_special,gvbiskick_kick	;13
	JJXM	MASTER,		 60, 62,gvbiskick_special,gvbiskick_kick	;14
	JJXM	SLAVE, 		 60, 62,gvbiskick_special,gvbiskick_kick	;15
	JJXM	HEADHOLD,	 60, 62,gvbiskick_special,gvbiskick_kick	;16
	JJXM	HEADHELD,	 	std_kick
	JJXM	CHOKEHOLD,	 60, 62,gvbiskick_special,gvbiskick_kick	;16
	JJXM	PUPPET,		 60, 62,gvbiskick_special,gvbiskick_kick	;20
	JJXM	PUPPET2,	 60, 62,gvbiskick_special,gvbiskick_kick	;20
	JJXM	INAIR2,		 	gvbikick_TB
	JJXM_END

