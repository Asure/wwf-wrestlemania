*****************************************************************************
*
* RUNNING (if GETUP_TIME > 0 then player is out of control)
*

apgoXRUN_VAL	equ	LEX_XRUN
apgoZDRIFT_VAL	equ	LEX_ZDRIFT

mode_running

	move	*a13(RUN_TIME),a0		;Used for flying kick
	addk	1,a0
	move	a0,*a13(RUN_TIME)

	move	*a13(USR_VAR1),a0
	jrnz	apgono_vel

	calla	bounce_off_ropes

	movi	apgoXRUN_VAL,a0
	move	*a13(MOVE_DIR),a14
	btst	PLAYER_RIGHT_BIT,a14
	jrnz	apgopos
	neg	a0
apgopos
	move	@hyper_speed_on,a14
	sll	a14,a0
	move	a0,*a13(OBJ_XVEL),L

apgono_vel

	move	*a13(GETUP_TIME),a0		;delay b4 gaining control
	jrnz	apgoout_of_control

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	apgono_interrupt

	move	*a13(STICK_VAL_CUR),a0
	move	*a13(MOVE_DIR),a1
	or	a0,a1
	andi	MOVE_LEFT|MOVE_RIGHT,a1
	cmpi	MOVE_LEFT|MOVE_RIGHT,a1
	jrne	apgocontinue_run

	;braking with stick.  abort run.

	SETMODE	NORMAL

apgocontinue_run
apgono_interrupt

	move	*a13(STICK_VAL_CUR),a0
	clr	a1

	movi	-apgoZDRIFT_VAL,a1
	btst	PLAYER_UP_BIT,a0
	jrnz	apgosetvel

	movi	apgoZDRIFT_VAL,a1
	btst	PLAYER_DOWN_BIT,a0
	jrnz	apgosetvel

	clr	a1
apgosetvel
	move	a1,*a13(OBJ_ZVEL),L

;Delay reading buttons after just getting out of an out of control run
;so a mistaken move isn't fired off
	move	*a13(DELAY_BUTNS),a0
	jrnz	apgoout_of_control

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	apgoaction_table,a0
	move	*a0,a0,L
	call	a0
apgoout_of_control
	rets

apgoaction_table
	.long	apgoz,apgopunch,apgoblock,apgoblock			;0-3
	.long	apgosuper_punch,apgosuper_punch,apgoblock,apgoblock	;4-7
	.long	apgokick,apgopunchkick,apgoblock,apgoblock		;8-11
	.long	apgosuper_punch,apgopunchkick,apgoblock,apgoblock	;12-15
	.long	apgosuper_kick,apgosuper_kick,apgoblock,apgoblock	;16-19
	.long	apgograboh,apgograboh,apgoblock,apgoblock		;20-23
	.long	apgosuper_kick,apgopunchkick,apgoblock,apgoblock	;24-27
	.long	apgograboh,apgograboh,apgoblock,apgoblock		;28-31

************
apgoz
	rets


