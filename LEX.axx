*****************************************************************************
* blocking

mode_block	;7

	move	*a13(BLOCK_TIME),a0
	inc	a0
	move	a0,*a13(BLOCK_TIME)
	cmpi	160,a0
	jrlt	lvkpno

	calla	get_opp_plyrmode
	cmpi	MODE_BLOCK,a0
	jrnz	lvkpno
	move	*a13(CLOSEST_XDIST),a0
	cmpi	61h,a0
	jrge	lvkpno
	cmpi	45,a0
	jrlt	lvkpno
	move	*a13(CLOSEST_ZDIST),a0
	cmpi	30,a0
	jrlt	lvkppunchblock

lvkpno
	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	jrz	lvkpno_interrupt

	;press.  if block isn't down, let mode_normal handle it
	move	a0,a2			;save a0 from ...val_down
	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0
	jrz	lvkpset_mode_normal
	move	a2,a0			;restore a0 from ...val_down

	X32	a0
	addi	lvkpaction_table,a0
	move	*a0,a0,L
	call	a0

lvkpno_interrupt
	rets

lvkpset_mode_normal
	SETMODE	NORMAL
	jruc	mode_normal

lvkpaction_table
	.long	lvkpz,lvkppunchblock,lvkpz	;0-2
	.long	lvkppunchblock		;3
	.long	lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz	;4-10
	.long	lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz	;11-17
	.long	lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz	;18-24
	.long	lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz,lvkpz	;25-31

