 SUBR	lex_ani_init

	move	*a13(FACING_DIR),a0
	btst	PLAYER_RIGHT_BIT,a0
	jrnz	uhadp1
;Plyr 2
	movi	lex_stand4_anim,a0
	calla	change_anim1a

	movi	lex_torso4_anim,a0
	calla	change_anim2a

	PUSH	a10
	move	a13,a10
	CREATE	TAUNT_PID,do_taunt
	PULL	a10

	rets

uhadp1
	movi	lex_stand2_anim,a0
	calla	change_anim1a

	movi	lex_torso2_anim,a0
	calla	change_anim2a

	rets


*****************************************************************************
*
* LEX CONTROL CODE
*
* a13 = * Lex process

 SUBR	move_lex


;	movi	100h,a0			;temp fix!
;	move	a0,*a13(ANI_SPEED)

	movi	lex_secret_moves,a11
	calla	check_secret_moves

	move	*a13(PLYRMODE),a0
	sll	5,a0			;x 32
	addi	vddjmode_table,a0
	move	*a0,a0,L
	call	a0
	rets

vddjmode_table
	.long	mode_normal		;0
	.long	mode_running		;1
	.long	mode_inair		;2
	.long	mode_attached		;3
	.long	mode_onground		;4
	.long	mode_bouncing		;5
	.long	mode_onturnbkl		;6
	.long	mode_block		;7
	.long	mode_dizzy		;8
	.long	mode_dead		;9
	.long	mode_oppoverhead	;10
	.long	mode_climbturnbkl	;11
	.long	mode_waitanim		;12
	.long	mode_grapple		;13
	.long	mode_master		;14
	.long	mode_slave		;15
	.long	mode_headhold		;16
	.long	mode_puppet2		;17
	.long	mode_normal		;18
	.long	mode_headheld		;19
	.long	mode_puppet		;20
	.long	mode_inair2		;21
	.long	mode_normal		;22
	.long	mode_normal		;23
	.long	mode_chokehold		;24
	.long	mode_choking		;25

*****************************************************************************

mode_normal

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	gvbino_interrupt

	move	*a13(I_WILL_DIE),a0
	jrz	gvbinope
	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	gvbinope
;Player has died amidst a combo...
;Knock me down.
	movi	lex_fall_back_anim,a0
	calla	change_anim1a

;Zero health bar
	movi	-10,a0
	move	*a13(PLYRNUM),a1
	calla	adjust_health

	SETMODE	DEAD

	clr	a0
	move	a0,*a13(I_WILL_DIE)

	rets

gvbinope
;Perhaps we need to interrupt any sequence when a wrestler has won?

	calla	get_opp_plyrmode
	cmpi	MODE_DEAD,a0
	jrne	gvbiopp_not_dead

	;if closest is a zombie, skip pin section.
	calla	get_opp_process
	move	*a0(STATUS_FLAGS),a14
	btst	B_ZOMBIE,a14
	jrnz	gvbiopp_not_dead
	
	;all opponents are dead.  Check for pins/raisearms

	;if we're attached to someone, don't interrupt it.
	move	*a13(ATTACH_PROC),a1,L
	jrz	gvbino_attch
	move	*a1(ATTACH_PROC),a2,L
	cmp	a2,a13
	jreq	gvbino_pin_yet
gvbino_attch

	;if a teammate has pinned, raise yer arm.
	calla	ck_teammate_pin	
	jrc	gvbiraisearm

	;nobody has pinned.  if we're outside or all our opponents are
	; outside, do a raisearm.
	calla	raisearm_check
	jrc	gvbiraisearm

	;we're inside with a pinnable opponent.  any button pins.
	move	*a13(BUT_VAL_CUR),a0
	jrz	gvbino_pin_yet

	;we have a press -- make sure opponent is on the ground
	calla	can_pin
	jrnc	gvbiopp_notgnd

	;opponent is on the ground.  pin him.
	FACE24	lex,pin_anim
	calla	change_anim1a

	;set the 'I did a pin' flag.
	move	*a13(STATUS_FLAGS),a14
	ori	M_DID_PIN,a14
	move	a14,*a13(STATUS_FLAGS)

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

gvbiraisearm
	FACE24	lex,raise_arm_anim
	calla	change_anim1a
	calla	set_raisearm_bit

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

gvbitoo_far_to_pin
gvbiopp_notgnd
gvbiopp_not_dead
gvbino_pin_yet

	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	gvbiimmobilized

	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0	;maybe have to action tables?
	jrz	gvbinblk			;1 for down transitions
	callr	gvbiblock			;& 1 for current buttons
	jrc	gvbinblk
	clr	a0
	move	a0,*a13(ATTACK_TYPE)
	rets
gvbinblk
	move	*a13(BUT_VAL_CUR),a0
	andi	011111b,a0
	cmpi	PLAYER_PUNCH_VAL|PLAYER_KICK_VAL,a0
	jrz	gvbipunchkick

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	gvbiaction_table,a0
	move	*a0,a0,L
	call	a0

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	gvbino_interrupt


	move	*a13(STICK_VAL_CUR),a0
	move	a0,*a13(MOVE_DIR)
	calla	climb_turnbuckle
	jrnc	gvbino_climb
	move	*a13(WRESTLERNUM),A5
	MOVI	CLIMB_ROPES,A2
	MOVI	1000,A0
	CALLA	ADD_IF_SILENT
	rets

gvbiimmobilized
	clr	a14
	move	a14,*a13(MOVE_DIR)
gvbino_climb
	calla	execute_walk

gvbino_interrupt
	rets

gvbiaction_table
	.long	gvbiz,gvbipunch,gvbiblock,gvbiblock			;0-3
	.long	gvbisuper_punch,gvbisuper_punch,gvbiblock,gvbiblock	;4-7
	.long	gvbikick,gvbipunchkick,gvbiblock,gvbiblock		;8-11
	.long	gvbisuper_punch,gvbipunchkick,gvbiblock,gvbiblock	;12-15
	.long	gvbisuper_kick,gvbisuper_kick,gvbiblock,gvbiblock	;16-19
	.long	gvbigraboh,gvbigraboh,gvbiblock,gvbiblock		;20-23
	.long	gvbisuper_kick,gvbipunchkick,gvbiblock,gvbiblock	;24-27
	.long	gvbigraboh,gvbigraboh,gvbiblock,gvbiblock		;28-31

************
gvbiz
	rets


************
gvbipunch		;1
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  40  45	headbutt
* normal	>		normal punch
*
* onground	< 120 120	elbow drop
* onground	>		normal punch
*
* running |
* bouncing			normal punch
*
* onturnbkl	<  40  45	hdbutt
* onturnbkl	>		normal punch
*
* climbturnbkl			punch
*

	JJXM_INIT
	JJXM	NORMAL,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;0
	JJXM	RUNNING,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;1
	JJXM	INAIR,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;2
	JJXM	ATTACHED,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;3
	JJXM	ONGROUND,	160,140,gvbipunch_lbowdrop,gvbipunch_punch	;4
	JJXM	BOUNCING,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;1
	JJXM	ONTURNBKL,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;6
	JJXM	BLOCK,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;7
	JJXM	DIZZY,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;8
	JJXM	DEAD,		160,140,gvbipunch_lbowdrop,gvbipunch_punch	;9
	JJXM	OPPOVERHEAD,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;10
	JJXM	CLIMBTURNBKL,		gvbipunch_punch			;11
	JJXM	WAITANIM,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;12
	JJXM	GRAPPLE,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;13
	JJXM	MASTER,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;14
	JJXM	SLAVE, 		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;15
	JJXM	HEADHOLD,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;16
	JJXM	HEADHELD,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;19
	JJXM	CHOKEHOLD,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;16
	JJXM	PUPPET,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;20
	JJXM	PUPPET2,	 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;20
	JJXM	INAIR2,		 40, 45,gvbipunch_hdbutt,gvbipunch_punch	;21
	JJXM_END

*****	
gvbipunch_punch
std_punch
	FACE24	lex,punch_anim
	calla	change_anim1a
	WRSND	W_LUGER,PUNCH_T1,PUNCH_T2
	rets

*****
gvbipunch_hdbutt
	FACE24	lex,butt_anim
	calla	change_anim1a
	WRSND	W_LUGER,HDBUTT_T1,HDBUTT_T2
	rets

*****
gvbipunch_lbowdrop
	FACE24	lex,ground_punch_anim
	calla	change_anim1a
	WRSND	W_LUGER,LBOWDROP_T1,LBOWDROP_T2
	rets


************
gvbiblock		;2
std_block
	move	@blocking_off,a0
	jrnz	gvbino_blocking

	RND_AWARD	a13,BLOCKS_AWD

	movi	lex_4_block_anim,a0
	calla	change_anim1

	calla	BLOCK_WOOSH

	clr	a0
	move	a0,*a13(BLOCK_TIME)
	clrc
	rets

gvbino_blocking
	setc
	rets


************
gvbisuper_punch	;4
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	< 110   75	close in super move
* dizzy			"		"
* normal	>		jumping punch move
* dizzy			"		"
*
* onground	< 136  112	super elbow drop
* onground	>		normal punch
*
* running			hip toss
* bouncing			nothing
*
* onturnbkl	<  60   96	yank down
* onturnbkl	>		normal punch
* climbturnbkl			normal punch
*
	JJXM_INIT
	JJXM	NORMAL,		 70, 45,gvbispunch_special,gvbispunch_slap	;0
	JJXM	RUNNING,	 40, 45,gvbispunch_special,gvbispunch_slap	;1
	JJXM	INAIR,		 40, 45,gvbispunch_special,gvbispunch_slap	;2
	JJXM	ATTACHED,	 40, 45,gvbispunch_special,gvbispunch_slap	;3
	JJXM	ONGROUND,	160,140,gvbispunch_lbowdrop,std_punch	;4
	JJXM	BOUNCING,	110, 45,gvbispunch_special,gvbispunch_slap	;5
	JJXM	ONTURNBKL,	 	gvbispunch_slap			;6
	JJXM	BLOCK,		 70, 45,gvbispunch_special,gvbispunch_slap	;7
	JJXM	DIZZY,		 40, 45,gvbispunch_special,gvbispunch_slap	;8
	JJXM	DEAD,		160,140,gvbispunch_lbowdrop,std_punch	;9
	JJXM	OPPOVERHEAD,	110, 35,gvbispunch_special,gvbispunch_slap	;10
	JJXM	CLIMBTURNBKL,		std_punch			;11
	JJXM	WAITANIM,	 40, 45,gvbispunch_special,gvbispunch_slap	;12
	JJXM	GRAPPLE,	 40, 45,gvbispunch_special,gvbispunch_slap	;13
	JJXM	MASTER,		 40, 45,gvbispunch_special,gvbispunch_slap	;14
	JJXM	SLAVE, 		 40, 45,gvbispunch_special,gvbispunch_slap	;15
	JJXM	HEADHOLD,	 40, 45,gvbispunch_special,gvbispunch_slap	;16
	JJXM	HEADHELD,	 40, 45,gvbispunch_special,gvbispunch_slap	;19
	JJXM	CHOKEHOLD,	 40, 45,gvbispunch_special,gvbispunch_slap	;16
	JJXM	PUPPET,		 40, 45,gvbispunch_special,gvbispunch_slap	;20
	JJXM	PUPPET2,	 40, 45,gvbispunch_special,gvbispunch_slap	;20
	JJXM	INAIR2,		 40, 45,gvbispunch_special,gvbispunch_slap	;21
	JJXM_END

gvbispunch_rets
	rets

