gvbikick		;8
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  60   50	knee
*		>		normal kick
*
* onground	< 128  128	stomp
* onground	>		normal kick
*
* running |
* bouncing			big boot
*
* onturnbkl |
* climbturnbkl			normal kick
*


	JJXM_INIT
	JJXM	NORMAL,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	BLOCK,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	DIZZY,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	ONGROUND,	160,140,gvbikick_stomp,gvbikick_kick
	JJXM	RUNNING, 	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	BOUNCING, 	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	ONTURNBKL,	 	gvbikick_kick
	JJXM	CLIMBTURNBKL,	 	gvbikick_kick
	JJXM	INAIR,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	ATTACHED,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	DEAD,		160,140,gvbikick_stomp,gvbikick_kick
	JJXM	OPPOVERHEAD,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	WAITANIM,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	GRAPPLE,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	MASTER,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	SLAVE,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	HEADHOLD,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	HEADHELD,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	CHOKEHOLD,	 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	PUPPET,		 60, 50,gvbikick_knee,gvbikick_kick
	JJXM	PUPPET2,	 60, 50,gvbikick_knee,gvbikick_kick
