*******************************************************************************
kmarcharge_clobber
	move	*a13(BUT_VAL_UP),a0
	btst	PLAYER_PUNCH_BIT,a0
	jrz	kmarno_punch

;	move	*a13(PLYRMODE),a0
;	cmpi	MODE_ONTURNBKL,a0
;	jrz	kmarno_punch

	move	*a13(PLYRNUM),a0
	.ref	get_punch_dtime
	calla	get_punch_dtime
	cmpi	100,a0			;> min?
	jrlt	kmarno_punch

	callr	kmarscrt_clbr
	setc
	rets

kmarno_punch
	clrc
	rets


kmarscrt_clbr

	move	*a13(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	kmarout
	cmpi	MODE_HEADHOLD,a0
	jrz	kmarout

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

;Don't do it when he is on ground
;	calla	get_opp_plyrmode
;	cmpi	MODE_ONGROUND,a0
;	jrz	kmarout
;	cmpi	MODE_DEAD,a0
;	jrz	kmarout
;	move	*a13(PLYRMODE),a0
;	cmpi	MODE_RUNNING,a0
;	jrz	kmarleapclbr
;
;;If stick is toward opponent, then do sliding/leaping buzzer
;	move	*a13(STICK_VAL_CUR),a0
;	move	*a13(NEW_FACING_DIR),a1
;	andi	0ch,a1
;	cmp	a0,a1
;	jrnz	kmarnorm
;
;kmarleapclbr
;;missing noise for a reason !
;	WRSND	W_LUGER,HDBUTT_T1,HDBUTT_T2
;	FACE24	lex,clobber2_anim
;	calla	change_anim1
;	rets
;kmarnorm

	WRSND	W_LUGER,HDBUTT_T1,HDBUTT_T2
	FACE24	lex,clobber_anim
	calla	change_anim1

	rets

*******************************************************************************
kmarhammer
	.word	B_SKICK,			J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 32 		;max
	.long	scrt_hammer

scrt_hammer
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

	move	*a13(PLYRMODE),a0
	cmpi	MODE_ONTURNBKL,a0
	jrz	kmarout
	cmpi	MODE_OPPOVERHEAD,a0
	jreq	kmarout

	.ref	lex_hammer_anim
	movi	lex_hammer_anim,a0
	calla	change_anim1a

;missing noise for a reason !
	WRSND	W_LUGER,HIPTOSS_T1,PUNCH_T2

	rets

******************************************************************************
kmarneck_grab
	.word	B_SPUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 30		;max
	.long	kmarscrt_neck

kmarscrt_neck
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	kmarout
	cmpi	MODE_DEAD,a0
	jrz	kmarout
	cmpi	MODE_HEADHELD,a0
	jrz	kmarout
;Mode held overhead!
	cmpi	MODE_ATTACHED,a0
	jrz	kmarout

	move	*a13(LAST_HEADHOLD),a14,L
	move	@PCNT,a0,L
	sub	a14,a0
	cmpi	2*60,a0
	jrge	kmarok2

;This head grab is too close (in terms of time) to most recent grab
	.ref	lex_3_fake_hold_anim
	movi	lex_3_fake_hold_anim,a0
	calla	change_anim1a
	rets

kmarok2
	move	*a13(CLOSEST_XDIST),a1
	cmpi	90,a1
	jrgt	kmarstd_grab

	movi	lex_3_head_hold2_anim,a0
	calla	change_anim1a
kmarout	rets

kmarstd_grab
	movi	lex_3_head_hold_anim,a0
	calla	change_anim1a
	rets

*******************************************************************************

kmargrab_fling2
	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	kmarscrt_grabfling2

kmarhip_toss2
	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	kmarscrt_grabfling2

kmarscrt_grabfling2
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	kmaryes
	cmpi	MODE_RUNNING,a0
	jrz	kmaryes
	rets

******************************************************************************
kmargrab_fling
;	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	kmarscrt_grabfling

	.word	B_SPUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	kmarscrt_grabfling

kmarscrt_grabfling

;Make this miss, rotate to missed opponent,
;and stay rotated to flung opponent, also make
;this work from both angles!

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	kmaryes
	cmpi	MODE_RUNNING,a0
	jrnz	kmarnope
kmaryes
	movi	lex_hiptoss_anim,a0
	calla	change_anim1a

	WRSND	W_LUGER,HIPTOSS_T1,PUNCH_T2
	rets

kmarnope
;Don't fling when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_HEADHELD,a0
	jrz	kmarout
	cmpi	MODE_ONGROUND,a0
	jrz	kmarout
	cmpi	MODE_DEAD,a0
	jrz	kmarout
;Mode held overhead!
	cmpi	MODE_ATTACHED,a0
	jrz	kmarout

;	move	*a13(LAST_FLING_ATTEMPT),a14,L
;	move	@PCNT,a0,L
;	sub	a14,a0
;	cmpi	3*60,a0
;	jrge	kmarok2a
;
;;This head grab is too close (in terms of time) to most recent grab
;	movi	lex_3_clobber_anim,a0
;;	FACE24	lex,punch_anim
;	calla	change_anim1a
;
;	WRSND	W_LUGER,HIPTOSS_T1,PUNCH_T2
;	rets
;
;kmarok2a
;	move	@PCNT,a14,L			;use 32-bit PCNT!
;	move	a14,*a13(LAST_FLING_ATTEMPT),L

	FACE24	lex,grabfling_anim
	calla	change_anim1a

	WRSND	W_LUGER,GRABFLING_T1,PUNCH_T2
	rets

*******************************************************************************
kmarhip_toss
;	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	kmarscrt_hiptoss

	.word	B_PUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	kmarscrt_hiptoss

kmarscrt_hiptoss
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	kmarout
;	cmpi	MODE_BLOCK,a0
;	jrz	kmarout
	cmpi	MODE_DEAD,a0
	jrz	kmarout
	cmpi	MODE_HEADHELD,a0
	jrz	kmarout
	cmpi	MODE_INAIR,a0
	jrz	kmardoit
	cmpi	MODE_INAIR2,a0
	jrz	kmardoit
;Mode held overhead!
	cmpi	MODE_ATTACHED,a0
	jrz	kmarout

	move	*a13(CLOSEST_DIST),a0
	cmpi	70h,a0
	jrgt	kmarout

kmardoit
 	movi	lex_hiptoss_anim,a0
	calla	change_anim1a

	clr	a0
	move	a0,*a13(ATTACH_PROC),L

	SETMODE	NORMAL

	WRSND	W_LUGER,GRABFLING_T1,PUNCH_T2

	rets

*******************************************************************************
kmarsliding_elbow
	.word	B_PUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 30		;max
	.long	kmarscrt_elbow

kmarscrt_elbow
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	kmarout

	move	*a13(PLYRMODE),a0
	cmpi	MODE_OPPOVERHEAD,a0
	jreq	kmarout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	kmarout
	cmpi	MODE_DEAD,a0
	jrz	kmarout

	;we can do this from a headhold, so...
	calla	FIND_AND_KILL_ENDLESS

 	movi	lex_sliding_elbow_anim,a0
	calla	change_anim1a

	clr	a0
	move	a0,*a13(ATTACH_PROC),L

	SETMODE	NORMAL

	WRSND	W_LUGER,UPRCUT_T1,UPRCUT_T2

	rets

	.if NUM_LEX_FINISHES
******************************************************************************
 SUBRP	lex_finish_move1

rqhtTIMEOUT	.equ	TSEC

rqhtend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		rqhtend_wait			; br = no

rqhtreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,rqhtreset
	movi		rqhtTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_DOWN,0,rqhtreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,rqhtreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,rqhtreset
	WAITSWITCH_DWN	B_PUNCH,J_ALL,rqhtreset

	movi		lex_finish1_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif
	

	.if NUM_LEX_FINISHES > 1
******************************************************************************
 SUBRP	lex_finish_move2

bzckTIMEOUT	.equ	TSEC

bzckend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		bzckend_wait			; br = no

bzckreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,bzckreset
	movi		bzckTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_UP,0,bzckreset
	WAITSWITCH_DWN	J_RIGHT,J_UP,bzckreset
	WAITSWITCH_DWN	J_RIGHT,J_UP,bzckreset
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,bzckreset

	movi		lex_finish2_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif


*****************************************************************************
 SUBRP	lex_hdhold_pile

zrdzTIMEOUT	.equ	60

zrdzlp0
	SLEEPK	1
zrdzlp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	zrdzcont
	cmpi	MODE_HEADHELD,a0
	jrnz	zrdzlp0

zrdzcont
	clr	a11

;	WAITSWITCH_DWN	J_AWAY,0,zrdzlp
	WAITSWITCH_DWN	J_TOWARD,0,zrdzlp

	movi	zrdzTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,zrdzlp
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,zrdzlp
	
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	zrdzslam
	cmpi	MODE_HEADHELD,a0
	jrnz	zrdzlp0
	move	*a8(I_WILL_DIE),A14
	jrnz	zrdzlp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	zrdzlp0				;ignore

	calla	DO_REVERSAL
	calla	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	zrdzis_reversal

zrdzslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	zrdzlp0				;ignore

	movi	42,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

zrdzis_reversal
	movk	15,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS

	movi	lex_vsuplex_anim,a0
	move	a0,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_LUGER,FLYKICK_T1,FLYKICK_T2

	SLEEPK	20

	jruc	zrdzlp

*****************************************************************************
 SUBRP	lex_hdhold_elbow_face

jqpyTIMEOUT	.equ	60

jqpylp0
	SLEEPK	1
jqpylp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	jqpycont
	cmpi	MODE_HEADHELD,a0
	jrnz	jqpylp0

jqpycont
	clr	a11

;	WAITSWITCH_DWN	J_UP,0,jqpylp
	WAITSWITCH_DWN	J_DOWN,0,jqpylp

	movi	jqpyTIMEOUT,a11

	WAITSWITCH_DWN	J_DOWN,0,jqpylp
	WAITSWITCH_DWN	B_SKICK,J_ALL,jqpylp
	
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	jqpyslam
	cmpi	MODE_HEADHELD,a0
	jrnz	jqpylp0
	move	*a8(I_WILL_DIE),A14
	jrnz	jqpylp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	jqpylp0				;ignore

	calla	DO_REVERSAL
	calla	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L

	.ref	lex_grab2elbow_rev_anim

	movi	lex_grab2elbow_rev_anim,a1
	jruc	jqpyis_reversal

jqpyslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	jqpylp0				;ignore

;fix !!! wrong name - jake
	movk	6,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

;This stops Lex from going for foot, then changing his mind!
;	movk	15,a14
;	move	a14,*a8(IMMOBILIZE_TIME)

	movi	lex_grab2elbow_anim,a1
jqpyis_reversal
	movk	15,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	move	a1,*a8(SPECIAL_MOVE_ADDR),L
	CALLA	FIND_AND_KILL_ENDLESS

	WRSND	W_LUGER,FLYKICK_T1,FLYKICK_T2

	SLEEPK	20
	jruc	jqpylp

******************************************************************************
lex_grab_toss_air

jkqhTIMEOUT	.equ	40

jkqhlp0
	SLEEPK	1
jkqhlp
	clr	a11

	WAITSWITCH_DWN	J_AWAY,0,jkqhlp

	movi	jkqhTIMEOUT,a11

	WAITSWITCH_DWN	J_AWAY,0,jkqhlp
	WAITSWITCH_DWN	B_PUNCH,J_ALL,jkqhlp

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	jkqhlp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jreq	jkqhlp0

;Don't do it when he is on ground
	SWAP	a8,a13
	calla	get_opp_plyrmode
	SWAP	a8,a13
;Don't do it when he is on ground
	cmpi	MODE_ONGROUND,a0
	jrz	jkqhlp
	cmpi	MODE_DEAD,a0
	jrz	jkqhlp
	cmpi	MODE_INAIR,a0
	jrz	jkqhdoit2
	cmpi	MODE_INAIR2,a0
	jrz	jkqhdoit2

	move	*a8(CLOSEST_NUM),a0
	X32	a0
	addi	process_ptrs,a0
	move	*a0,a0,L
	move	*a0(ATTACK_TYPE),a0
	cmpi	AT_LEAPING,a0
	jrz	jkqhdoit2

	move	*a8(CLOSEST_DIST),a0
	cmpi	6ch,a0
	jrgt	jkqhlp

;	FACE24	lex,hiptoss_anim
	movi	lex_hiptoss_anim,a0
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_LUGER,GRABFLING_T1,PUNCH_T2

	SLEEPK	20
	jruc	jkqhlp

jkqhdoit2
;	FACE24	lex,hiptoss2_anim
	movi	lex_hiptoss2_anim,a0
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_LUGER,GRABFLING_T1,PUNCH_T2

	SLEEPK	20

	jruc	jkqhlp

*****************************************************************************
lex_hdhold_graboh

bnkpTIMEOUT	.equ	60

bnkplp0
	SLEEPK	1
bnkplp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	bnkpcont0
	cmpi	MODE_HEADHELD,a0
	jrnz	bnkplp0
bnkpcont0
	clr	a11

	WAITSWITCH_DWN	J_DOWN,0,bnkplp

	movi	bnkpTIMEOUT,a11

;	WAITSWITCH_DWN	J_DOWN_TOWARD,0,bnkplp
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,bnkplp
	WAITSWITCH_DWN	B_KICK,J_ALL,bnkplp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	bnkpdograb
	cmpi	MODE_HEADHELD,a0
	jrnz	bnkplp0
	move	*a8(I_WILL_DIE),A14
	jrnz	bnkplp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	bnkplp0				;ignore

	CALLA	DO_REVERSAL
	CALLA	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	bnkpis_reversal

bnkpdograb
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	bnkplp0				;ignore

;	movk	6,a10
;	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

bnkpis_reversal
	movk	15,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS

	movi	lex_4_graboh_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_LUGER,GRABHOLD_T1,GRABHOLD_T2

	SLEEPK	20

	jruc	bnkplp

*******************************************************************************
*
lex_hdhold_combo1

gfzpTIMEOUT	.equ	60

gfzplp0
	SLEEPK	1
gfzplp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrnz	gfzplp0
;	jrz	gfzpcont
;	cmpi	MODE_HEADHELD,a0
;	jrnz	gfzplp0
;gfzpcont
;In combo mode?
	calla	CHECK_COMBO_GO
	jrlt	gfzplp0

	clr	a11

	WAITSWITCH_DWN	J_TOWARD,0,gfzplp

	movi	gfzpTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,gfzplp
	WAITSWITCH_DWN	B_SKICK,J_ALL,gfzplp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	gfzpslam
	cmpi	MODE_HEADHELD,a0
	jrnz	gfzplp0

gfzpslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	gfzplp0				;ignore

;Start combo rules here
;	move	*a8(ATTACH_PROC),a14,L
;	movk	15,a0
;	move	a0,*a14(IMMOBILIZE_TIME)

	;target WHOIHIT
	SMRTTGT	a8,WHOIHIT

	CALLA	FIND_AND_KILL_ENDLESS
	movi	lex_combo_punch_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_LUGER,UPRCUT_T1,UPRCUT_T2

	SLEEPK	20

	jruc	gfzplp

