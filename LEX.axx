*****************************************************************************
* opponent held overhead

mode_oppoverhead ;10

	move	*a13(ATTACH_PROC),a2,L		;proc attached to
	jrz	bdcinot_attached
	move	*a2(ATTACH_PROC),a0,L
	jrnz	bdcistill_attached

bdcinot_attached

	move	*a13(ANIMODE),a0		;* remove this????
	btst	MODE_UNINT_BIT,a0		;*
	jrnz	bdcino_interrupt			;*

	clr	a0
	move	a0,*a13(ATTACH_PROC),L

	CALLA	FIND_AND_KILL_ENDLESS
	SETMODE	NORMAL

	movi	MODE_NORMAL,a0
	move	a0,*a13(ANIMODE)

	rets

bdcistill_attached
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	bdcino_interrupt

	move	*a13(FACING_DIR),a0
	andni	MOVE_UP,a0
	ori	MOVE_DOWN,a0
	move	a0,*a13(FACING_DIR)
	move	a0,*a13(NEW_FACING_DIR)

	move	*a13(STICK_VAL_CUR),a0
	jrz	bdcistand

	move	a0,*a13(MOVE_DIR)
	calla	execute_walk

	.ref	lex_holdoh_anim
	movi	lex_holdoh_anim,a0
	.ref	change_anim2
	calla	change_anim2
 	jruc	bdcick_butns
bdcistand
	clr	a0
	move	a0,*a13(MOVE_DIR)
	move	a0,*a13(OBJ_XVEL),L
	move	a0,*a13(OBJ_ZVEL),L

	.ref	lex_stndholdoh_anim
	movi	lex_stndholdoh_anim,a0
	calla	change_anim1

bdcick_butns

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	bdciaction_table,a0
	move	*a0,a0,L
	call	a0

bdcino_interrupt
	rets

bdciaction_table
	.long	bdciz,bdcipunch,bdciblock,bdciblock			;0-3
	.long	bdcisuper_punch,bdcisuper_punch,bdciblock,bdciblock	;4-7
	.long	bdcikick,bdcipunchkick,bdciblock,bdciblock		;8-11
	.long	bdcisuper_punch,bdcipunchkick,bdciblock,bdciblock	;12-15
	.long	bdcisuper_kick,bdcisuper_kick,bdciblock,bdciblock	;16-19
	.long	bdcigraboh,bdcigraboh,bdciblock,bdciblock		;20-23
	.long	bdcisuper_kick,bdcipunchkick,bdciblock,bdciblock	;24-27
	.long	bdcigraboh,bdcigraboh,bdciblock,bdciblock		;28-31

;three moves from headhold: backbreaker, slamdown, and ohslam.

************
bdciz
	rets

************
bdcipunch		;1
bdcipunchkick
bdciblock		;2
bdcikick		;8

;	move	*a13(STICK_VAL_CUR),a0
;	btst	PLAYER_DOWN_BIT,a0
;	jrz	bdciz

	CALLA	FIND_AND_KILL_ENDLESS
	movi	lex_ohslam_anim,a0
	calla	change_anim1a

	WRSND	W_LUGER,PUNCH_T1,PUNCH_T2

	rets

************
bdcisuper_punch	;4
bdcigraboh

	move	*a13(STICK_VAL_CUR),a0
	btst	PLAYER_UP_BIT,a0
	jrz	bdcipunch

	CALLA	FIND_AND_KILL_ENDLESS
	movi	lex_slamdown_anim,a0
	calla	change_anim1a

	WRSND	W_LUGER,PUNCH_T1,PUNCH_T2

	rets

************
bdcisuper_kick	;16

	move	*a13(STICK_VAL_CUR),a0
	btst	PLAYER_UP_BIT,a0
	jrz	bdcipunch

	CALLA	FIND_AND_KILL_ENDLESS
	movi	lex_backbreaker_anim,a0
	calla	change_anim1a

	WRSND	W_LUGER,HIPTOSS_T1,PUNCH_T2

	rets

