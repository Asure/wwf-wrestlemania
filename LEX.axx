;zcnnVEL	equ	30000h		;38000h	;30000h
;zcnnDVEL	equ	21f0eh		;27978h	;21f0eh
;zcnnVEL	equ	38000h		;38000h	;30000h
;zcnnDVEL	equ	30000h		;27978h	;21f0eh
zcnnVEL	equ	3a000h		;38000h	;30000h
zcnnDVEL	equ	31000h		;27978h	;21f0eh


 SUBR lex_velocity_table

;		X,	Z

	.long	0,	-zcnnVEL	;0 UP

	.long	zcnnDVEL,	-zcnnDVEL	;1 UP-RIGHT

	.long	zcnnVEL,	0	;2 RIGHT

	.long	zcnnDVEL,	zcnnDVEL	;3 DOWN-RIGHT

	.long	0,	zcnnVEL	;4 DOWN

	.long	-zcnnDVEL,	zcnnDVEL	;5 DOWN-LEFT

	.long	-zcnnVEL,	0	;6 LEFT

	.long	-zcnnDVEL,	-zcnnDVEL	;7 UP-LEFT


*****************************************************************************

