mode_slave	;15
	rets

*****************************************************************************

mode_headhold	;16

;Bozo power move
	.ref	bozo_check
	calla	bozo_check
	jrnc	ogrxfail

	WRSND	W_LUGER,FLYKICK_T1,FLYKICK_T2

	movi	lex_vsuplex_anim,a0
	move	@PCNT,a14
	btst	0,a14
	jrz	ogrxtag
	movi	lex_4_graboh_anim,a0
ogrxtag	calla	change_anim1a

	rets

ogrxfail
	move	*a13(WHOIHIT),a0,L
	move	*a0(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrnz	ogrxexit

;	move	*a13(ATTACH_PROC),a10,L
;	jrz	ogrxexit

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	ogrxno_interrupt

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	ogrxaction_table,a0
	move	*a0,a0,L
	call	a0

ogrxno_interrupt
	rets

ogrxexit
	move	*a13(OBJ_ZPOS),a14,L
	subi	[6,0],a14
	move	a14,*a13(OBJ_ZPOS),L

	movk	MOVE_DOWN_RIGHT,a1
	move	*a13(OBJ_CONTROL),a0
	btst	B_FLIPH,a0
	jrz	ogrxright
	movk	MOVE_DOWN_LEFT,a1
ogrxright	move	a1,*a13(FACING_DIR)
	move	a1,*a13(NEW_FACING_DIR)

	SETMODE	NORMAL

	rets

ogrxaction_table
	.long	ogrxz,ogrxpunch,ogrxblock,ogrxblock			;0-3
	.long	ogrxsuper_punch,ogrxsuper_punch,ogrxblock,ogrxblock	;4-7
	.long	ogrxkick,ogrxpunchkick,ogrxblock,ogrxblock		;8-11
	.long	ogrxsuper_punch,ogrxpunchkick,ogrxblock,ogrxblock	;12-15
	.long	ogrxsuper_kick,ogrxsuper_kick,ogrxblock,ogrxblock	;16-19
	.long	ogrxgraboh,ogrxgraboh,ogrxblock,ogrxblock		;20-23
	.long	ogrxsuper_kick,ogrxpunchkick,ogrxblock,ogrxblock	;24-27
	.long	ogrxgraboh,ogrxgraboh,ogrxblock,ogrxblock		;28-31


************
ogrxblock
ogrxgraboh
ogrxz		;0
	rets

************

ogrxpunch		;1
	CALLA	FIND_AND_KILL_ENDLESS
;If stick is toward opponent, then do quick punches
	move	*a13(STICK_VAL_CUR),a0
	move	*a13(NEW_FACING_DIR),a1
	andi	0ch,a1
	cmp	a0,a1
	jrnz	ogrxtag2
;TODO - change this to uppercuts_to_head_anim!
	WRSND	W_LUGER,KICK_T1,KICK_T2

	.ref	lex_4_knee2_anim
	movi	lex_4_knee2_anim,a0
	calla	change_anim1a
	rets

ogrxtag2
;TODO - change this to an uppercut
	WRSND	W_LUGER,KICK_T1,KICK_T2
	movi	lex_4_knee2_anim,a0
	calla	change_anim1a
	rets

************
ogrxsuper_punch	;4
	rets

ogrxpunchkick
ogrxkick
	CALLA	FIND_AND_KILL_ENDLESS
	movi	lex_3_knee_to_head_anim,a0
	calla	change_anim1a
	WRSND	W_LUGER,KICK_T1,KICK_T2
	rets

ogrxsuper_kick	;16
;If stick is toward opponent, then do quick knees
	move	*a13(STICK_VAL_CUR),a0
	move	*a13(NEW_FACING_DIR),a1
	andi	0ch,a1
	cmp	a0,a1
	jrnz	ogrxkick

;Quick knees
	CALLA	FIND_AND_KILL_ENDLESS
	movi	lex_knees_to_head_anim,a0
	calla	change_anim1a
	WRSND	W_LUGER,KICK_T1,KICK_T2
	rets


