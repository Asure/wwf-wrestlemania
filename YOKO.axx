	JJXM	SLAVE, 		 95, 45,swuespunch_special,swuespunch_slap	;15
	JJXM	HEADHOLD,	 95, 45,swuespunch_special,swuespunch_slap	;16
	JJXM	HEADHELD,	 95, 45,swuespunch_special,swuespunch_slap	;19
