	JJXM	CLIMBTURNBKL,		tjvdpunch_clobber
	JJXM	PUPPET,			tjvdpunch_clobber
	JJXM	PUPPET2,		tjvdpunch_clobber
	JJXM	INAIR,			tjvdpunch_clobber
	JJXM	ATTACHED,		tjvdpunch_clobber
	JJXM	DEAD,			tjvdpunch_buttdrop
	JJXM	OPPOVERHEAD,		tjvdpunch_clobber
	JJXM	WAITANIM,		tjvdpunch_clobber
	JJXM	GRAPPLE,		tjvdpunch_clobber
	JJXM	MASTER,			tjvdpunch_clobber
	JJXM	SLAVE,			tjvdpunch_clobber
	JJXM	HEADHOLD,		tjvdpunch_clobber
	JJXM	HEADHELD,		tjvdpunch_clobber
	JJXM	CHOKEHOLD,		tjvdpunch_clobber
