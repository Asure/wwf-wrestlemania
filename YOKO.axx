*******************************************************************************
yok_salt_throw

kjhbTIMEOUT	.equ	60

kjhblp0
	SLEEPK	1
kjhblp
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	kjhbcont
	cmpi	MODE_HEADHELD,a0
	jrnz	kjhblp0
kjhbcont
	clr	a11

	WAITSWITCH_DWN	J_DOWN,0,kjhblp

	movi	kjhbTIMEOUT,a11

;	WAITSWITCH_DWN	J_DOWN_TOWARD,0,kjhblp
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,kjhblp
	WAITSWITCH_DWN	B_PUNCH,J_ALL,kjhblp
	
	CALLA	FIND_AND_KILL_ENDLESS
	movi	yok_4_salt_anim,a0
	move	a0,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_YOKO,LBOWDROP_T1,LBOWDROP_T2

	SLEEP	120

	jruc	kjhblp

*****************************************************************************

 SUBR	yoko_ani_init

	move	*a13(FACING_DIR),a0
	btst	PLAYER_RIGHT_BIT,a0
	jrnz	hmdgp1
;Plyr 2
	movi	yok_stand4_anim,a0
	calla	change_anim1a

	movi	yok_torso4_anim,a0
	calla	change_anim2a

	PUSH	a10
	move	a13,a10

	CREATE	TAUNT_PID,do_taunt
	PULL	a10

	rets

hmdgp1
	movi	yok_stand2_anim,a0
	calla	change_anim1a

	movi	yok_torso2_anim,a0
	calla	change_anim2a

	rets


*****************************************************************************
*
* YOKOZUNA CONTROL CODE
*
* a13 = * yoko process

 SUBR	move_yoko


;	movi	100h,a0			;temp fix!
;	move	a0,*a13(ANI_SPEED)

	movi	yok_secret_moves,a11
	calla	check_secret_moves

	move	*a13(PLYRMODE),a0
	sll	5,a0			;x 32
	addi	hwmomode_table,a0
	move	*a0,a0,L
	call	a0
	rets

hwmomode_table
	.long	mode_normal		;0
	.long	mode_running		;1
	.long	mode_inair		;2
	.long	mode_attached		;3
	.long	mode_onground		;4
	.long	mode_bouncing		;5
	.long	mode_onturnbkl		;6
	.long	mode_block		;7
	.long	mode_dizzy		;8
	.long	mode_dead		;9
	.long	mode_oppoverhead	;10
	.long	mode_climbturnbkl	;11
	.long	mode_waitanim		;12
	.long	mode_grapple		;13
	.long	mode_master		;14
	.long	mode_slave		;15
	.long	mode_headhold		;16
	.long	mode_puppet2		;17
	.long	mode_normal	;18
	.long	mode_headheld		;19
	REFLONG	mode_puppet		;20
	REFLONG	mode_inair2		;21
	.long	mode_normal	;22
	.long	mode_normal	;23
	.long	mode_chokehold		;24
	REFLONG	mode_choking		;25


*****************************************************************************

mode_normal

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	swueno_interrupt

	move	*a13(I_WILL_DIE),a0
	jrz	swuenope
	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	swuenope
;Player has died amidst a combo...
;Knock me down.
	movi	yok_fall_back_anim,a0
	calla	change_anim1a

;Zero health bar
	movi	-10,a0
	move	*a13(PLYRNUM),a1
	calla	adjust_health

	SETMODE	DEAD

	clr	a0
	move	a0,*a13(I_WILL_DIE)

	rets

swuenope
;Perhaps we need to interrupt any sequence when a wrestler has won?

	calla	get_opp_plyrmode
	cmpi	MODE_DEAD,a0
	jrne	swueopp_not_dead

	;if closest is a zombie, skip pin section.
	calla	get_opp_process
	move	*a0(STATUS_FLAGS),a14
	btst	B_ZOMBIE,a14
	jrnz	swueopp_not_dead
	
	;all opponents are dead.  Check for pins/raisearms

	;if we're attached to someone, don't interrupt it.
	move	*a13(ATTACH_PROC),a1,L
	jrz	swueno_attch
	move	*a1(ATTACH_PROC),a2,L
	cmp	a2,a13
	jreq	swueno_pin_yet
swueno_attch

	;if a teammate has pinned, raise yer arm.
	calla	ck_teammate_pin	
	jrc	swueraisearm

	;nobody has pinned.  if we're outside or all our opponents are
	; outside, do a raisearm.
	calla	raisearm_check
	jrc	swueraisearm

	;we're inside with a pinnable opponent.  any button pins.
	move	*a13(BUT_VAL_CUR),a0
	jrz	swueno_pin_yet

	;we have a press -- make sure opponent is on the ground
	calla	can_pin
	jrnc	swueopp_notgnd

	;opponent is on the ground.  pin him.
	FACE24	yok,pin_anim
	calla	change_anim1a

	;set the 'I did a pin' flag.
	move	*a13(STATUS_FLAGS),a14
	ori	M_DID_PIN,a14
	move	a14,*a13(STATUS_FLAGS)

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

swueraisearm
	FACE24	yok,raise_arm_anim
	calla	change_anim1a
	calla	set_raisearm_bit

	;if we're a temp drone for auto-pin purposes, turn back into
	; a normal player here.
	calla	drone_change_back

	rets

swuetoo_far_to_pin
swueopp_notgnd
swueopp_not_dead
swueno_pin_yet

	move	*a13(IMMOBILIZE_TIME),a0
	jrnz	swueimmobilized

	move	*a13(BUT_VAL_CUR),a0
	btst	PLAYER_BLOCK_BIT,a0	;maybe have to action tables?
	jrz	swuenblk			;1 for down transitions
	callr	swueblock			;& 1 for current buttons
	jrc	swuenblk
	clr	a0
	move	a0,*a13(ATTACK_TYPE)
	rets
swuenblk
	move	*a13(BUT_VAL_CUR),a0
	andi	011111b,a0
	cmpi	PLAYER_PUNCH_VAL|PLAYER_KICK_VAL,a0
	jrz	swuepunchkick

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	swueaction_table,a0
	move	*a0,a0,L
	call	a0

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	swueno_interrupt


	move	*a13(STICK_VAL_CUR),a0
	move	a0,*a13(MOVE_DIR)
	calla	climb_turnbuckle
	jrnc	swueno_climb
	move	*a13(WRESTLERNUM),A5
	MOVI	CLIMB_ROPES,A2
	MOVI	1000,A0
	CALLA	ADD_IF_SILENT
	rets

swueimmobilized
	clr	a14
	move	a14,*a13(MOVE_DIR)
swueno_climb
	calla	execute_walk

swueno_interrupt
	rets

swueaction_table
	.long	swuez,swuepunch,swueblock,swueblock			;0-3
	.long	swuesuper_punch,swuesuper_punch,swueblock,swueblock	;4-7
	.long	swuekick,swuepunchkick,swueblock,swueblock		;8-11
	.long	swuesuper_punch,swuepunchkick,swueblock,swueblock	;12-15
	.long	swuesuper_kick,swuesuper_kick,swueblock,swueblock	;16-19
	.long	swuegraboh,swuegraboh,swueblock,swueblock		;20-23
	.long	swuesuper_kick,swuepunchkick,swueblock,swueblock	;24-27
	.long	swuegraboh,swuegraboh,swueblock,swueblock		;28-31

************
swuez

	rets

************
swuegraboh
;Both super buttons at the same time!
	movi	yok_graboh_anim,a0
	calla	change_anim1a
	WRSND	W_YOKO,GRABHOLD_T1,GRABHOLD_T2
	rets

************
swuepunch		;1
*
* MODE		   DX  DZ	ACTION
* ----------------------------------------------------
* normal	<  62  95	headbutt
* normal	>		normal punch
*
* onground	< 120  120	elbow drop
* onground	>		normal punch
*
* running |
* bouncing			normal punch
*
* onturnbkl	<  60  60	punch
* onturnbkl	>		normal punch
*
* puppet|inair			normal punch
*

	JJXM_INIT
	JJXM	NORMAL,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	DIZZY,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	BLOCK,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	ONGROUND,	160,140,swuepunch_lbdrop,swuepunch_punch
	JJXM	RUNNING,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	BOUNCING,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	ONTURNBKL,	 	swuepunch_punch
	JJXM	CLIMBTURNBKL,	 	swuepunch_punch
	JJXM	PUPPET,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	PUPPET2,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	INAIR,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	ATTACHED,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	DEAD,		160,140,swuepunch_lbdrop,swuepunch_punch
	JJXM	OPPOVERHEAD,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	WAITANIM,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	GRAPPLE,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	MASTER,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	SLAVE,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	HEADHOLD,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	HEADHELD,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	CHOKEHOLD,	 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM	INAIR2,		 62, 95,swuepunch_hdbutt,swuepunch_punch
	JJXM_END

