;rvuaVEL	equ	38000h		;38000h	;30000h
;rvuaDVEL	equ	30000h		;27978h	;21f0eh
rvuaVEL	equ	3a000h		;38000h	;30000h
rvuaDVEL	equ	31000h		;27978h	;21f0eh


 SUBR yok_velocity_table

;		X,	Z

	.long	0,	-rvuaVEL	;0 UP

	.long	rvuaDVEL,	-rvuaDVEL	;1 UP-RIGHT

	.long	rvuaVEL,	0	;2 RIGHT

	.long	rvuaDVEL,	rvuaDVEL	;3 DOWN-RIGHT

	.long	0,	rvuaVEL	;4 DOWN

	.long	-rvuaDVEL,	rvuaDVEL	;5 DOWN-LEFT

	.long	-rvuaVEL,	0	;6 LEFT

	.long	-rvuaDVEL,	-rvuaDVEL	;7 UP-LEFT


