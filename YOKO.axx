	andi	011111b,a0
	X32	a0
	addi	qmefaction_table,a0
	move	*a0,a0,L
	call	a0

qmefno_interrupt
	rets

qmefexit
	move	*a13(OBJ_ZPOS),a14,L
	subi	[6,0],a14
	move	a14,*a13(OBJ_ZPOS),L

	movk	MOVE_DOWN_RIGHT,a1
	move	*a13(OBJ_CONTROL),a0
	btst	B_FLIPH,a0
	jrz	qmefright
	movk	MOVE_DOWN_LEFT,a1
qmefright	move	a1,*a13(FACING_DIR)
	move	a1,*a13(NEW_FACING_DIR)

	SETMODE	NORMAL

	rets

