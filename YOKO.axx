yok_hdhold_scissor

ijcrTIMEOUT	.equ	60

ijcrlp0
	SLEEPK	1
ijcrlp
;	move	*a8(GETUP_TIME),a0
;	jrnz	ijcrlp0
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	ijcrcont
	cmpi	MODE_HEADHELD,a0
	jrnz	ijcrlp0
ijcrcont
	clr	a11

;	WAITSWITCH_DWN	J_AWAY,0,ijcrlp
	WAITSWITCH_DWN	J_TOWARD,0,ijcrlp

	movi	ijcrTIMEOUT,a11

	WAITSWITCH_DWN	J_TOWARD,0,ijcrlp
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,ijcrlp
	
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	ijcrslam
	cmpi	MODE_HEADHELD,a0
	jrnz	ijcrlp0
	move	*a8(I_WILL_DIE),A14
	jrnz	ijcrlp0

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ijcrlp0				;ignore

	CALLA	DO_REVERSAL
	CALLA	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	ijcris_reversal

ijcrslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ijcrlp0				;ignore

	movi	34,a10
	CREATE0	BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

ijcris_reversal
	movk	32,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS
	movi	yok_scissor_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L
	WRSND	W_YOKO,GRABFLING_T1,GRABFLING_T2

	SLEEPK	20

	jruc	ijcrlp

