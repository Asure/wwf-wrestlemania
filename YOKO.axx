	move	*a13(ATTACH_PROC),a2,L		;proc attached to
	jrz	icpynot_attached
	move	*a2(ATTACH_PROC),a0,L
	jrnz	icpystill_attached

icpynot_attached

	move	*a13(ANIMODE),a0		;* remove this????
	btst	MODE_UNINT_BIT,a0		;*
	jrnz	icpyno_interrupt			;*

	clr	a0
	move	a0,*a13(ATTACH_PROC),L

	CALLA	FIND_AND_KILL_ENDLESS
	SETMODE	NORMAL

	movi	MODE_NORMAL,a0
	move	a0,*a13(ANIMODE)

	rets

icpystill_attached
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	icpyno_interrupt

	move	*a13(FACING_DIR),a0
	andni	MOVE_UP,a0
	ori	MOVE_DOWN,a0
	move	a0,*a13(FACING_DIR)
	move	a0,*a13(NEW_FACING_DIR)

	move	*a13(STICK_VAL_CUR),a0
	jrz	icpystand

	move	a0,*a13(MOVE_DIR)
	calla	execute_walk

	movi	yok_holdoh_anim,a0
	calla	change_anim2
 	jruc	icpyck_butns
icpystand
	clr	a0
	move	a0,*a13(MOVE_DIR)
	move	a0,*a13(OBJ_XVEL),L
	move	a0,*a13(OBJ_ZVEL),L

	movi	yok_stndholdoh_anim,a0
	calla	change_anim1

icpyck_butns

	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	icpyaction_table,a0
	move	*a0,a0,L
	call	a0

icpyno_interrupt
	rets

icpyaction_table
	.long	icpyz,icpypunch,icpyblock,icpyblock			;0-3
	.long	icpysuper_punch,icpysuper_punch,icpyblock,icpyblock	;4-7
	.long	icpykick,icpypunchkick,icpyblock,icpyblock		;8-11
	.long	icpysuper_punch,icpypunchkick,icpyblock,icpyblock	;12-15
	.long	icpysuper_kick,icpysuper_kick,icpyblock,icpyblock	;16-19
	.long	icpygraboh,icpygraboh,icpyblock,icpyblock		;20-23
	.long	icpysuper_kick,icpypunchkick,icpyblock,icpyblock	;24-27
	.long	icpygraboh,icpygraboh,icpyblock,icpyblock		;28-31

