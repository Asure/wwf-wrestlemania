	jrnc	qmeffail

	WRSND	W_YOKO,GRABFLING_T1,GRABFLING_T2

	movi	yok_vsuplex_anim,a0
	move	@PCNT,a14
	btst	0,a14
	jrz	qmeftag
	movi	yok_scissor_anim,a0
qmeftag	calla	change_anim1a

	rets

qmeffail
	move	*a13(WHOIHIT),a0,L
	move	*a0(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrnz	qmefexit

;	move	*a13(ATTACH_PROC),a10,L
