******************************************************************************
dvkfscissors
	.word	B_SKICK,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 32 		;max
	.long	dvkfscrt_scis

dvkfscrt_scis
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfrets
	move	*a13(PLYRMODE),a0
	CMPI	MODE_HEADHOLD,a0
	jrz	dvkfrets

;no frankensteiner if opponent is on the ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jreq	dvkfrets
	cmpi	MODE_DEAD,a0
	jreq	dvkfrets

	;don't do it if opponent is behind you
	calla	ck_ignore
	jrc	dvkfrets
	
	CALLA	FIND_AND_KILL_ENDLESS
	movi	yok_scissor_anim,a0
	calla	change_anim1a
	WRSND	W_YOKO,GRABFLING_T1,GRABFLING_T2
dvkfrets	rets

*******************************************************************************

dvkfhip_toss
;	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	dvkfscrt_hiptoss

	.word	B_PUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	dvkfscrt_hiptoss

dvkfscrt_hiptoss
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	dvkfout
;	cmpi	MODE_BLOCK,a0
;	jrz	dvkfout
	cmpi	MODE_DEAD,a0
	jrz	dvkfout
	cmpi	MODE_HEADHELD,a0
	jrz	dvkfout
	cmpi	MODE_INAIR,a0
	jrz	dvkfdoit
	cmpi	MODE_INAIR2,a0
	jrz	dvkfdoit

	move	*a13(CLOSEST_DIST),a0
	cmpi	70h,a0
	jrgt	dvkfout

dvkfdoit
	FACE24	yok,hiptoss_anim
	calla	change_anim1a

	WRSND	W_YOKO,HIPTOSS_T1,PUNCH_T2

	rets

*******************************************************************************

dvkfgrab_fling2
	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	dvkfscrt_grabfling2

dvkfhip_toss2
	.word	B_PUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
	.word	8000h | 10		;max
	.long	dvkfscrt_grabfling2

dvkfscrt_grabfling2
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	dvkfyes
	cmpi	MODE_RUNNING,a0
	jrz	dvkfyes
	rets

*******************************************************************************

dvkfgrab_fling
;	.word	B_SPUNCH | J_AWAY,	J_REAL_LR | J_UP | J_DOWN
;	.word	8000h | 10		;max
;	.long	dvkfscrt_grabfling

	.word	B_SPUNCH,		J_ALL
	.word	J_AWAY,		J_REAL_LR
	.word	J_AWAY,		J_REAL_LR
	.word	8000h | 32		;max
	.long	dvkfscrt_grabfling

dvkfscrt_grabfling

;Make this miss, rotate to missed opponent,
;and stay rotated to flung opponent, also make
;this work from both angles!

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout

;If opponent is running, do a hip toss
	calla	get_opp_plyrmode
	cmpi	MODE_BOUNCING,a0
	jrz	dvkfyes
	cmpi	MODE_RUNNING,a0
	jrnz	dvkfnope
dvkfyes
	FACE24	yok,hiptoss_anim
	calla	change_anim1a

	WRSND	W_YOKO,HIPTOSS_T1,PUNCH_T2
	rets

dvkfnope
;Don't fling when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_DEAD,a0
	jrz	dvkfout
	cmpi	MODE_HEADHELD,a0
	jrz	dvkfout
	cmpi	MODE_ONGROUND,a0
	jrz	dvkfout
;Mode held overhead!
	cmpi	MODE_ATTACHED,a0
	jrz	dvkfout

;	move	*a13(LAST_FLING_ATTEMPT),a14,L
;	move	@PCNT,a0,L
;	sub	a14,a0
;	cmpi	3*60,a0
;	jrge	dvkfok2
;
;;This head grab is too close (in terms of time) to most recent grab
;	FACE24	yok,slap2_anim
;	calla	change_anim1a
;
;	WRSND	W_YOKO,SPUNCH_T1,SPUNCH_T2
;	rets
;
;dvkfok2
;	move	@PCNT,a14,L			;use 32-bit PCNT!
;	move	a14,*a13(LAST_FLING_ATTEMPT),L

	FACE24	yok,grabfling_anim
	calla	change_anim1a

	WRSND	W_YOKO,GRABFLING_T1,PUNCH_T2
	rets

*******************************************************************************

dvkfneck_grab
	.word	B_SPUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 30		;max
	.long	dvkfscrt_neck

dvkfscrt_neck
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	dvkfout
	cmpi	MODE_DEAD,a0
	jrz	dvkfout
	cmpi	MODE_HEADHELD,a0
	jrz	dvkfout
;Mode held overhead!
	cmpi	MODE_ATTACHED,a0
	jrz	dvkfout

	move	*a13(LAST_HEADHOLD),a14,L
	move	@PCNT,a0,L
	sub	a14,a0
	cmpi	2*60,a0
	jrge	dvkfok2a

;This head grab is too close (in terms of time) to most recent grab
	.ref	yok_3_fake_hold_anim
	movi	yok_3_fake_hold_anim,a0
	calla	change_anim1a
	rets

dvkfok2a
	move	*a13(CLOSEST_XDIST),a1
	cmpi	80,a1
	jrgt	dvkfstd_grab

	movi	yok_3_head_hold2_anim,a0
	calla	change_anim1a
	rets

dvkfstd_grab
	movi	yok_3_head_hold_anim,a0
	calla	change_anim1a
	rets

*******************************************************************************

dvkfcharge_salt

	move	*a13(BUT_VAL_UP),a0
	btst	PLAYER_PUNCH_BIT,a0
	jrz	dvkfno_punch

	move	*a13(PLYRNUM),a0
	calla	get_punch_dtime
	cmpi	85,a0			;> min?
	jrlt	dvkfno_punch

	CALLA	FIND_AND_KILL_ENDLESS
	callr	dvkfscrt_salt
	setc
	rets

dvkfno_punch
	clrc
	rets

dvkfscrt_salt
	move	*a13(PLYRMODE),a0
	cmpi	MODE_HEADHELD,a0
	jrz	dvkfout
	cmpi	MODE_HEADHOLD,a0
	jrz	dvkfout

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ATTACHED,a0
	jrz	dvkfout
;	cmpi	MODE_ONGROUND,a0
;	jrz	dvkfout
;	cmpi	MODE_DEAD,a0
;	jrz	dvkfout

	FACE24	yok,salt_anim
	calla	change_anim1a
	WRSND	W_YOKO,HDBUTT_T1,HDBUTT_T2

	clr	a0
	move	a0,*a13(RUN_TIME)

	SETMODE	NORMAL

	rets

*******************************************************************************

dvkfgut_push
	.word	B_PUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_TOWARD,		J_REAL_LR
	.word	8000h | 40		;max
	.long	dvkfscrt_gut_push

dvkfscrt_gut_push

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout
 
;Don't do it when he is on ground
	calla	get_opp_plyrmode
	cmpi	MODE_ONGROUND,a0
	jrz	dvkfout
	cmpi	MODE_DEAD,a0
	jrz	dvkfout
	cmpi	MODE_HEADHELD,a0
	jrz	dvkfout
;Mode held overhead!
	cmpi	MODE_ATTACHED,a0
	jrz	dvkfout
 
	FACE24	yok,gut_push_anim
	calla	change_anim1a
	WRSND	W_YOKO,GRABTHROW_T1,GRABTHROW_T2
dvkfout
	rets


*******************************************************************************

dvkfjabs
	.word	B_PUNCH,		J_ALL
	.word	J_TOWARD,		J_REAL_LR
	.word	J_DOWN_TOWARD,		J_REAL_LR
	.word	J_DOWN,			J_REAL_LR
	.word	8000h | 50 		;max
	.long	dvkfscrt_jabs

dvkfscrt_jabs
	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	dvkfout

	move	*a13(PLYRMODE),a0
	cmpi	MODE_ONTURNBKL,a0
	jrz	dvkfout

;Don't do it when he is on ground
	calla	get_opp_plyrmode
;	cmpi	MODE_ONGROUND,a0
;	jrz	dvkfout
;	cmpi	MODE_DEAD,a0
;	jrz	dvkfout
	cmpi	MODE_HEADHELD,a0
	jrz	dvkfout

	FACE24	yok,jabs_anim
	calla	change_anim1a

	WRSND	W_YOKO,HDBUTT_T1,HDBUTT_T2

	rets

	.if NUM_YOKO_FINISHES
******************************************************************************
 SUBRP	yok_finish_move1

dcloTIMEOUT	.equ	TSEC

dcloend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		dcloend_wait			; br = no

dcloreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,dcloreset
	movi		dcloTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_DOWN,0,dcloreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,dcloreset
	WAITSWITCH_DWN	J_TOWARD,J_DOWN|J_UP,dcloreset
	WAITSWITCH_DWN	B_PUNCH,J_ALL,dcloreset

	movi		yok_finish1_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif
	

	.if NUM_YOKO_FINISHES > 1
******************************************************************************
 SUBRP	yok_finish_move2

loqvTIMEOUT	.equ	TSEC

loqvend_wait
	SLEEP		TSEC/4
	move		@p1rounds,a0			; Get player 1 rounds
	move		@p2rounds,a1			; Get player 2 rounds
	or		a1,a0				; Put em together
	cmpi		2,a0				; Anybody got 2?
	jrlt		loqvend_wait			; br = no

loqvreset
	clr		a11
	move		a11,@in_finish_move
	SLEEPK		1
	WAITSWITCH_DWN	J_UP,0,loqvreset
	movi		loqvTIMEOUT,a11
	move		a11,@in_finish_move
	WAITSWITCH_DWN	J_UP,0,loqvreset
	WAITSWITCH_DWN	J_RIGHT,J_UP,loqvreset
	WAITSWITCH_DWN	J_RIGHT,J_UP,loqvreset
	WAITSWITCH_DWN	B_SPUNCH,J_ALL,loqvreset

	movi		yok_finish2_move,a0
	move		a0,*a8(SPECIAL_MOVE_ADDR),L
	DIE
	.endif

*******************************************************************************

yok_grab_toss_air

quxbTIMEOUT	.equ	40

quxblp0
	SLEEPK	1
quxblp
	clr	a11

	WAITSWITCH_DWN	J_AWAY,0,quxblp

	movi	quxbTIMEOUT,a11

	WAITSWITCH_DWN	J_AWAY,0,quxblp
	WAITSWITCH_DWN	B_PUNCH,J_ALL,quxblp

	move	*a8(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	quxblp

	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jreq	quxblp0

;Don't do it when he is on ground
	SWAP	a8,a13
	calla	get_opp_plyrmode
	SWAP	a8,a13
;Don't do it when he is on ground
	cmpi	MODE_ONGROUND,a0
	jrz	quxblp
	cmpi	MODE_DEAD,a0
	jrz	quxblp
	cmpi	MODE_INAIR,a0
	jrz	quxbdoit2
	cmpi	MODE_INAIR2,a0
	jrz	quxbdoit2

	move	*a8(CLOSEST_NUM),a0
	X32	a0
	addi	process_ptrs,a0
	move	*a0,a0,L
	move	*a0(ATTACK_TYPE),a0
	cmpi	AT_LEAPING,a0
	jrz	quxbdoit2

	move	*a8(CLOSEST_DIST),a0
	cmpi	6ch,a0
	jrgt	quxblp

	FACE24	yok,hiptoss_anim
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_YOKO,GRABFLING_T1,PUNCH_T2

	SLEEPK	20
	jruc	quxblp

quxbdoit2	FACE24	yok,hiptoss2_anim
	move	a0,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_YOKO,GRABFLING_T1,PUNCH_T2

	SLEEPK	20

	jruc	quxblp


*******************************************************************************
yok_hdhold_suplex

ylznTIMEOUT	.equ	60

ylznlp0
	SLEEPK	1
ylznlp
;	move	*a8(GETUP_TIME),a0
;	jrnz	ylznlp0
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	ylzncont
	cmpi	MODE_HEADHELD,a0
	jrnz	ylznlp0
ylzncont
	clr	a11

;	WAITSWITCH_DWN	J_UP,0,ylznlp
	WAITSWITCH_DWN	J_DOWN,0,ylznlp

	movi	ylznTIMEOUT,a11

	WAITSWITCH_DWN	J_DOWN,0,ylznlp
	WAITSWITCH_DWN	B_SKICK,J_ALL,ylznlp
	
	move	*a8(PLYRMODE),a0
	cmpi	MODE_HEADHOLD,a0
	jrz	ylznslam
	cmpi	MODE_HEADHELD,a0
	jrnz	ylznlp0
	move	*a8(I_WILL_DIE),A14
	jrnz	ylznlp0

;Do reversal unless I have been immobilized!
;If not, set immobilize time for opponent and reverse

	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ylznlp0				;ignore

	CALLA	DO_REVERSAL
	CALLA	DO_REVERSAL_MESS

	;target WHOHITME -- don't hit anyone else
	SMRTTGT	a8,WHOHITME

	;immobilize WHOHITME
	move	*a8(WHOHITME),a0,L
	jruc	ylznis_reversal

ylznslam
	move	*a8(IMMOBILIZE_TIME),a14
	jrnz	ylznlp0				;ignore

	movi	42,a10
	CREATE	MESSAGE_PID,BONUS_MESS

	;target WHOIHIT -- don't hit anyone else
	SMRTTGT	a8,WHOIHIT

	;immobilize WHOIHIT
	move	*a8(WHOIHIT),a0,L

ylznis_reversal
	movk	30,a14
	move	a14,*a0(IMMOBILIZE_TIME)

	CALLA	FIND_AND_KILL_ENDLESS

	movi	yok_vsuplex_anim,a14
	move	a14,*a8(SPECIAL_MOVE_ADDR),L

	WRSND	W_YOKO,GRABFLING_T1,GRABFLING_T2

	SLEEPK	20

	jruc	ylznlp

