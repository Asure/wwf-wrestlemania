*****************************************************************************
*
* RUNNING (if GETUP_TIME > 0 then player is out of control)
*

tjvdXRUN_VAL	equ	YOK_XRUN
tjvdZDRIFT_VAL	equ	YOK_ZDRIFT

mode_running

	move	*a13(RUN_TIME),a0		;Used for flying kick
	addk	1,a0
	move	a0,*a13(RUN_TIME)

	move	*a13(USR_VAR1),a0
	jrnz	tjvdno_vel

	calla	bounce_off_ropes

	movi	tjvdXRUN_VAL,a0
	move	*a13(MOVE_DIR),a14
	btst	PLAYER_RIGHT_BIT,a14
	jrnz	tjvdpos
	neg	a0
tjvdpos
	move	@hyper_speed_on,a14
	sll	a14,a0
	move	a0,*a13(OBJ_XVEL),L

tjvdno_vel

	move	*a13(GETUP_TIME),a0		;delay b4 gaining control
	jrnz	tjvdout_of_control

	move	*a13(ANIMODE),a0
	btst	MODE_UNINT_BIT,a0
	jrnz	tjvdno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	move	*a13(MOVE_DIR),a1
	or	a0,a1
	andi	MOVE_LEFT|MOVE_RIGHT,a1
	cmpi	MOVE_LEFT|MOVE_RIGHT,a1
	jrne	tjvdcontinue_run

	;braking with stick.  abort run.

	SETMODE	NORMAL

tjvdcontinue_run
tjvdno_interrupt

	move	*a13(STICK_VAL_CUR),a0
	clr	a1

	movi	-tjvdZDRIFT_VAL,a1
	btst	PLAYER_UP_BIT,a0
	jrnz	tjvdsetvel

	movi	tjvdZDRIFT_VAL,a1
	btst	PLAYER_DOWN_BIT,a0
	jrnz	tjvdsetvel

	clr	a1
tjvdsetvel
	move	a1,*a13(OBJ_ZVEL),L

;Delay reading buttons after just getting out of an out of control run
;so a mistaken move isn't fired off
	move	*a13(DELAY_BUTNS),a0
	jrnz	tjvdout_of_control


	move	*a13(BUT_VAL_DOWN),a0
	andi	011111b,a0
	X32	a0
	addi	tjvdaction_table,a0
	move	*a0,a0,L
	call	a0
tjvdout_of_control
	rets

tjvdaction_table
	.long	tjvdz,tjvdpunch,tjvdblock,tjvdblock			;0-3
	.long	tjvdsuper_punch,tjvdsuper_punch,tjvdblock,tjvdblock	;4-7
	.long	tjvdkick,tjvdpunchkick,tjvdblock,tjvdblock		;8-11
	.long	tjvdsuper_punch,tjvdpunchkick,tjvdblock,tjvdblock	;12-15
	.long	tjvdsuper_kick,tjvdsuper_kick,tjvdblock,tjvdblock	;16-19
	.long	tjvdgraboh,tjvdgraboh,tjvdblock,tjvdblock		;20-23
	.long	tjvdsuper_kick,tjvdpunchkick,tjvdblock,tjvdblock	;24-27
	.long	tjvdgraboh,tjvdgraboh,tjvdblock,tjvdblock		;28-31

************
tjvdz
	rets

